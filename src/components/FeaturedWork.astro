---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Glyph from './Glyph.astro';
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.png', { eager: true });
const shot = (name?: string) => { if (!name) return null; const k = Object.keys(shots).find((p) => p.endsWith(`/${name}.png`)); return k ? shots[k].default : null; };
const items = (await getCollection('work', (e) => e.data.tier === 1)).sort((a, b) => a.data.order - b.data.order);
const label: Record<string, string> = { live: 'Live', 'early-access': 'Early access', shipped: 'Shipped', concept: 'Concept' };
// per project: the hover edge, the ground behind the cover, and where the cover anchors (Collga keeps the default edge)
const edge: Record<string, string> = { luca: 'rgba(1,181,236,0.3)' };
const ground: Record<string, string> = { collga: '#F2F8F0', luca: '#DFF4FF' };
// Luca's phone runs off the bottom of its artboard, so its cover sits on the card's bottom edge
const pos: Record<string, string> = { luca: '50% 100%' };
const vars = (id: string, tint?: string) => [tint && `--tint:${tint}`, edge[id] && `--edge:${edge[id]}`, ground[id] && `--ground:${ground[id]}`, pos[id] && `--pos:${pos[id]}`].filter(Boolean).join(';') || undefined;
// a cover under /public (his cover SVGs) is served exactly as supplied, never re-encoded
const cover = (p?: string) => (p?.startsWith('/') ? p : null);
---
<section class="section featured" id="work" aria-labelledby="work-h">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow accent">Selected work</p>
        <h2 id="work-h">Studies that show the method.</h2>
      </div>
    </div>

    <div class="list">
      {items.map((w, i) => (
        <article class={`panel card ${cover(w.data.coverImage) || shot(w.data.coverImage) ? 'tinted' : ''}`} data-reveal style={vars(w.id, w.data.hoverTint)}>
          <div class="body">
            <div class="meta mono">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span>{w.data.org}</span><span class="sep">·</span><span>{w.data.year}</span>
              <span class="pill" data-status={w.data.status}>{label[w.data.status]}</span>
            </div>
            <h3><a href={`/work/${w.id}/`}>{w.data.title}</a></h3>
            <p class="sum">{w.data.summary}</p>
            <ul class="tags">{w.data.tags.map((t) => <li>{t}</li>)}</ul>
            <div class="actions">
              <a class="btn btn-ghost" href={`/work/${w.id}/`}>Read the case study
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          {cover(w.data.coverImage)
            ? <div class="visual cover"><img src={cover(w.data.coverImage)!} alt={`${w.data.org} cover`} width="2400" height="1557" loading="lazy" decoding="async" /></div>
            : shot(w.data.coverImage)
              ? <div class="visual cover"><Image src={shot(w.data.coverImage)!} alt={`${w.data.org} screen`} width={1400} format="webp" quality={80} loading="lazy" /></div>
              : <div class="visual"><Glyph kind={w.id} /></div>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .featured { padding-top: 0; }
  /* the section head sits directly on the scene; a soft local scrim keeps it legible on narrow screens */
  .featured .section-head { position: relative; }
  .featured .section-head::before {
    content: ''; position: absolute; inset: -24px -20px; z-index: -1; pointer-events: none;
    background: radial-gradient(70% 80% at 30% 50%, rgba(9,9,10,0.85), rgba(9,9,10,0) 100%);
  }
  .list { display: grid; gap: 18px; }
  .card { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); background: rgba(16,17,18,0.86); backdrop-filter: blur(8px); transition: border-color 0.3s, transform 0.4s var(--ease); }
  .card:hover { border-color: rgba(235,238,245,0.2); }
  .body { padding: clamp(24px, 3vw, 44px); display: flex; flex-direction: column; gap: 16px; }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); }
  .idx { color: var(--accent); }
  .sep { opacity: 0.5; }
  .meta .pill { margin-left: auto; }
  h3 { font-size: clamp(22px, 2.4vw, 32px); max-width: 22ch; }
  h3 a { transition: color 0.2s; }
  h3 a:hover { color: var(--accent); }
  .sum { color: var(--muted); font-size: 15.5px; line-height: 1.6; max-width: 52ch; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--muted); border: 1px solid var(--line-a); border-radius: 5px; padding: 4px 8px; }
  .actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: auto; padding-top: 8px; }
  /* the tinted card: a real screen on the right at full strength, a deep wash of the project's colour rising under the copy on hover
     (Collga green, Luca navy) */
  .body { position: relative; }
  .body > * { position: relative; z-index: 1; }
  .card.tinted .body::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 0.6s var(--ease);
    background: linear-gradient(160deg, var(--tint, #163012) 0%, color-mix(in srgb, var(--tint, #163012) 45%, transparent) 50%, transparent 100%); }
  .card.tinted:hover .body::before, .card.tinted:focus-within .body::before { opacity: 1; }
  .card.tinted:hover { border-color: var(--edge, rgba(108,180,96,0.28)); }
  .visual.cover { position: relative; padding: 0; background: var(--ground, #F5F6F5); overflow: hidden; }
  /* the cover fills the panel edge to edge (only the artboard's plain margin is trimmed) and never sets the card's height */
  .visual.cover :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); display: block; transition: transform 0.9s var(--ease); }
  .card.tinted:hover .visual.cover :global(img) { transform: scale(1.025); }
  .visual { border-left: 1px solid var(--line-a); background: linear-gradient(160deg, rgba(97,144,255,0.05), transparent 60%); display: grid; place-items: center; padding: clamp(20px, 3vw, 40px); }
  @media (max-width: 860px) { .card { grid-template-columns: 1fr; } .visual { border-left: 0; border-top: 1px solid var(--line-a); } .visual.cover { aspect-ratio: 2400 / 1557; } }
</style>
