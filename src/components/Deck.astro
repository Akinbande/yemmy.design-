---
/* Component cards arranged in groups. The section stays put while the groups cycle with scroll. */
import { Image } from 'astro:assets';
interface Card { src: ImageMetadata; alt: string; span?: number }
interface Props { groups: { title: string; note: string; cards: Card[] }[] }
const { groups } = Astro.props;
---
<div class="deck" id="deck" style={`--n:${groups.length}`}>
  <div class="pin">
    <div class="groups">
      {groups.map((g, gi) => (
        <div class="group" data-g={gi}>
          <div class="gh"><span class="mono n">{String(gi + 1).padStart(2, '0')} / {String(groups.length).padStart(2, '0')}</span><h3>{g.title}</h3><p>{g.note}</p></div>
          <div class="grid">
            {g.cards.map((c) => <figure class="card" style={`--s:${c.span ?? 1}`}><Image src={c.src} alt={c.alt} width={1000} format="webp" quality={80} loading="lazy" /></figure>)}
          </div>
        </div>
      ))}
    </div>
    <div class="dots" aria-hidden="true">{groups.map((_, i) => <i data-d={i}></i>)}</div>
  </div>
</div>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const deck = document.getElementById('deck');
    if (!deck || deck.dataset.init) return; deck.dataset.init = '1';
    const groups = [...deck.querySelectorAll<HTMLElement>('.group')], dots = [...deck.querySelectorAll<HTMLElement>('.dots i')];
    const show = (k: number) => { groups.forEach((g, i) => g.classList.toggle('on', i === k)); dots.forEach((d, i) => d.classList.toggle('on', i === k)); };
    show(0);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || innerWidth < 861) { groups.forEach((g) => g.classList.add('on', 'static')); return; }
    ScrollTrigger.create({ trigger: deck, start: 'top top', end: 'bottom bottom', onUpdate: (self) => show(Math.min(groups.length - 1, Math.floor(self.progress * groups.length))) });
  }
  document.addEventListener('astro:page-load', init);
</script>
<style>
  .deck { height: calc(var(--n) * 100vh); }
  .pin { position: sticky; top: var(--nav-h); height: calc(100vh - var(--nav-h)); display: grid; grid-template-rows: 1fr auto; gap: 12px; padding: 24px 0; }
  .groups { position: relative; min-height: 0; }
  .group { position: absolute; inset: 0; display: grid; grid-template-rows: auto 1fr; gap: 18px; opacity: 0; transform: translateY(24px) scale(0.985); transition: opacity 0.5s var(--ease), transform 0.6s var(--ease); pointer-events: none; }
  .group.on { opacity: 1; transform: none; pointer-events: auto; }
  .gh { display: grid; gap: 6px; text-align: center; justify-items: center; }
  .gh .n { font-size: 11px; letter-spacing: 0.12em; color: var(--accent); }
  .gh h3 { font-size: clamp(20px, 2.2vw, 26px); letter-spacing: -0.02em; }
  .gh p { color: var(--muted); font-size: 14.5px; max-width: 56ch; }
  .grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; align-content: center; min-height: 0; }
  .card { margin: 0; grid-column: span calc(var(--s) * 2); padding: 12px; background: #F5F6F5; border-radius: 14px; border: 1px solid transparent; display: grid; place-items: center; }
  .card :global(img) { width: 100%; height: auto; max-height: 46vh; object-fit: contain; display: block; border-radius: 6px; }
  .dots { display: flex; justify-content: center; gap: 8px; }
  .dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--line); transition: background 0.2s, transform 0.2s; }
  .dots i.on { background: var(--accent); transform: scale(1.4); }
  @media (max-width: 860px) {
    .deck { height: auto; } .pin { position: static; height: auto; display: grid; gap: 40px; }
    .groups { display: grid; gap: 40px; } .group { position: static; opacity: 1; transform: none; pointer-events: auto; }
    .grid { grid-template-columns: 1fr 1fr; } .card { grid-column: span 1; } .dots { display: none; }
  }
</style>
