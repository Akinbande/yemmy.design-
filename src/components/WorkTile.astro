---
/* One project on the Work page. Three shapes: a drawn glyph (no media yet), a looping film, or a full-width
   feature where the project's screen sits under a see-through wash of its own colour. The whole card is one link. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Glyph from './Glyph.astro';

interface Props {
  e: CollectionEntry<'work'>;
  line: string;
  variant?: 'glyph' | 'video' | 'feature';
  video?: { src: string; poster: string; wide?: string };
  image?: ImageMetadata;
}
const { e, line, variant = 'glyph', video, image } = Astro.props;
const d = e.data;
const label: Record<string, string> = { live: 'Live', 'early-access': 'Early access', shipped: 'Shipped', concept: 'Concept' };
const isStudy = d.tier === 1;
const href = isStudy ? `/work/${e.id}/` : `/screens/${e.id}/`;
const kind = isStudy ? 'Case study' : 'Screens';
const tint = d.hoverTint ?? '#16233F';
---
<a class={`tile ${variant}`} href={href} style={`--tint:${tint}`}>
  <div class="media" aria-hidden="true">
    <div class="media-in">
      {variant === 'glyph' && <div class="art"><Glyph kind={e.id} /></div>}
      {variant === 'video' && video && (
        <video poster={video.poster} muted loop playsinline preload="none">
          {video.wide && <source src={video.wide} type="video/mp4" media="(min-width: 861px)" />}
          <source src={video.src} type="video/mp4" />
        </video>
      )}
      {variant === 'feature' && image && <Image src={image} alt="" width={2400} format="webp" quality={80} loading="lazy" />}
    </div>
    {variant !== 'glyph' && <i class="veil"></i>}
  </div>
  <div class="cap">
    <p class="meta mono"><span class="k">{kind}</span><span class="sep">·</span><span>{d.year}</span><span class="pill" data-status={d.status}>{label[d.status]}</span></p>
    <h3>{d.org}</h3>
    <p class="line">{line}</p>
    {variant === 'feature' && (
      <span class="btn btn-ghost cta">{isStudy ? 'Read the case study' : 'See the screens'}
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    )}
  </div>
  <span class="go" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M5 11 11 5M11 5H6.2M11 5v4.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
</a>

<style>
  .tile { position: relative; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--line-a); border-radius: var(--r);
    background: var(--surface); overflow: hidden; isolation: isolate; color: var(--fg); transition: border-color 0.3s; }
  .tile:hover, .tile:focus-visible { border-color: rgba(235,238,245,0.26); }
  .media { position: relative; flex: 1; min-height: 240px; overflow: hidden; }
  /* taller than its frame so the scroll drift never shows an edge */
  .media-in { position: absolute; inset: -7% 0; will-change: transform; }

  /* glyph: the drawn artefact on a quiet blueprint grid */
  .glyph .media { border-bottom: 1px solid var(--line-a);
    background: radial-gradient(90% 80% at 50% 0%, rgba(97,144,255,0.10), transparent 70%), radial-gradient(rgba(235,238,245,0.05) 1px, transparent 1px) 0 0 / 22px 22px; }
  .art { position: absolute; inset: 7% 0; display: grid; place-items: center; padding: clamp(24px, 4vw, 52px); }
  .art :global(.glyph) { width: min(100%, 520px); height: auto; transition: transform 0.9s var(--ease); }
  .tile:hover .art :global(.glyph) { transform: scale(1.035); }

  /* film and feature: the media fills the card, the copy sits on a wash of the project's colour */
  .video .media, .feature .media { position: absolute; inset: 0; min-height: 0; }
  .media-in video, .media-in :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease); }
  .tile:hover .media-in video, .tile:hover .media-in :global(img) { transform: scale(1.035); }
  .veil { position: absolute; inset: 0; pointer-events: none; transition: opacity 0.6s var(--ease); }
  .video .veil { background: linear-gradient(0deg, color-mix(in srgb, var(--tint) 92%, black) 0%, color-mix(in srgb, var(--tint) 72%, transparent) 28%, transparent 60%); }
  .feature .veil {
    background: linear-gradient(90deg, color-mix(in srgb, var(--tint) 96%, black) 0%, color-mix(in srgb, var(--tint) 88%, transparent) 34%, color-mix(in srgb, var(--tint) 34%, transparent) 62%, transparent 84%),
                linear-gradient(0deg, color-mix(in srgb, var(--tint) 55%, transparent), transparent 42%); }
  .feature:hover .veil { opacity: 0.94; }
  .feature .media-in :global(img) { object-position: 72% 50%; }

  .cap { position: relative; z-index: 1; display: grid; gap: 8px; padding: clamp(20px, 2.2vw, 26px) clamp(20px, 2.4vw, 28px) clamp(22px, 2.4vw, 28px); }
  .video .cap { margin-top: auto; }
  .feature .cap { margin: auto 0; max-width: 600px; gap: 12px; padding: clamp(28px, 4.2vw, 60px); }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .meta .k { color: var(--accent); }
  .meta .sep { opacity: 0.5; }
  .meta .pill { margin-left: auto; }
  h3 { font-size: clamp(22px, 2.2vw, 30px); letter-spacing: -0.03em; }
  .line { color: var(--muted); font-size: 15px; line-height: 1.5; max-width: 46ch; }
  .video .meta, .feature .meta { color: rgba(242,244,248,0.72); }
  .video .meta .k, .feature .meta .k { color: #fff; }
  .video .line, .feature .line { color: rgba(242,244,248,0.86); }
  .feature h3 { font-size: clamp(32px, 4.2vw, 56px); letter-spacing: -0.04em; }
  .feature .line { font-size: clamp(15.5px, 1.3vw, 17.5px); line-height: 1.6; max-width: 48ch; }
  .video .pill, .feature .pill { border-color: rgba(242,244,248,0.24); color: rgba(242,244,248,0.86); background: rgba(9,9,10,0.25); }
  .cta { justify-self: start; margin-top: 12px; }
  .feature:hover .cta { background: rgba(235,238,245,0.12); border-color: rgba(235,238,245,0.3); }

  .go { position: absolute; top: clamp(16px, 2vw, 22px); right: clamp(16px, 2vw, 22px); z-index: 2; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--line-a); display: grid; place-items: center; color: var(--fg); background: rgba(9,9,10,0.45); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    transition: transform 0.35s var(--ease), background 0.25s, color 0.25s, border-color 0.25s; }
  .tile:hover .go, .tile:focus-visible .go { background: var(--fg); color: #09090A; border-color: var(--fg); transform: rotate(45deg) scale(1.04); }

  @media (max-width: 860px) {
    .feature .veil { background: linear-gradient(0deg, color-mix(in srgb, var(--tint) 97%, black) 0%, color-mix(in srgb, var(--tint) 88%, transparent) 46%, color-mix(in srgb, var(--tint) 30%, transparent) 74%, transparent 100%); }
    .feature .cap { margin: auto 0 0; }
    .feature .media-in :global(img) { object-position: 60% 30%; }
  }
</style>
