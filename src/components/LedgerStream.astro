---
/* Six jobs of a small shop's books. A column of the six jobs tracks progress on the left; on the right the
   job cards scroll up one at a time like a feed, each with what it was like before and what Luca does.
   Sits on a dark, see-through panel in Luca navy. Figures come from his Luca screens. */
const jobs = [
  { k: 'Sell', chip: 'School bag ×2', amt: '+₦10,000', dir: 'in',
    before: 'Sales written in a notebook were slow to add up and easy to lose.',
    luca: 'Tap Sell, pick the product, set the quantity and add the customer.' },
  { k: 'Profit', chip: 'Vintage bag, per sale', amt: '+₦1,000', dir: 'in',
    before: 'Owners only found out if they had made a profit at the end of the month.',
    luca: 'Each product has a market price and a selling price, so the profit on every sale is worked out for you.' },
  { k: 'Debt', chip: 'Mrs Adebayo owes you', amt: '₦20,000', dir: 'due',
    before: "Who owed what, and since when, lived only in the owner's memory.",
    luca: 'The customer list shows who owes you, who you owe, and the total due to you.' },
  { k: 'Record', chip: 'Fuel refill, paid by POS', amt: '−₦7,000', dir: 'out',
    before: 'Small expenses went unrecorded, and money slipped away.',
    luca: 'Money in and money out sit on one list, each with its time and payment method.' },
  { k: 'Track', chip: 'Invoice #020921, paid', amt: '₦25,000', dir: 'in',
    before: 'Receipts got lost, and reports took days to put together.',
    luca: 'Create invoices in the app, and share reports as PDF or Excel in a few taps.' },
  { k: 'Inventory', chip: 'All products', amt: '85', dir: 'stock',
    before: "Stock was counted by eye, and prices were kept in the owner's head.",
    luca: 'See every product with its photo, price and count, and edit it in one step.' },
];
---
<div class="jf" id="jobfeed">
  <ol class="rail" aria-hidden="true">
    {jobs.map((j, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{j.k}</li>)}
  </ol>
  <div class="win">
    <ol class="track">
      {[...jobs, ...jobs].map((j, i) => (
        <li class={`card ${j.dir}`} aria-hidden={i >= jobs.length ? 'true' : undefined}>
          <div class="top"><span class="k mono">{j.k}</span><span class="chip mono"><span>{j.chip}</span><b>{j.amt}</b></span></div>
          <p class="bf"><span class="mono">Before</span>{j.before}</p>
          <p class="wl"><span class="mono">With Luca</span>{j.luca}</p>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const root = document.getElementById('jobfeed');
    if (!root || root.dataset.init) return; root.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // a plain list of the six cards
    const cards = [...root.querySelectorAll<HTMLElement>('.card')];
    const rail = [...root.querySelectorAll<HTMLElement>('.rail li')];
    const track = root.querySelector<HTMLElement>('.track')!;
    const n = rail.length;
    const setOn = (i: number) => { cards.forEach((c, k) => c.classList.toggle('on', k === i)); rail.forEach((r, k) => r.classList.toggle('on', k === i % n)); };
    const offset = (i: number) => cards[i].offsetTop - cards[0].offsetTop;
    setOn(0);
    // one card at a time scrolls up into focus; the doubled list lets the loop land exactly where it began
    const tl = gsap.timeline({ repeat: -1, paused: true });
    for (let s = 1; s <= n; s++) tl.to(track, { y: () => -offset(s), duration: 0.85, ease: 'power3.inOut', onStart: () => setOn(s) }, '+=2.2');
    tl.set(track, { y: 0 }).call(() => setOn(0));
    let t = 0;
    window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(() => tl.invalidate(), 150); }, { passive: true });
    ScrollTrigger.create({ trigger: root, start: 'top 80%', end: 'bottom 15%', onToggle: (s) => (s.isActive ? tl.play() : tl.pause()) });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* a dark, see-through panel in Luca navy */
  .jf { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2.2fr); gap: clamp(24px, 4vw, 56px); align-items: center;
    padding: clamp(24px, 4vw, 52px); border-radius: var(--r); background: rgba(30, 31, 75, 0.36); border: 1px solid rgba(1, 181, 236, 0.2); }
  .rail { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rail li { display: flex; align-items: baseline; gap: 12px; font-size: clamp(20px, 2.2vw, 30px); font-weight: 600; letter-spacing: -0.02em;
    color: rgba(235, 238, 245, 0.26); transition: color 0.5s var(--ease), transform 0.5s var(--ease); }
  .rail li span { font-size: 11px; font-weight: 400; letter-spacing: 0.1em; color: var(--dim); }
  .rail li:global(.on) { color: #fff; transform: translateX(8px); }
  .rail li:global(.on) span { color: #5ED0F3; }
  .win { position: relative; height: clamp(300px, 29vw, 350px); overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 70%, transparent 100%); mask-image: linear-gradient(180deg, #000 0%, #000 70%, transparent 100%); }
  .track { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; will-change: transform; }
  .card { display: grid; gap: 10px; padding: 22px 24px; border-radius: 16px; background: rgba(10, 11, 24, 0.5); border: 1px solid rgba(255, 255, 255, 0.07); opacity: 0.45;
    transition: opacity 0.5s var(--ease), border-color 0.5s var(--ease), background 0.5s var(--ease); }
  .card:global(.on) { opacity: 1; border-color: rgba(1, 181, 236, 0.34); background: rgba(30, 31, 75, 0.62); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .k { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #5ED0F3; }
  .chip { display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); font-size: 11.5px; color: rgba(235, 238, 245, 0.82); }
  .chip b { font-weight: 600; }
  .in .chip b { color: #3DD68C; } .out .chip b { color: #FF7A7F; } .due .chip b { color: #F5C451; } .stock .chip b { color: #fff; }
  .bf, .wl { font-size: 15.5px; line-height: 1.55; }
  .bf { color: var(--muted); }
  .wl { color: var(--fg); }
  .bf span, .wl span { display: inline-block; min-width: 88px; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
  .wl span { color: #5ED0F3; }
  /* without script, or with reduced motion: a plain list of the six */
  :global(.no-js) .win, :global(.reduced-motion) .win { height: auto; -webkit-mask-image: none; mask-image: none; }
  :global(.no-js) .card, :global(.reduced-motion) .card { opacity: 1; }
  :global(.no-js) .card[aria-hidden], :global(.reduced-motion) .card[aria-hidden] { display: none; }
  @media (max-width: 860px) { .jf { grid-template-columns: minmax(0, 1fr); } .rail { display: none; } .win { height: 380px; } }
</style>
