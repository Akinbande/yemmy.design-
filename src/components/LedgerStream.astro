---
/* Six jobs of a small shop's books, streamed into a clean app ledger one line at a time: Sell, Profit, Debt,
   Record, Track, Inventory. Beside it, each job's problem and what was designed for it lights up in step.
   Figures come from his Luca screens. */
const jobs = [
  { k: 'Sell', label: 'School bag ×2', meta: 'Sold to Mrs Adebayo', amt: '+₦10,000', dir: 'in',
    problem: 'Sales written in a notebook are slow to add up and easy to lose.',
    design: 'A Sell button on the home screen: pick the product, set the quantity, name the customer, done.' },
  { k: 'Profit', label: 'Vintage bag', meta: 'Cost ₦5,000 · Sold ₦6,000', amt: '+₦1,000', dir: 'in',
    problem: 'Owners found out whether they made money only at month end, if at all.',
    design: 'Every product carries its market and sell price, so profit is worked out as they sell.' },
  { k: 'Debt', label: 'Mrs Adebayo owes you', meta: 'Customers · Owing you', amt: '₦20,000', dir: 'due',
    problem: 'Credit lived in memory: who owes, how much, and since when.',
    design: 'A customer list that shows who owes you, who you owe, and the total due to you.' },
  { k: 'Record', label: 'Fuel refill', meta: '5:10 PM · POS', amt: '−₦7,000', dir: 'out',
    problem: 'Small expenses leaked away because nobody wrote them down.',
    design: 'Pay in and pay out on one list, every entry with its time and how it was paid.' },
  { k: 'Track', label: 'Invoice #020921', meta: 'Fully paid · Transfer', amt: '₦25,000', dir: 'in',
    problem: 'Receipts went missing and a report took days to put together.',
    design: 'Invoices made in the app, and reports shared as PDF or Excel in a few taps.' },
  { k: 'Inventory', label: 'All products', meta: 'Vintage bag · School bag', amt: '85', dir: 'stock',
    problem: "Stock was counted by eye and prices were kept in the owner's head.",
    design: 'A product list with photos, prices and a count, edited or removed in one step.' },
];
---
<div class="ls" id="ledger">
  <div class="screen" aria-hidden="true">
    <div class="bar mono"><span>Today</span><span>Luca</span></div>
    <div class="total"><span class="mono lbl">Total sales</span><b>₦150,000.00</b></div>
    <p class="mono feedh"><span>Transactions</span><span>Amount</span></p>
    <ol class="feed">
      {jobs.map((j) => (
        <li class={`row ${j.dir}`}><div class="rin"><div class="rc">
          <span class="tag mono">{j.k}</span>
          <span class="txt"><b>{j.label}</b><em class="mono">{j.meta}</em></span>
          <span class="amt mono">{j.amt}</span>
        </div></div></li>
      ))}
    </ol>
  </div>
  <ol class="jobs">
    {jobs.map((j, i) => (
      <li class="job">
        <span class="kk mono"><i>{String(i + 1).padStart(2, '0')}</i>{j.k}</span>
        <p class="pb"><span class="mono">Problem</span>{j.problem}</p>
        <p class="dn"><span class="mono">Designed</span>{j.design}</p>
      </li>
    ))}
  </ol>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const root = document.getElementById('ledger');
    if (!root || root.dataset.init) return; root.dataset.init = '1';
    const rows = [...root.querySelectorAll<HTMLElement>('.row')];
    const jobs = [...root.querySelectorAll<HTMLElement>('.job')];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      rows.forEach((r) => r.classList.add('shown')); jobs.forEach((j) => j.classList.add('on')); return;
    }
    // one line at a time, newest on top; the matching job lights up beside it
    const tl = gsap.timeline({ repeat: -1, paused: true });
    tl.call(() => { rows.forEach((r) => r.classList.remove('shown', 'live')); jobs.forEach((j) => j.classList.remove('on')); });
    rows.forEach((r, i) => {
      tl.call(() => {
        rows.forEach((x) => x.classList.remove('live'));
        r.classList.add('shown', 'live');
        jobs.forEach((j, k) => j.classList.toggle('on', k === i));
      }, [], `+=${i ? 1.8 : 0.4}`);
    });
    tl.to({}, { duration: 2.4 });
    ScrollTrigger.create({ trigger: root, start: 'top 80%', end: 'bottom 15%', onToggle: (s) => (s.isActive ? tl.play() : tl.pause()) });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .ls { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 4.5vw, 64px); align-items: center; }
  /* a clean app screen: white, a 0.5px outline, Luca navy and blue, no gradients */
  .screen { justify-self: center; width: 100%; max-width: 400px; min-height: 540px; display: flex; flex-direction: column; gap: 14px;
    padding: 20px 16px 18px; background: #FFFFFF; color: #1E1F4B; border: 0.5px solid #0B0B0C; border-radius: 30px; }
  .bar { display: flex; justify-content: space-between; padding: 0 6px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #8A8FA3; }
  .total { display: grid; gap: 6px; justify-items: center; padding: 22px 16px; border-radius: 18px; background: #1E1F4B; color: #fff; }
  .total .lbl { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.7); }
  .total b { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
  .feedh { display: flex; justify-content: space-between; padding: 4px 8px 0; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: #8A8FA3; }
  /* column-reverse: the newest line lands on top and pushes the rest down */
  .feed { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column-reverse; }
  .row { display: grid; grid-template-rows: 0fr; opacity: 0; border-radius: 12px; transition: grid-template-rows 0.5s var(--ease), opacity 0.5s var(--ease), background 0.4s; }
  .row.shown { grid-template-rows: 1fr; opacity: 1; }
  .row.live { background: #E6F7FD; }
  .rin { min-height: 0; overflow: hidden; }
  .rc { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px 8px; border-bottom: 1px solid #EEF0F4; }
  .tag { font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; background: #EEF0F4; color: #1E1F4B; min-width: 64px; text-align: center; }
  .row.live .tag { background: #01B5EC; color: #fff; }
  .txt { display: grid; gap: 2px; min-width: 0; }
  .txt b { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .txt em { font-style: normal; font-size: 10.5px; color: #8A8FA3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .amt { font-size: 13px; font-weight: 600; }
  .in .amt { color: #12A150; } .out .amt { color: #E5484D; } .due .amt { color: #B7791F; } .stock .amt { color: #1E1F4B; }

  .jobs { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .job { position: relative; padding: 16px 18px 16px 22px; border-radius: 14px; border: 1px solid transparent; opacity: 0.4;
    transition: opacity 0.45s var(--ease), background 0.45s var(--ease), border-color 0.45s var(--ease); }
  .job::before { content: ''; position: absolute; left: 0; top: 16px; bottom: 16px; width: 2px; border-radius: 2px; background: #01B5EC; transform: scaleY(0); transition: transform 0.45s var(--ease); }
  .job.on { opacity: 1; background: rgba(1, 181, 236, 0.06); border-color: rgba(1, 181, 236, 0.22); }
  .job.on::before { transform: scaleY(1); }
  .kk { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #5ED0F3; }
  .kk i { font-style: normal; color: var(--dim); }
  .pb, .dn { margin-top: 6px; font-size: 15px; line-height: 1.55; }
  .pb { color: var(--muted); }
  .dn { color: var(--fg); }
  .pb span, .dn span { display: inline-block; min-width: 76px; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
  /* without script, or with reduced motion, everything is simply shown */
  :global(.no-js) .row, :global(.reduced-motion) .row { grid-template-rows: 1fr; opacity: 1; }
  :global(.no-js) .job, :global(.reduced-motion) .job { opacity: 1; }
  @media (max-width: 860px) { .ls { grid-template-columns: minmax(0, 1fr); } .screen { min-height: 500px; } }
</style>
