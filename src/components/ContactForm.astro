---
/* The contact form on /contact/. One page, in short numbered sections:
   1 what brings you here (five reasons), 2 about you, 3 about the role, project, product or introduction (only the
   questions that reason needs), 4 the message. Everything after the first section opens once a reason is chosen, and
   changes with it. No budget or salary questions.
   Layout rules, so nothing looks off: every field is a label above a 46px control, whether the control is a text box,
   a select or a segmented choice; one-answer questions are segmented controls in equal parts; any-answer questions are
   a grid of check boxes in full rows (an odd list ends on a full-width option on phones). Contract length only appears when Contract is chosen.
   Sending: the answers are posted as JSON to /api/contact, which emails them to Oluwayemi and sends the visitor a
   confirmation through Resend. If that fails, the form says so and shows the email address. */
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';   // our own route, which sends through Resend
const EMAIL = 'hello@yemmy.design';
const line = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
const intents = [
  { v: 'hire', t: 'Hiring for a role', d: 'A full-time or contract position', icon: line('M4 8h16v11H4zM9 8V5h6v3M4 13h16') },
  { v: 'project', t: 'A project or contract', d: 'Design work with a clear scope', icon: line('M12 3 3 8l9 5 9-5-9-5zM3 13l9 5 9-5') },
  { v: 'product', t: 'Redesigning a product', d: 'A website, SaaS or app that needs a fresh start', icon: line('M20 12a8 8 0 1 1-2.3-5.6M20 4v5h-5') },
  { v: 'intro', t: 'An introduction', d: 'A referral, a recommendation or an invitation', icon: line('M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3.5 20c0-3.2 2.5-5.2 5.5-5.2s5.5 2 5.5 5.2M16 11.2a2.6 2.6 0 1 0 0-5.2M17.5 14.9c1.9.6 3 2.3 3 5.1') },
  { v: 'other', t: 'Something else', d: 'A question, a talk or a quick hello', icon: line('M4 5h16v11H9l-5 4z') },
];
const start = ['As soon as possible', 'In 1 to 3 months', 'In 3 to 6 months', 'Later'];
const length = ['Under 3 months', '3 to 6 months', '6 to 12 months', '1 year or more'];
---
<form class="cf" id="contact-form" data-endpoint={endpoint} data-email={EMAIL} novalidate>
  <p class="req">Fields marked <i>*</i> are required.</p>
  <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
  <div class="summary" role="alert" tabindex="-1" hidden></div>

  <fieldset class="sec">
    <legend class="h"><span class="n" aria-hidden="true"></span><span>What brings you here?&nbsp;<i>*</i></span></legend>
    <div class="intents">
      {intents.map((it, i) => (
        <label class="intent" style={`--i:${i}`}>
          <input type="radio" name="intent" value={it.v} required aria-describedby="cf-intent-err" />
          <span class="ic" set:html={it.icon} />
          <span class="txt"><b>{it.t}</b><span>{it.d}</span></span>
          <span class="tick" aria-hidden="true"></span>
        </label>
      ))}
    </div>
    <span class="err" id="cf-intent-err" data-missing="Choose what brings you here."></span>
  </fieldset>

  <div class="rest" hidden>
    <fieldset class="sec">
      <legend class="h"><span class="n" aria-hidden="true"></span>About you</legend>
      <div class="grid2">
        <div class="f"><label class="lab" for="cf-name">Full name <i>*</i></label><input id="cf-name" name="name" autocomplete="name" required aria-describedby="cf-name-err" /><span class="err" id="cf-name-err" data-missing="Add your name."></span></div>
        <div class="f"><label class="lab" for="cf-email">Email <i>*</i></label><input id="cf-email" type="email" name="email" autocomplete="email" required aria-describedby="cf-email-err" /><span class="err" id="cf-email-err" data-missing="Add an email I can reply to." data-bad="Check the email address, for example name@company.com."></span></div>
        <div class="f"><label class="lab" for="cf-company">Company <i data-company-req>*</i></label><input id="cf-company" name="company" autocomplete="organization" aria-describedby="cf-company-err" /><span class="err" id="cf-company-err" data-missing="Add your company."></span></div>
        <div class="f"><label class="lab" for="cf-title">Your job title</label><input id="cf-title" name="title" autocomplete="organization-title" placeholder="Talent partner, founder" /></div>
      </div>
    </fieldset>

    <fieldset class="sec more" data-for="hire" disabled>
      <legend class="h"><span class="n" aria-hidden="true"></span>About the role</legend>
      <div class="f"><label class="lab" for="cf-role">Role title <i>*</i></label><input id="cf-role" name="role" required placeholder="Senior Product Designer" aria-describedby="cf-role-err" /><span class="err" id="cf-role-err" data-missing="Add the role title."></span></div>
      <div class="f" role="radiogroup" aria-labelledby="cf-type-l"><span class="lab" id="cf-type-l">Employment type</span>
        <div class="seg">{['Full-time', 'Contract', 'Part-time'].map((o) => <label><input type="radio" name="type" value={o} /><span>{o}</span></label>)}</div></div>
      <div class="f" role="radiogroup" aria-labelledby="cf-len-l" data-contract hidden><span class="lab" id="cf-len-l">Contract length</span>
        <div class="seg">{length.map((o) => <label><input type="radio" name="length" value={o} disabled /><span>{o}</span></label>)}</div></div>
      <div class="grid2">
        <div class="f" role="radiogroup" aria-labelledby="cf-setup-l"><span class="lab" id="cf-setup-l">Work setup</span>
          <div class="seg">{['Remote', 'Hybrid', 'On-site'].map((o) => <label><input type="radio" name="setup" value={o} /><span>{o}</span></label>)}</div></div>
        <div class="f"><label class="lab" for="cf-location">Location</label><input id="cf-location" name="location" placeholder="City, country" /></div>
      </div>
      <div class="f" role="radiogroup" aria-labelledby="cf-start-l"><span class="lab" id="cf-start-l">Ideal start</span>
        <div class="seg">{start.map((o) => <label><input type="radio" name="start" value={o} /><span>{o}</span></label>)}</div></div>
      <div class="f"><label class="lab" for="cf-jobpost">Link to the job post</label><input id="cf-jobpost" name="link" type="text" inputmode="url" autocomplete="url" data-link placeholder="company.com/careers/role" aria-describedby="cf-jobpost-err" /><span class="err" id="cf-jobpost-err" data-bad="Check the link, for example company.com/careers/role."></span></div>
    </fieldset>

    <fieldset class="sec more" data-for="project" disabled>
      <legend class="h"><span class="n" aria-hidden="true"></span>About the project</legend>
      <div class="f" role="group" aria-labelledby="cf-pneeds-l"><span class="lab" id="cf-pneeds-l">What do you need? <span class="opt">Choose any</span></span>
        <div class="picks">{['Service design', 'UX and UI design', 'Website design or revamp', 'Mobile app design', 'Design system', 'Front-end build', 'Research and testing', 'Accessibility review', 'Not sure yet'].map((o) => <label class="pick"><input type="checkbox" name="needs" value={o} /><span>{o}</span></label>)}</div></div>
      <div class="f" role="radiogroup" aria-labelledby="cf-pstart-l"><span class="lab" id="cf-pstart-l">When should it start?</span>
        <div class="seg">{start.map((o) => <label><input type="radio" name="start" value={o} /><span>{o}</span></label>)}</div></div>
      <div class="f" role="radiogroup" aria-labelledby="cf-plen-l"><span class="lab" id="cf-plen-l">How long will it run?</span>
        <div class="seg">{length.map((o) => <label><input type="radio" name="length" value={o} /><span>{o}</span></label>)}</div></div>
      <div class="f"><label class="lab" for="cf-brief">Link to a brief</label><input id="cf-brief" name="link" type="text" inputmode="url" data-link placeholder="docs.google.com/..." aria-describedby="cf-brief-err" /><span class="err" id="cf-brief-err" data-bad="Check the link, for example docs.google.com/your-brief."></span></div>
    </fieldset>

    <fieldset class="sec more" data-for="product" disabled>
      <legend class="h"><span class="n" aria-hidden="true"></span>About the product</legend>
      <div class="grid2">
        <div class="f"><label class="lab" for="cf-product">Product name <i>*</i></label><input id="cf-product" name="product" required aria-describedby="cf-product-err" /><span class="err" id="cf-product-err" data-missing="Add the product's name."></span></div>
        <div class="f"><label class="lab" for="cf-plink">Product link</label><input id="cf-plink" name="link" type="text" inputmode="url" data-link placeholder="yourproduct.com" aria-describedby="cf-plink-err" /><span class="err" id="cf-plink-err" data-bad="Check the link, for example yourproduct.com."></span></div>
      </div>
      <div class="f" role="group" aria-labelledby="cf-rneeds-l"><span class="lab" id="cf-rneeds-l">What needs work? <span class="opt">Choose any</span></span>
        <div class="picks">{['Onboarding', 'Core workflows', 'Dashboard', 'Design system', 'The whole product', 'Not sure yet'].map((o) => <label class="pick"><input type="checkbox" name="needs" value={o} /><span>{o}</span></label>)}</div></div>
      <div class="f" role="radiogroup" aria-labelledby="cf-stage-l"><span class="lab" id="cf-stage-l">Where is it now?</span>
        <div class="seg">{['In design', 'Live', 'Scaling'].map((o) => <label><input type="radio" name="stage" value={o} /><span>{o}</span></label>)}</div></div>
      <div class="f" role="radiogroup" aria-labelledby="cf-rstart-l"><span class="lab" id="cf-rstart-l">When should it start?</span>
        <div class="seg">{start.map((o) => <label><input type="radio" name="start" value={o} /><span>{o}</span></label>)}</div></div>
    </fieldset>

    <fieldset class="sec more" data-for="intro" disabled>
      <legend class="h"><span class="n" aria-hidden="true"></span>About the introduction</legend>
      <div class="grid2">
        <div class="f"><label class="lab" for="cf-about">What is it for? <i>*</i></label><input id="cf-about" name="about" required placeholder="A role, a project, a talk or a panel" aria-describedby="cf-about-err" /><span class="err" id="cf-about-err" data-missing="Tell me what it is for."></span></div>
        <div class="f"><label class="lab" for="cf-how">How do you know my work?</label>
          <select id="cf-how" name="how"><option value="">Choose one</option><option>We worked together</option><option>Through someone I know</option><option>I found this site</option><option>Another way</option></select>
        </div>
      </div>
    </fieldset>

    <div class="sec">
      <label class="h" for="cf-message"><span class="n" aria-hidden="true"></span><span><span data-msg-label>Your message</span>&nbsp;<i data-msg-req>*</i></span></label>
      <p class="help" id="cf-message-help" data-msg-help>Your question or note.</p>
      <textarea id="cf-message" name="message" rows="6" required aria-describedby="cf-message-help cf-message-err"></textarea>
      <span class="err" id="cf-message-err" data-missing="Add a short message."></span>
    </div>

    <div class="send-row">
      <button type="submit" class="btn btn-primary send">Send message
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <p class="fine">Your details are used only to reply to you. Nothing goes on a mailing list.</p>
    </div>
    <p class="send-err" role="alert" hidden>That did not send. Please try again, or write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
  </div>

  <div class="done" tabindex="-1" hidden>
    <span class="ok" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.2 4.2L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <h2 data-done-title>Thank you.</h2>
    <p data-done-text></p>
    <button type="button" class="btn btn-ghost again">Send another message</button>
  </div>
</form>

<script>
  const TITLES: Record<string, string> = { hire: 'Hiring for a role', project: 'A project or contract', product: 'Redesigning a product', intro: 'An introduction', other: 'Something else' };
  // the message changes with the reason: its heading, its helper line, and whether it is needed (a recruiter's details are enough)
  const MSG: Record<string, [string, string, boolean]> = {
    hire: ['Anything else I should know?', 'The team, the product and the interview steps.', false],
    project: ['Tell me about the project', 'What you are building, who it is for, and what a good result looks like.', true],
    product: ['What is not working today?', 'What feels hard for your users, and what you want to change.', true],
    intro: ['Tell me more', 'Who you would like to introduce me to, and why.', true],
    other: ['Your message', 'Your question or note.', true],
  };
  const COMPANY_NEEDED = ['hire', 'project', 'product'];
  const LABELS: [string, string][] = [['name', 'Name'], ['email', 'Email'], ['company', 'Company'], ['title', 'Job title'], ['role', 'Role'], ['type', 'Employment type'],
    ['length', 'Length'], ['setup', 'Work setup'], ['location', 'Location'], ['start', 'Start'], ['product', 'Product'], ['stage', 'Stage'], ['needs', 'Needs'],
    ['about', 'For'], ['how', 'Knows my work'], ['link', 'Link'], ['message', 'Message']];
  // links are accepted as people paste them; a missing https:// is added, and a link needs at least a dot
  const fixLink = (v: string) => (v && !/^https?:\/\//i.test(v) ? `https://${v}` : v);
  const linkOk = (v: string) => !v || /^[^\s]+\.[^\s]{2,}$/.test(v.replace(/^https?:\/\//i, ''));

  function init() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.init) return; form.dataset.init = '1';
    const rest = form.querySelector<HTMLElement>('.rest')!, done = form.querySelector<HTMLElement>('.done')!, summary = form.querySelector<HTMLElement>('.summary')!;
    const opened = Date.now();   // sent with the form: a submission faster than a person can type is treated as a bot
    let intent = '';

    // contract length only appears (and only counts) when the role is a contract
    const contract = form.querySelector<HTMLElement>('[data-contract]')!;
    const syncContract = () => {
      const on = (form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value ?? '') === 'Contract';
      contract.hidden = !on;
      contract.querySelectorAll<HTMLInputElement>('input').forEach((i) => { i.disabled = !on; if (!on) i.checked = false; });
      pills();
    };
    form.querySelectorAll<HTMLInputElement>('input[name="type"]').forEach((r) => r.addEventListener('change', syncContract));

    const choose = (v: string) => {
      intent = v;
      form.querySelectorAll<HTMLFieldSetElement>('.more').forEach((f) => (f.disabled = f.dataset.for !== v));
      syncContract();
      const [label, help, needed] = MSG[v];
      form.querySelector('[data-msg-label]')!.textContent = label;
      form.querySelector('[data-msg-help]')!.textContent = help;
      (form.querySelector('[data-msg-req]') as HTMLElement).hidden = !needed;
      (form.querySelector('#cf-message') as HTMLTextAreaElement).required = needed;
      const company = form.querySelector<HTMLInputElement>('#cf-company')!;
      company.required = COMPANY_NEEDED.includes(v);
      (form.querySelector('[data-company-req]') as HTMLElement).hidden = !company.required;
      clear(form.querySelector<HTMLElement>('#cf-intent-err')!);
      form.querySelectorAll('input[name="intent"][aria-invalid]').forEach((r) => r.removeAttribute('aria-invalid'));
      const first = rest.hidden;
      rest.hidden = false;
      pills();
      if (first) rest.animate?.([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' });
    };
    form.querySelectorAll<HTMLInputElement>('input[name="intent"]').forEach((r) => r.addEventListener('change', () => choose(r.value)));

    // one-answer choices: a lit pill slides to the part that was chosen (placed from each part's own box, so it also
    // works when a control wraps into rows on a phone)
    function pills() {
      form!.querySelectorAll<HTMLElement>('.seg').forEach((seg) => {
        let pill = seg.querySelector<HTMLElement>(':scope > .seg-pill');
        if (!pill) { pill = document.createElement('i'); pill.className = 'seg-pill'; pill.setAttribute('aria-hidden', 'true'); seg.prepend(pill); seg.classList.add('js'); }
        const on = seg.querySelector<HTMLInputElement>('input:checked')?.closest('label') as HTMLElement | null;
        if (!on || !seg.offsetParent) { pill.style.opacity = '0'; return; }
        pill.style.opacity = '1';
        pill.style.width = `${on.offsetWidth}px`;
        pill.style.height = `${on.offsetHeight}px`;
        pill.style.transform = `translate(${on.offsetLeft}px, ${on.offsetTop}px)`;
      });
    }
    pills();
    form.addEventListener('change', (e) => { if ((e.target as HTMLElement).closest('.seg')) pills(); });
    window.addEventListener('resize', pills, { passive: true });

    // errors: each field says what is wrong in its own words; a summary at the top counts them
    const errOf = (el: HTMLElement) => document.getElementById(`${el.id}-err`) ?? ((el as HTMLInputElement).name === 'intent' ? form.querySelector<HTMLElement>('#cf-intent-err') : null);
    function clear(err: HTMLElement | null, el?: HTMLElement) { if (err) { err.textContent = ''; err.hidden = true; } el?.removeAttribute('aria-invalid'); }
    const check = (el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): boolean => {
      const err = errOf(el);
      let msg = '';
      if (el.validity.valueMissing) msg = err?.dataset.missing ?? 'This is required.';
      else if (el.validity.typeMismatch) msg = err?.dataset.bad ?? 'Check this field.';
      else if ((el as HTMLInputElement).dataset.link !== undefined && !linkOk(el.value.trim())) msg = err?.dataset.bad ?? 'Check the link.';
      if (!msg) { clear(err, el); return true; }
      if (err) { err.textContent = msg; err.hidden = false; }
      el.setAttribute('aria-invalid', 'true');
      return false;
    };
    form.querySelectorAll<HTMLElement>('.err').forEach((e) => (e.hidden = true));
    form.addEventListener('input', (e) => { const el = e.target as HTMLInputElement; if (el.getAttribute('aria-invalid')) check(el); });
    form.addEventListener('focusout', (e) => { const el = e.target as HTMLInputElement; if (el.matches('input:not([type=radio]):not([type=checkbox]), textarea') && el.value) check(el); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if ((form.elements.namedItem('_gotcha') as HTMLInputElement)?.value) return;   // a bot filled the hidden field
      const fields = [...form.querySelectorAll<HTMLInputElement>('input, textarea, select')].filter((el) => !el.disabled && el.name && el.name !== '_gotcha' && !el.closest('[hidden]') && el.type !== 'checkbox' && !(el.type === 'radio' && el.name !== 'intent'));
      const seen = new Set<string>();
      const bad = fields.filter((el) => { if (el.type === 'radio') { if (seen.has(el.name)) return false; seen.add(el.name); } return !check(el); });
      if (bad.length) {
        summary.textContent = bad.length === 1 ? 'One answer needs a look before this can be sent.' : `${bad.length} answers need a look before this can be sent.`;
        summary.hidden = false;
        bad[0].focus();
        return;
      }
      summary.hidden = true;
      form.querySelectorAll<HTMLInputElement>('[data-link]').forEach((el) => { if (!el.disabled) el.value = fixLink(el.value.trim()); });
      const fd = new FormData(form);
      const rows: [string, string][] = [['About', TITLES[intent]]];
      LABELS.forEach(([k, lab]) => { const v = fd.getAll(k).map((x) => String(x).trim()).filter(Boolean); if (v.length) rows.push([lab, v.join(', ')]); });
      const name = String(fd.get('name') || '').trim(), email = String(fd.get('email') || '').trim(), company = String(fd.get('company') || '').trim();
      const subject = `${TITLES[intent]}: ${name}${company ? ` at ${company}` : ''}`;
      const send = form.querySelector<HTMLButtonElement>('.send')!, err = form.querySelector<HTMLElement>('.send-err')!;
      const finish = (viaMail: boolean) => {
        form.querySelector('[data-done-title]')!.textContent = `Thank you, ${name.split(' ')[0]}.`;
        form.querySelector('[data-done-text]')!.textContent = viaMail
          ? `Your email app should now be open with your message ready. Press send there to finish. If nothing opened, write to ${form.dataset.email}.`
          : `Your message is on its way, and a confirmation is heading to ${email}. I'll reply there.`;
        form.querySelectorAll<HTMLElement>(':scope > :not(.done)').forEach((el) => (el.hidden = true));
        done.hidden = false; done.focus();      };
      err.hidden = true;
      if (form.dataset.endpoint) {
        send.disabled = true;
        try {
          const r = await fetch(form.dataset.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ intent: TITLES[intent], name, email, company, subject, rows, _gotcha: '', _t: Date.now() - opened }) });
          if (!r.ok) throw new Error(String(r.status));
          finish(false);
        } catch { err.hidden = false; }
        send.disabled = false;
      } else {
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(rows.map(([k, v]) => `${k}: ${v}`).join('\n'))}`;
        finish(true);
      }
    });

    form.querySelector('.again')!.addEventListener('click', () => {
      form.reset(); intent = '';
      form.querySelectorAll<HTMLElement>(':scope > .req, :scope > fieldset').forEach((el) => (el.hidden = false));
      rest.hidden = true; done.hidden = true; summary.hidden = true;
      syncContract();
      pills();
      form.querySelectorAll<HTMLElement>('.err').forEach((e) => clear(e));
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelector<HTMLInputElement>('input[name="intent"]')?.focus();    });
  }
  function initCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
      if (b.dataset.init) return; b.dataset.init = '1';
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1600); } catch { /* the address is on screen to copy by hand */ }
      });
    });
  }
  document.addEventListener('astro:page-load', () => { init(); initCopy(); });
</script>

<style>
  .cf { display: grid; gap: 30px; counter-reset: sec; }
  .req { font-size: 13px; color: var(--dim); }
  .req i, .h i, .lab i { font-style: normal; color: var(--accent); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .summary { padding: 12px 16px; border-radius: 12px; border: 1px solid rgba(255, 138, 122, 0.45); background: rgba(255, 138, 122, 0.08); color: #FFB3A8; font-size: 14px; outline: none; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  /* a floated legend becomes an ordinary grid item, so section headings keep the same spacing as everything else */
  .sec > legend { float: left; width: 100%; padding: 0; }

  /* numbered sections: 01, 02, 03... counted only when shown */
  .sec { display: grid; gap: 20px; counter-increment: sec; }
  .rest { display: grid; gap: 36px; padding-top: 30px; border-top: 1px solid var(--line-a); }
  .rest[hidden] { display: none; }
  .more[disabled] { display: none; }
  .h { display: flex; align-items: baseline; gap: 12px; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; color: var(--fg); }
  .n::before { content: counter(sec, decimal-leading-zero); font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: 0.1em; color: var(--accent); }
  .help { margin-top: -10px; font-size: 13.5px; color: var(--muted); }

