---
import { getCollection } from 'astro:content';
import Glyph from './Glyph.astro';
const items = (await getCollection('work', (e) => e.data.tier >= 2)).sort((a, b) => a.data.order - b.data.order);
---
<section class="section more" id="more" aria-labelledby="more-h">
  <div class="wrap grid">
    <div class="side">
      <div class="sticky">
        <p class="eyebrow accent">More work</p>
        <h2 id="more-h">Earlier and smaller work.</h2>
        <p class="sub">Screens from each project, with a short note on what it was for.</p>
        <ol class="index mono" id="more-index" aria-hidden="true">
          {items.map((w, i) => <li data-i={i}><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="o">{w.data.org}</span><span class="y">{w.data.year}</span></li>)}
        </ol>
      </div>
    </div>

    <div class="cards" id="more-cards">
      {items.map((w, i) => (
        <a class="card" href={`/screens/${w.id}/`} data-i={i}>
          <span class="thumb">{w.data.thumb ? <img src={w.data.thumb} alt="" loading="lazy" decoding="async" /> : <Glyph kind={w.id} />}</span>
          <span class="cap">
            <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
            <span class="org">{w.data.org}</span>
            <span class="mono meta">{w.data.year} &middot; {w.data.tags[0]}</span>
            <span class="mono open">See screens <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </span>
          <span class="sr-only">{w.data.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function fly() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const index = document.getElementById('more-index');
    document.querySelectorAll<HTMLElement>('#more-cards .card').forEach((card, i) => {
      const dir = i % 2 ? -1 : 1;   // alternate the toss so the stack does not march in a line
      // tossed in from below with a little spin, catching up behind the scroll (scrub: 1)
      gsap.fromTo(card, { y: 140, x: 36 * dir, rotate: 4 * dir, opacity: 0, transformOrigin: '50% 100%' }, {
        y: 0, x: 0, rotate: 0, opacity: 1, ease: 'power2.out',
        scrollTrigger: { trigger: card, start: 'top 98%', end: 'top 52%', scrub: 1 },
      });
      // and thrown on upward as it leaves
      gsap.to(card, {
        y: -120, x: -28 * dir, rotate: -3 * dir, opacity: 0, scale: 0.94, ease: 'power2.in', immediateRender: false,
        scrollTrigger: { trigger: card, start: 'bottom 40%', end: 'bottom 2%', scrub: 1 },
      });
      ScrollTrigger.create({
        trigger: card, start: 'top 60%', end: 'bottom 45%',
        onToggle: (self) => index?.querySelector(`[data-i="${card.dataset.i}"]`)?.classList.toggle('on', self.isActive),
      });
    });
  }
  document.addEventListener('astro:page-load', () => { if (document.getElementById('more-cards')) fly(); });
</script>

<style>
  /* stretch, not start: the left cell must span the whole row for its sticky child to have room to stick */
  .grid { display: grid; grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); gap: clamp(32px, 5vw, 88px); align-items: stretch; }
  .side { align-self: stretch; }
  .sticky { position: sticky; top: calc(var(--nav-h) + 48px); display: grid; gap: 14px; }
  h2 { font-size: clamp(28px, 3.4vw, 42px); max-width: 14ch; }
  .sub { color: var(--muted); font-size: 15.5px; max-width: 36ch; }
  .index { list-style: none; margin: 22px 0 0; padding: 0; border-top: 1px solid var(--line-a); }
  .index li { display: grid; grid-template-columns: 34px 1fr auto; gap: 12px; padding: 11px 2px; border-bottom: 1px solid var(--line-a); font-size: 12px; color: var(--dim); letter-spacing: 0.04em; transition: color 0.3s; }
  .index li.on { color: var(--fg); }
  .index li.on .n { color: var(--accent); }
  .index .y { color: var(--dim); }

  .cards { display: grid; gap: clamp(24px, 3vw, 40px); }
  .card { display: block; border: 1px solid var(--line-a); border-radius: var(--r); background: var(--surface); overflow: hidden; transition: border-color 0.25s; will-change: transform, opacity; }
  .card:hover, .card:focus-visible { border-color: rgba(235,238,245,0.26); }
  .thumb { display: grid; place-items: center; aspect-ratio: 16 / 10; padding: 7%; background: linear-gradient(160deg, rgba(97,144,255,0.07), transparent 60%); border-bottom: 1px solid var(--line-a); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb :global(.glyph) { width: 100%; height: auto; }
  .cap { display: grid; grid-template-columns: auto 1fr auto auto; align-items: baseline; gap: 14px; padding: 16px 20px; }
  .cap .n { font-size: 11px; color: var(--accent); letter-spacing: 0.1em; }
  .org { font-weight: 600; font-size: 16px; letter-spacing: -0.01em; }
  .meta { font-size: 10.5px; color: var(--dim); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .open { display: inline-flex; align-items: center; gap: 6px; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); transition: color 0.2s; }
  .card:hover .open { color: var(--fg); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .sticky { position: static; } .index { display: none; } .cap { grid-template-columns: auto 1fr; } .meta, .open { display: none; } }
  @media (prefers-reduced-motion: reduce) { .card { opacity: 1 !important; transform: none !important; } }
</style>
