---
/* The method drawn as a service blueprint. Nodes arrive scattered, settle, hold, dissolve, and arrive again. */
const stages = ['Problem', 'Decisions', 'Outcome', 'Artefacts'];
const lanes = ['People', 'Frontstage', 'Backstage', 'Systems'];
const cells = [
  ['What people need', 'The journey we commit to', 'What changed for them', 'Journey maps'],
  ['Where it fails them', 'Interface decisions', 'What shipped', 'Prototypes'],
  ['Why it fails', 'Service model', 'What staff can run', 'Service blueprints'],
  ['What systems allow', 'Architecture and tokens', 'What is measured', 'Design system'],
];
const W = 1200, H = 520, L = 140, R = 190, T = 64, CW = (W - L - R) / 4, RH = (H - T - 24) / 4;
---
<section class="section approach" id="approach" aria-labelledby="approach-h">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow accent">How I work</p>
        <h2 id="approach-h">How I break a difficult problem down.</h2>
        <p>Separate what people experience from what staff do and what the systems allow, then decide in that order. The blueprint is the tool. The decisions are the work.</p>
      </div>
    </div>

    <div class="panel bp" id="bp">
      <svg class="bp-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="bp-title bp-desc">
        <title id="bp-title">Service blueprint of the case study method</title>
        <desc id="bp-desc">Four stages across (problem, decisions, outcome, artefacts) and four lanes down (people, frontstage, backstage, systems), with the line of visibility between frontstage and backstage.</desc>
        <g class="bp-frame">
          {stages.map((s, i) => <text x={L + i * CW + 16} y="38" class="stage">{s.toUpperCase()}</text>)}
          {stages.map((_, i) => <line x1={L + i * CW} y1={T - 14} x2={L + i * CW} y2={H - 24} class="col" />)}
          <line x1={L + 4 * CW} y1={T - 14} x2={L + 4 * CW} y2={H - 24} class="col" />
          {lanes.map((l, r) => <text x="16" y={T + r * RH + RH / 2 + 4} class="lane">{l.toUpperCase()}</text>)}
          <line x1={L} y1={T + 2 * RH} x2={L + 4 * CW} y2={T + 2 * RH} class="vis" />
          <text x={L + 4 * CW + 14} y={T + 2 * RH - 4} class="vislbl">LINE OF</text>
          <text x={L + 4 * CW + 14} y={T + 2 * RH + 10} class="vislbl">VISIBILITY</text>
          <line x1={L} y1={T + 3 * RH} x2={L + 4 * CW} y2={T + 3 * RH} class="vis soft" />
          <text x={L + 4 * CW + 14} y={T + 3 * RH - 4} class="vislbl">LINE OF INTERNAL</text>
          <text x={L + 4 * CW + 14} y={T + 3 * RH + 10} class="vislbl">INTERACTION</text>
        </g>
        <g class="bp-nodes">
          {lanes.map((_, r) => cells[r].map((c, i) => (
            <g class={`node ${i === 1 ? 'key' : ''}`}>
              <rect x={L + i * CW + 16} y={T + r * RH + 14} width={CW - 32} height={RH - 28} rx="8" />
              <text x={L + i * CW + CW / 2} y={T + r * RH + RH / 2 + 5} text-anchor="middle" class="lbl">{c}</text>
            </g>
          )))}
        </g>
      </svg>

      <div class="bp-mobile">
        {stages.map((s, i) => (
          <div class={`mstage ${i === 1 ? 'key' : ''}`}>
            <span class="eyebrow">{s}</span>
            <ul>
              {lanes.map((l, r) => <li class="mnode"><span class="mono ml">{l}</span><span class="mt">{cells[r][i]}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // arrive in pieces, settle, hold, dissolve; repeatRefresh re-rolls the scatter every cycle
  function shuffle(nodes: Element[], sx: number, sy: number, rot: number, trigger: Element) {
    return gsap.timeline({
      repeat: -1, repeatRefresh: true, defaults: { ease: 'power3.out' },
      scrollTrigger: { trigger, start: 'top 85%', end: 'bottom 15%', toggleActions: 'play pause resume pause' },
    })
      .set(nodes, { x: () => (Math.random() - 0.5) * sx, y: () => (Math.random() - 0.5) * sy, rotation: () => (Math.random() - 0.5) * rot, opacity: 0, transformOrigin: '50% 50%' })
      .to(nodes, { opacity: 1, duration: 0.5, stagger: { each: 0.03, from: 'random' } })
      .to(nodes, { x: 0, y: 0, rotation: 0, duration: 1.5, stagger: { each: 0.045, from: 'random' } }, '<0.1')
      .to({}, { duration: 3 })
      .to(nodes, { opacity: 0, y: '+=12', duration: 0.45, ease: 'power2.in', stagger: { each: 0.02, from: 'random' } });
  }

  let current: gsap.core.Timeline | null = null;
  const mq = matchMedia('(min-width: 761px)');

  function start(bp: HTMLElement) {
    current?.scrollTrigger?.kill(); current?.kill(); current = null;
    const nodes = mq.matches ? [...bp.querySelectorAll('.node')] : [...bp.querySelectorAll('.mnode')];
    gsap.set([...bp.querySelectorAll('.node, .mnode')], { clearProps: 'all' });
    current = mq.matches ? shuffle(nodes, 320, 220, 18, bp) : shuffle(nodes, 120, 60, 8, bp);
  }

  function init() {
    const bp = document.getElementById('bp');
    if (!bp || bp.dataset.init) return;
    bp.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    start(bp);
    mq.addEventListener('change', () => start(bp));   // crossing the breakpoint swaps the variant
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { current?.scrollTrigger?.kill(); current?.kill(); current = null; });
</script>

<style>
  .bp { padding: clamp(12px, 2vw, 24px); }
  .bp-svg { width: 100%; height: auto; display: block; }
  .stage { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; fill: var(--fg); }
  .lane { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; fill: var(--dim); }
  .col { stroke: var(--line-a); stroke-width: 1; }
  .node rect { fill: var(--raised); stroke: var(--line); stroke-width: 1; }
  .node.key rect { stroke: var(--accent-line); fill: rgba(97,144,255,0.07); }
  .lbl { font-family: var(--sans); font-size: 14px; fill: var(--muted); }
  .node.key .lbl { fill: var(--fg); }
  .vis { stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 6 5; opacity: 0.9; }
  .vis.soft { stroke: var(--dim); opacity: 0.8; }
  .vislbl { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.12em; fill: var(--dim); }

  .bp-mobile { display: none; }
  @media (max-width: 760px) {
    .bp-svg { display: none; }
    .bp-mobile { display: grid; gap: 14px; }
    .mstage { display: grid; gap: 10px; padding: 14px; border: 1px solid var(--line-a); border-radius: 12px; }
    .mstage.key { border-color: var(--accent-line); background: rgba(97,144,255,0.05); }
    .mstage ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .mnode { display: grid; grid-template-columns: 82px 1fr; gap: 10px; align-items: baseline; padding: 10px 12px; border-radius: 8px; background: var(--raised); border: 1px solid var(--line); }
    .ml { font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
    .mt { font-size: 14px; color: var(--muted); }
    .mstage.key .mt { color: var(--fg); }
  }
</style>
