---
/* The method, drawn as a service blueprint. On entry the nodes arrive scattered and settle into place. */
const stages = ['Problem', 'Decisions', 'Outcome', 'Artefacts'];
const lanes = ['People', 'Frontstage', 'Backstage', 'Systems'];
const cells = [
  ['What people need', 'The journey we commit to', 'What changed for them', 'Journey maps'],
  ['Where it fails them', 'Interface decisions', 'What shipped', 'Prototypes'],
  ['Why it fails', 'Service model', 'What staff can run', 'Service blueprints'],
  ['What systems allow', 'Architecture and tokens', 'What is measured', 'Design system'],
];
const W = 1200, H = 520, L = 140, T = 64, CW = (W - L - 24) / 4, RH = (H - T - 24) / 4;
---
<section class="section approach" id="approach" aria-labelledby="approach-h">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow accent">How I work</p>
        <h2 id="approach-h">How I break a difficult problem down.</h2>
        <p>Separate what people experience from what staff do and what the systems allow, then decide in that order. The blueprint is the tool. The decisions are the work.</p>
      </div>
    </div>

    <div class="panel bp" id="bp">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="bp-title bp-desc">
        <title id="bp-title">Service blueprint of the case study method</title>
        <desc id="bp-desc">Four stages across (problem, decisions, outcome, artefacts) and four lanes down (people, frontstage, backstage, systems), with the line of visibility between frontstage and backstage.</desc>
        <g class="bp-frame">
          {stages.map((s, i) => <text x={L + i * CW + 16} y="38" class="stage">{s.toUpperCase()}</text>)}
          {stages.map((_, i) => <line x1={L + i * CW} y1={T - 14} x2={L + i * CW} y2={H - 24} class="col" />)}
          {lanes.map((l, r) => <text x="16" y={T + r * RH + RH / 2 + 4} class="lane">{l.toUpperCase()}</text>)}
          <line x1={L} y1={T + 2 * RH} x2={W - 24} y2={T + 2 * RH} class="vis" />
          <text x={W - 28} y={T + 2 * RH - 8} class="vislbl" text-anchor="end">LINE OF VISIBILITY</text>
          <line x1={L} y1={T + 3 * RH} x2={W - 24} y2={T + 3 * RH} class="vis soft" />
          <text x={W - 28} y={T + 3 * RH - 8} class="vislbl" text-anchor="end">LINE OF INTERNAL INTERACTION</text>
        </g>
        <g class="bp-nodes">
          {lanes.map((_, r) => cells[r].map((c, i) => (
            <g class={`node ${i === 1 ? 'key' : ''}`}>
              <rect x={L + i * CW + 16} y={T + r * RH + 14} width={CW - 32} height={RH - 28} rx="8" />
              <text x={L + i * CW + CW / 2} y={T + r * RH + RH / 2 + 5} text-anchor="middle" class="lbl">{c}</text>
            </g>
          )))}
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function init() {
    const bp = document.getElementById('bp');
    if (!bp || bp.dataset.init) return;
    bp.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const nodes = bp.querySelectorAll<SVGGElement>('.node');
    const frame = bp.querySelectorAll<SVGElement>('.bp-frame > *');
    const seeded = (n: number) => { const s = Math.sin(n * 12.9898) * 43758.5453; return s - Math.floor(s); };

    // the problem arrives in pieces
    nodes.forEach((el, i) => gsap.set(el, {
      x: (seeded(i + 1) - 0.5) * 320, y: (seeded(i + 7) - 0.5) * 220,
      rotation: (seeded(i + 13) - 0.5) * 18, opacity: 0, transformOrigin: '50% 50%',
    }));
    gsap.set(frame, { opacity: 0 });

    // then settles into the blueprint, decisions last and lit
    const tl = gsap.timeline({ paused: true, defaults: { ease: 'power3.out' } });
    tl.to(nodes, { opacity: 1, duration: 0.5, stagger: { each: 0.03, from: 'random' } }, 0)
      .to(nodes, { x: 0, y: 0, rotation: 0, duration: 1.5, stagger: { each: 0.045, from: 'random' } }, 0.1)
      .to(frame, { opacity: 1, duration: 0.8, stagger: 0.015 }, 1.05)
      .to(bp.querySelectorAll('.node.key rect'), { stroke: '#6190FF', fill: 'rgba(97,144,255,0.07)', duration: 0.7 }, 1.75);

    ScrollTrigger.create({ trigger: bp, start: 'top 72%', once: true, onEnter: () => tl.play() });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .bp { padding: clamp(12px, 2vw, 24px); overflow-x: auto; }
  .bp svg { min-width: 760px; width: 100%; height: auto; display: block; }
  .stage { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; fill: var(--fg); }
  .lane { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; fill: var(--dim); }
  .col { stroke: var(--line-a); stroke-width: 1; }
  .node rect { fill: var(--raised); stroke: var(--line); stroke-width: 1; }
  .lbl { font-family: var(--sans); font-size: 14px; fill: var(--muted); }
  .node.key .lbl { fill: var(--fg); }
  .vis { stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 6 5; opacity: 0.9; }
  .vis.soft { stroke: var(--dim); opacity: 0.8; }
  .vislbl { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; fill: var(--dim); }
</style>
