---
/* Scroll-snap gallery with arrows, a counter and captions. */
import { Image } from 'astro:assets';
interface Item { src: ImageMetadata; alt: string; cap?: string }
interface Props { items: Item[]; id: string; ratio?: string; fit?: 'cover' | 'contain' }
const { items, id, ratio = '2400 / 1557', fit = 'contain' } = Astro.props;
---
<div class="slider" id={id} data-count={items.length}>
  <div class="track" tabindex="0" aria-label="Screens, scroll or use the arrows">
    {items.map((it, i) => (
      <figure class="slide" data-i={i}>
        <div class="frame" style={`aspect-ratio:${ratio}`}><Image src={it.src} alt={it.alt} width={2400} format="webp" quality={82} loading={i === 0 ? 'eager' : 'lazy'} style={`object-fit:${fit}`} /></div>
        {it.cap && <figcaption class="mono"><span class="n">{String(i + 1).padStart(2, '0')}</span>{it.cap}</figcaption>}
      </figure>
    ))}
  </div>
  <div class="bar">
    <span class="mono count"><b>01</b> / {String(items.length).padStart(2, '0')}</span>
    <div class="nav">
      <button type="button" data-dir="-1"><span class="sr-only">Previous</span><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H4M7.5 4.5 4 8l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" data-dir="1"><span class="sr-only">Next</span><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
  </div>
</div>
<script>
  function init() {
    document.querySelectorAll<HTMLElement>('.slider').forEach((s) => {
      if (s.dataset.init) return; s.dataset.init = '1';
      const track = s.querySelector<HTMLElement>('.track')!, count = s.querySelector<HTMLElement>('.count b')!;
      const slides = [...s.querySelectorAll<HTMLElement>('.slide')];
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) count.textContent = String(+(e.target as HTMLElement).dataset.i! + 1).padStart(2, '0'); }), { root: track, threshold: 0.6 });
      slides.forEach((el) => io.observe(el));
      s.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => {
        const w = slides[0].getBoundingClientRect().width + 16;
        track.scrollBy({ left: w * +b.dataset.dir!, behavior: 'smooth' });
      }));
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
<style>
  .slider { display: grid; gap: 12px; }
  .track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: 12px; }
  .slide { flex: none; width: 100%; scroll-snap-align: start; margin: 0; display: grid; gap: 10px; }
  .frame { border: 1px solid var(--line-a); border-radius: 14px; overflow: hidden; background: var(--surface); }
  .frame :global(img) { width: 100%; height: 100%; object-position: center; display: block; background: #F5F6F5; }
  figcaption { display: flex; gap: 10px; align-items: baseline; font-size: 11px; letter-spacing: 0.06em; color: var(--muted); }
  figcaption .n { color: var(--accent); letter-spacing: 0.1em; }
  .bar { display: flex; align-items: center; justify-content: space-between; }
  .count { font-size: 11px; letter-spacing: 0.1em; color: var(--dim); }
  .count b { font-weight: 500; color: var(--fg); }
  .nav { display: flex; gap: 8px; }
  .nav button { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line-a); background: rgba(235,238,245,0.04); color: var(--fg); cursor: pointer; transition: background 0.2s, border-color 0.2s; }
  .nav button:hover { background: rgba(235,238,245,0.09); border-color: rgba(235,238,245,0.22); }
</style>
