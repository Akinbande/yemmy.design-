---
/* Behind the About header: his project covers as dark, see-through cards floating in 3D.
   Each card sits at its own depth and angle and drifts on its own slow loop; the whole scene tilts a little toward the
   pointer, and on scroll the cards rise at different speeds (the far ones slower) and turn as the header leaves.
   A veil keeps the left side dark so the heading always reads. Decorative only: hidden from assistive tech. */
import { Image } from 'astro:assets';
import newdawn from '../assets/newdawn/h1.png';
import glaze from '../assets/glaze/g1.png';
import lucaScreens from '../assets/luca/l2.png';
import collgaAdmin from '../assets/collga/admin1.png';
import hometownLanding from '../assets/hometown/la1.png';

// x, y: position in the header (%); w: width; z: depth (px, negative is further away); ry, rx: angle; o: opacity; d: drift loop
const cards: { src: ImageMetadata | string; x: number; y: number; w: string; z: number; ry: number; rx: number; o: number; d: number }[] = [
  { src: '/covers/collga-1280.png', x: 50, y: 4, w: 'clamp(220px, 25vw, 400px)', z: -120, ry: -18, rx: 6, o: 0.55, d: 7 },
  { src: '/covers/luca-1280.png', x: 73, y: 18, w: 'clamp(200px, 22vw, 360px)', z: -40, ry: -24, rx: 4, o: 0.62, d: 8 },
  { src: '/covers/hometown-1280.png', x: 58, y: 50, w: 'clamp(210px, 24vw, 380px)', z: 0, ry: -14, rx: -4, o: 0.55, d: 9 },
  { src: newdawn, x: 85, y: 56, w: 'clamp(170px, 18vw, 300px)', z: -200, ry: -28, rx: 2, o: 0.42, d: 7.5 },
  { src: glaze, x: 36, y: 68, w: 'clamp(180px, 20vw, 320px)', z: -260, ry: -10, rx: -6, o: 0.36, d: 8.5 },
  { src: hometownLanding, x: 88, y: -4, w: 'clamp(150px, 16vw, 260px)', z: -320, ry: -30, rx: 8, o: 0.3, d: 10 },
  { src: lucaScreens, x: 18, y: -8, w: 'clamp(150px, 16vw, 260px)', z: -420, ry: 12, rx: 6, o: 0.22, d: 9.5 },
  { src: collgaAdmin, x: 42, y: 28, w: 'clamp(130px, 14vw, 230px)', z: -520, ry: -8, rx: 2, o: 0.24, d: 11 },
];
---
<div class="cards3d" id="about-cards" aria-hidden="true">
  <div class="scene">
    {cards.map((c) => (
      <div class="pc" data-z={c.z} data-ry={c.ry} data-rx={c.rx} style={`left:${c.x}%;top:${c.y}%;width:${c.w};--o:${c.o};--d:${c.d}s`}>
        <div class="pc-in">
          {typeof c.src === 'string'
            ? <img src={c.src} alt="" width="1280" height="830" loading="eager" decoding="async" />
            : <Image src={c.src} alt="" width={900} format="webp" quality={80} loading="eager" />}
        </div>
      </div>
    ))}
  </div>
  <i class="veil"></i>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  let ctl: AbortController | null = null;
  function init() {
    ctl?.abort(); ctl = new AbortController();
    const root = document.getElementById('about-cards');
    if (!root || root.dataset.init) return; root.dataset.init = '1';
    const scene = root.querySelector<HTMLElement>('.scene')!;
    const pcs = [...root.querySelectorAll<HTMLElement>('.pc')];
    // GSAP owns every card's transform: its depth and angle are set here, then scroll adds to them
    pcs.forEach((p) => gsap.set(p, { z: +p.dataset.z!, rotationY: +p.dataset.ry!, rotationX: +p.dataset.rx!, transformPerspective: 0 }));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('live');
    const hero = root.parentElement!;
    // scroll: near cards rise faster than far ones, and every card turns a little as the header leaves
    pcs.forEach((p) => {
      const near = 1 - Math.min(1, Math.abs(+p.dataset.z!) / 600);   // 1 for the nearest, about 0.1 for the furthest
      gsap.to(p, { y: -(80 + 220 * near), rotationY: `+=${6 + 10 * near}`, ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.8 } });
    });
    gsap.to(scene, { opacity: 0.35, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
    // pointer: the scene leans toward the cursor, softly
    if (matchMedia('(hover: hover)').matches) {
      const ry = gsap.quickTo(scene, 'rotationY', { duration: 1.2, ease: 'power3.out' });
      const rx = gsap.quickTo(scene, 'rotationX', { duration: 1.2, ease: 'power3.out' });
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        ry(((e.clientX - r.left) / r.width - 0.5) * 8);
        rx(-((e.clientY - r.top) / r.height - 0.5) * 6);
      }, { signal: ctl.signal });
      hero.addEventListener('pointerleave', () => { ry(0); rx(0); }, { signal: ctl.signal });
    }
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* the stage fills the header, under the words; perspective gives the cards their depth */
  .cards3d { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; perspective: 1400px; perspective-origin: 70% 40%; }
  .scene { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform, opacity; }
  .pc { position: absolute; transform-style: preserve-3d; will-change: transform; }
  .pc-in { border-radius: 14px; overflow: hidden; opacity: var(--o); border: 1px solid rgba(255, 255, 255, 0.09); background: #0C0D0F;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55); }
  .live .pc-in { animation: drift var(--d) ease-in-out infinite alternate; }
  @keyframes drift { from { transform: translate3d(0, -10px, 0) rotateZ(-0.6deg); } to { transform: translate3d(0, 12px, 0) rotateZ(0.6deg); } }
  .pc-in :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 2400 / 1557; object-fit: cover; }
  /* the veil: dark where the words are, lighter where the cards float, and fading into the page at the bottom */
  .veil { position: absolute; inset: 0; background:
    linear-gradient(90deg, var(--ink) 0%, rgba(5, 5, 6, 0.9) 30%, rgba(5, 5, 6, 0.42) 62%, rgba(5, 5, 6, 0.5) 100%),
    linear-gradient(180deg, rgba(5, 5, 6, 0.35) 0%, transparent 30%, transparent 62%, var(--ink) 100%); }
  /* phones: fewer, fainter cards so the words always win */
  @media (max-width: 760px) {
    .pc:nth-child(n + 6) { display: none; }
    .pc-in { opacity: calc(var(--o) * 0.6); }
    .veil { background: linear-gradient(180deg, rgba(5, 5, 6, 0.55) 0%, rgba(5, 5, 6, 0.78) 55%, var(--ink) 100%); }
  }
</style>
