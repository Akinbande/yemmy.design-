---
/* Behind the About header: his project covers on a slow 3D carousel ring (his choice).
   The ring is tilted, seen a little from above, and turns without stopping: each cover comes around from the back
   (dim and small), sweeps across the front (bright and large), and goes round again. At the sides a cover angles like
   it sits on the ring; at the back it still faces the viewer, so no screen ever shows mirrored. Scrolling spins the
   ring faster for a moment; the pointer tilts it; as the header leaves, the ring drifts up and dims. It rests while
   the header is off screen. A veil keeps the left side dark so the heading always reads. Decorative only. */
import { Image } from 'astro:assets';
import newdawn from '../assets/newdawn/h1.png';
import glaze from '../assets/glaze/g1.png';
import lucaScreens from '../assets/luca/l2.png';
import collgaAdmin from '../assets/collga/admin1.png';
import hometownLanding from '../assets/hometown/la1.png';

const cards: (ImageMetadata | string)[] = ['/covers/collga-1280.png', newdawn, '/covers/luca-1280.png', glaze, '/covers/hometown-1280.png', collgaAdmin, lucaScreens, hometownLanding];
---
<div class="cards3d" id="about-cards" aria-hidden="true">
  <div class="rig">
    <div class="scene">
      {cards.map((src) => (
        <div class="pc">
          <div class="pc-in">
            {typeof src === 'string'
              ? <img src={src} alt="" width="1280" height="830" loading="eager" decoding="async" />
              : <Image src={src} alt="" width={900} format="webp" quality={80} loading="eager" />}
          </div>
        </div>
      ))}
    </div>
  </div>
  <i class="veil"></i>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  let ctl: AbortController | null = null;
  let tick: ((t: number, dt: number) => void) | null = null;
  function init() {
    ctl?.abort(); ctl = new AbortController();
    if (tick) { gsap.ticker.remove(tick); tick = null; }
    const root = document.getElementById('about-cards');
    if (!root || root.dataset.init) return; root.dataset.init = '1';
    const { signal } = ctl;
    const rig = root.querySelector<HTMLElement>('.rig')!, scene = root.querySelector<HTMLElement>('.scene')!;
    const pcs = [...root.querySelectorAll<HTMLElement>('.pc')];
    const N = pcs.length, TILT = -12;   // the ring leans back 12 degrees, so we see it a little from above
    let R = 0;
    const size = () => { const w = root.clientWidth; R = w < 760 ? w * 0.5 : Math.min(560, w * 0.3); };
    size();
    window.addEventListener('resize', size, { passive: true, signal });
    gsap.set(scene, { rotationX: TILT });

    // place every cover for a given turn of the ring: front is bright and near, back is dim and far
    const render = (deg: number) => {
      pcs.forEach((p, i) => {
        const a = ((deg + (i * 360) / N) * Math.PI) / 180;
        const x = Math.sin(a) * R, z = Math.cos(a) * R, front = (Math.cos(a) + 1) / 2;
        p.style.transform = `translate(-50%, -50%) translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px) rotateY(${(Math.sin(a) * 28).toFixed(2)}deg)`;
        p.style.opacity = (0.12 + 0.6 * front * front).toFixed(3);
      });
    };
    let angle = 20;
    render(angle);
    (root as any).__ring = { render };   // lets a reviewer set the ring to any turn
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // the turn: about one revolution a minute, faster for a moment while the page scrolls, then easing back
    let boost = 0, running = true;
    tick = (_t, dt) => {
      if (!running) return;
      boost *= 0.94;
      angle -= ((6 + boost * 16) * dt) / 1000;
      render(angle);
    };
    gsap.ticker.add(tick);
    const hero = root.parentElement!;
    ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top',
      onToggle: (self) => (running = self.isActive),
      onUpdate: (self) => (boost = Math.max(boost, Math.min(3, Math.abs(self.getVelocity()) / 600))) });
    // the ring drifts up as the header leaves; the fade sits on the outer stage, because opacity on the ring's own
    // layers would flatten it and lose the depth
    gsap.to(rig, { y: -140, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
    gsap.to(root, { opacity: 0.35, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
    // pointer: the ring tilts toward the cursor, softly
    if (matchMedia('(hover: hover)').matches) {
      const ry = gsap.quickTo(scene, 'rotationY', { duration: 1.2, ease: 'power3.out' });
      const rx = gsap.quickTo(scene, 'rotationX', { duration: 1.2, ease: 'power3.out' });
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        ry(((e.clientX - r.left) / r.width - 0.5) * 10);
        rx(TILT - ((e.clientY - r.top) / r.height - 0.5) * 8);
      }, { signal });
      hero.addEventListener('pointerleave', () => { ry(0); rx(TILT); }, { signal });
    }
  }
  document.addEventListener('astro:page-load', init);
  // the ring stops turning when the visitor leaves the page
  document.addEventListener('astro:before-swap', () => { if (tick) { gsap.ticker.remove(tick); tick = null; } });
</script>

<style>
  /* the stage fills the header, under the words; the ring turns around a point to the right of the heading */
  .cards3d { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; perspective: 1400px; perspective-origin: 66% 44%; }
  .rig { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .scene { position: absolute; left: 66%; top: 46%; width: 0; height: 0; transform-style: preserve-3d; will-change: transform; }
  .pc { position: absolute; left: 0; top: 0; width: clamp(200px, 19vw, 320px); will-change: transform, opacity; }
  .pc-in { border-radius: 14px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); background: #0C0D0F; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55); }
  .pc-in :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 2400 / 1557; object-fit: cover; }
  /* the veil: dark where the words are, lighter where the ring turns, and fading into the page at the bottom */
  .veil { position: absolute; inset: 0; background:
    linear-gradient(90deg, var(--ink) 0%, rgba(5, 5, 6, 0.9) 28%, rgba(5, 5, 6, 0.4) 58%, rgba(5, 5, 6, 0.46) 100%),
    linear-gradient(180deg, rgba(5, 5, 6, 0.35) 0%, transparent 30%, transparent 62%, var(--ink) 100%); }
  /* phones: the ring is centred and fainter, and the words sit over a darker veil */
  @media (max-width: 760px) {
    .cards3d { opacity: 0.55; perspective-origin: 50% 34%; }
    .scene { left: 50%; top: 34%; }
    .pc { width: 42vw; }
    .veil { background: linear-gradient(180deg, rgba(5, 5, 6, 0.5) 0%, rgba(5, 5, 6, 0.78) 55%, var(--ink) 100%); }
  }
</style>
