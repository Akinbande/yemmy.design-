---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
---
<section class="hero" id="top">
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="wrap hero-in">
    <div class="copy">
      <p class="eyebrow" data-reveal>Oluwayemi Akinbande &middot; Calgary, Canada</p>
      <h1 class="display hero-title">Designing the systems behind public services.</h1>
      <p class="hero-sub" data-reveal data-reveal-delay="0.35">
        Senior Service &amp; UX Designer with 7 years of experience. Government-funded,
        regulated and citizen-facing digital services, from service blueprint to production.
      </p>
      <div class="hero-cta" data-reveal data-reveal-delay="0.5">
        <a class="btn btn-primary" href="#work">See the work
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn btn-ghost" href="mailto:hello@yemmy.design">hello@yemmy.design</a>
      </div>

      <div class="who" data-reveal data-reveal-delay="0.7">
        <span class="avatar">
          <Image src={portrait} alt="Oluwayemi Akinbande" width={240} height={240} format="webp" quality={82} loading="eager" />
        </span>
        <span class="who-t mono"><b>Oluwayemi Akinbande</b><span>Calgary, Alberta</span></span>
      </div>
    </div>

  </div>
  <div class="scroll-cue mono" aria-hidden="true"><span></span>Scroll</div>
</section>

<style>
  .hero { min-height: 100svh; display: flex; align-items: center; padding-top: var(--nav-h); overflow: hidden; }
  .hero-scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(9,9,10,0.92) 0%, rgba(9,9,10,0.72) 38%, rgba(9,9,10,0) 68%);
  }
  .hero-in { position: relative; width: 100%; padding-top: clamp(40px, 8vh, 96px); padding-bottom: clamp(72px, 12vh, 140px); }

  /* ---------- avatar ---------- */
  .who { display: flex; align-items: center; gap: 18px; margin-top: clamp(40px, 6vh, 64px); }
  @property --arc { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .avatar {
    position: relative; flex: none; width: clamp(84px, 9vw, 112px); aspect-ratio: 1; border-radius: 50%;
    padding: 4px; background: var(--ink);
    animation: float 6s ease-in-out infinite;
  }
  .avatar::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%; padding: 1.5px;
    background: conic-gradient(from var(--arc), transparent 0 62%, var(--accent) 88%, rgba(97,144,255,0.15) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
    animation: arc 5s linear infinite;
  }
  .avatar::after {
    content: ''; position: absolute; inset: -14px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(97,144,255,0.18), transparent 62%);
    animation: glow 6s ease-in-out infinite;
  }
  .avatar :global(img) { position: relative; z-index: 1; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; box-shadow: 0 14px 40px rgba(0,0,0,0.55); }
  .who-t { display: grid; gap: 4px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .who-t b { font-weight: 500; color: var(--fg); }
  @keyframes arc { to { --arc: 360deg; } }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes glow { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .avatar, .avatar::before, .avatar::after { animation: none; } }

  .scroll-cue { position: absolute; left: var(--pad); bottom: 28px; display: flex; align-items: center; gap: 10px; font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
  .scroll-cue span { width: 28px; height: 1px; background: var(--dim); transform-origin: left; animation: cue 2.2s var(--ease) infinite; }
  @keyframes cue { 0% { transform: scaleX(0); opacity: 0; } 40% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1) translateX(14px); opacity: 0; } }
  @media (max-width: 760px) { .hero-scrim { background: linear-gradient(180deg, rgba(9,9,10,0.5), rgba(9,9,10,0.85)); } .hero-title { max-width: none; } }
</style>
