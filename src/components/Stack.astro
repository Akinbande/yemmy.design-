---
/* Screens laid one after another at full width, in the 2400 x 1557 frame. */
import { Image } from 'astro:assets';
interface Item { src: ImageMetadata; alt: string }
interface Props { items: Item[]; ratio?: string }
const { items, ratio = '2400 / 1557' } = Astro.props;
---
<div class="stack">
  {items.map((it, i) => (
    <figure class="shot" data-reveal style={`aspect-ratio:${ratio}`}>
      <Image src={it.src} alt={it.alt} width={2400} format="webp" quality={82} loading={i === 0 ? 'eager' : 'lazy'} />
    </figure>
  ))}
</div>
<style>
  .stack { display: grid; gap: clamp(16px, 2.2vw, 28px); }
  .shot { margin: 0; border: 1px solid var(--line-a); border-radius: 16px; overflow: hidden; background: #F5F6F5; }
  .shot :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }
</style>
