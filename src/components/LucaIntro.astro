---
/* The first screen of the Luca study. No titles, clean assets on #DFF4FF, a phone with a 0.5px black outline.
   1 the first onboarding screen arrives; 2 the other two slide out from behind and close back;
   3 naira and the jobs of a small shop circle the phone; 4 the icons roll up and the phone leaves the frame,
   then they spin down into the ground where a wireframe house (the keeping place) draws itself, line by line;
   5 the camera flies in through its door and the phone comes back out with the home screen;
   6 the app plays, pages pushing in like iOS and sheets rising; 7 the phone leaves, and the loop brings it back. */
import { Image } from 'astro:assets';
import onb1 from '../assets/luca/onb1.png';
import onb2 from '../assets/luca/onb2.png';
import onb3 from '../assets/luca/onb3.png';
import dashboard from '../assets/luca/dashboard.png';
import inv1 from '../assets/luca/app-inventory1.png';
import inv2 from '../assets/luca/app-inventory2.png';
import wallet from '../assets/luca/wallet.png';
import e1 from '../assets/luca/app-e1.png';
import e2 from '../assets/luca/app-e2.png';

// push = a new page slides in from the right; sheet = a dialog rises over the page it belongs to
const flow: [ImageMetadata, 'push' | 'sheet'][] = [[dashboard, 'push'], [inv1, 'push'], [inv2, 'sheet'], [wallet, 'push'], [e1, 'push'], [e2, 'sheet']];
const line = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
const icons = [
  { k: 'naira', svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 18V6l8 12V6M5 10.5h14M5 13.5h14"/></svg>' },
  { k: 'receipt', svg: line('M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6M9 16h3') },
  { k: 'chart', svg: line('M4 20h16M7 16v-4M12 16V8M17 16V5') },
  { k: 'stock', svg: line('M3 7.5 12 3l9 4.5-9 4.5-9-4.5zM3 7.5v9L12 21l9-4.5v-9M12 12v9') },
  { k: 'wallet', svg: line('M4 7h14a2 2 0 0 1 2 2v9H4zM4 7l11-3v3M16 13.5h1.5') },
  { k: 'people', svg: line('M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3.5 20c0-3.2 2.5-5.2 5.5-5.2s5.5 2 5.5 5.2M16 11.2a2.6 2.6 0 1 0 0-5.2M17.5 14.9c1.9.6 3 2.3 3 5.1') },
];
---
<figure class="intro" id="luca-intro" role="img" aria-label="The Luca app: its three onboarding screens, a house that keeps the books, then the home screen, products, wallet and bills, playing on a loop">
  <div class="stage">
    <canvas class="house" aria-hidden="true"></canvas>
    <div class="orbit" aria-hidden="true">
      <i class="ring r1"></i><i class="ring r2"></i>
      <div class="spin">
        {icons.map((ic, i) => <span class={`badge ${ic.k}`} style={`--a:${i * 60}deg`}><span class="up" set:html={ic.svg} /></span>)}
      </div>
    </div>
    <div class="deck" aria-hidden="true">
      <div class="ph side left"><Image src={onb2} alt="" width={720} format="webp" quality={84} /></div>
      <div class="ph side right"><Image src={onb3} alt="" width={720} format="webp" quality={84} /></div>
      <div class="ph main">
        <div class="scr"><Image src={onb1} alt="" width={720} format="webp" quality={84} loading="eager" /></div>
        {flow.map(([src, kind]) => <div class="scr" data-kind={kind}><Image src={src} alt="" width={720} format="webp" quality={84} /></div>)}
      </div>
    </div>
  </div>
</figure>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const root = document.getElementById('luca-intro');
    if (!root || root.dataset.init) return; root.dataset.init = '1';
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const qa = (s: string) => [...root.querySelectorAll<HTMLElement>(s)];
    const main = q('.main'), L = q('.side.left'), R = q('.side.right'), orbit = q('.orbit'), spin = q('.spin');
    const canvas = q<HTMLCanvasElement>('canvas.house');
    const rings = qa('.ring'), ups = qa('.up'), scr = qa('.main .scr');
    gsap.set(scr, { xPercent: 100 }); gsap.set(scr[0], { xPercent: 0 });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.set(L, { xPercent: -106, rotation: -6, scale: 0.9, opacity: 1 }); gsap.set(R, { xPercent: 106, rotation: 6, scale: 0.9, opacity: 1 });
      return;
    }
    // the house loads alongside; until it is ready its frames simply are not drawn
    const hs = { build: 0, rot: 0.55, zoom: 0, fade: 1, labels: 0 };
    let house: { state: typeof hs; render(): void; setSize(w: number, h: number): void } | null = null;
    const draw = () => { if (!house) return; Object.assign(house.state, hs); house.render(); };
    import('../scripts/datahouse').then(({ createDataHouse }) => {
      try { house = createDataHouse(canvas); } catch { return; }
      const fit = () => { const r = canvas.getBoundingClientRect(); house!.setSize(r.width, r.height); draw(); };
      new ResizeObserver(fit).observe(canvas); fit();
    }).catch(() => {});

    // the phone waits just below the stage: the film starts by bringing it up, with no pause
    gsap.set(main, { yPercent: 110 });
    const tl = gsap.timeline({ repeat: -1, paused: true, defaults: { ease: 'power3.inOut' } });
    tl.set(scr, { xPercent: 100, opacity: 1, scale: 1, filter: 'brightness(1)', boxShadow: '-14px 0 30px rgba(15,30,60,0)' }).set(scr[0], { xPercent: 0 })
      .set([L, R], { xPercent: 0, rotation: 0, scale: 0.86, opacity: 0 })
      .set(orbit, { opacity: 0, yPercent: 0 }).set(rings, { scale: 0.7, opacity: 0 }).set(ups, { scale: 0, rotation: 0, opacity: 1 })
      .set(spin, { rotation: 0, '--r': '45cqh' }).set(canvas, { opacity: 0 }).set(hs, { build: 0, rot: 0.55, zoom: 0, fade: 1, labels: 0 })
      // 1 the phone rises into view with the first onboarding screen (it left through the top at the end of the last loop)
      .fromTo(main, { yPercent: 110, scale: 0.96, opacity: 1 }, { yPercent: 0, scale: 1, duration: 0.6, ease: 'power3.out' })
      // 2 the other two slide out from behind it, hold, and close back
      .to(L, { xPercent: -106, rotation: -6, scale: 0.9, opacity: 1, duration: 0.6, ease: 'power3.out' }, '-=0.2')
      .to(R, { xPercent: 106, rotation: 6, scale: 0.9, opacity: 1, duration: 0.6, ease: 'power3.out' }, '<')
      .to({}, { duration: 0.7 })
      .to([L, R], { xPercent: 0, rotation: 0, scale: 0.86, opacity: 0, duration: 0.45 })
      // 3 naira and the jobs of a small shop circle the phone
      .set(orbit, { opacity: 1 })
      .to(rings, { scale: 1, opacity: 1, duration: 0.45, ease: 'power3.out', stagger: 0.05 }, '-=0.1')
      .to(ups, { scale: 1, duration: 0.4, ease: 'back.out(1.8)', stagger: 0.04 }, '-=0.3')
      .to(spin, { rotation: 90, duration: 1.1, ease: 'power1.inOut' }, '-=0.25')
      .to(ups, { rotation: -90, duration: 1.1, ease: 'power1.inOut' }, '<')
      // 4 the icons roll up while the phone leaves the frame...
      .addLabel('roll')
      .to(orbit, { yPercent: -7, duration: 0.35, ease: 'power2.out' }, 'roll')
      .to(spin, { rotation: '+=45', duration: 0.35, ease: 'power2.out' }, 'roll')
      .to(main, { yPercent: -125, scale: 0.92, duration: 0.6, ease: 'power3.in' }, 'roll')
      // ...then spin down into the ground, where the shop draws itself, line by line
      .addLabel('down')
      .to(orbit, { yPercent: 19, duration: 0.8, ease: 'power2.in' }, 'down')
      .to(spin, { rotation: '+=300', '--r': '3cqh', duration: 0.8, ease: 'power2.in' }, 'down')
      .to(ups, { rotation: '-=345', scale: 0.35, opacity: 0, duration: 0.8, ease: 'power2.in' }, 'down')
      .to(rings, { scale: 0.2, opacity: 0, duration: 0.8, ease: 'power2.in' }, 'down')
      .set(canvas, { opacity: 1 }, 'down+=0.45')
      .to(hs, { build: 1, rot: 0.2, duration: 1.3, ease: 'power1.inOut', onUpdate: draw }, 'down+=0.45')
      // its labels come in: an icon on every box, the cashier's phone, then the sale, stock, debts and wallet tags
      .to(hs, { labels: 1, rot: 0.06, duration: 1.1, ease: 'power1.out', onUpdate: draw })
      .to(hs, { rot: 0, duration: 0.8, ease: 'power1.inOut', onUpdate: draw })
      // 5 the camera flies in through the door, and the phone comes back out with the home screen
      .to(hs, { zoom: 1, duration: 0.95, ease: 'power2.in', onUpdate: draw })
      .to(hs, { fade: 0, duration: 0.3, ease: 'power1.in', onUpdate: draw }, '-=0.3')
      .set(canvas, { opacity: 0 })
      .set(scr, { xPercent: 100 }, '-=0.45').set(scr[1], { xPercent: 0 }, '<')
      .fromTo(main, { yPercent: 0, scale: 0.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.7, ease: 'power3.out' }, '<');
    // 6 the app: pages push in like iOS (the new page carries a soft shadow, the old one drifts back and dims)
    for (let i = 2; i < scr.length; i++) {
      const inn = scr[i], out = scr[i - 1];
      if (inn.dataset.kind === 'sheet') tl.fromTo(inn, { xPercent: 0, opacity: 0, scale: 1.02 }, { opacity: 1, scale: 1, duration: 0.4, ease: 'power2.out' }, '+=0.65');
      else tl.fromTo(inn, { xPercent: 100, boxShadow: '-14px 0 30px rgba(15,30,60,0)' }, { xPercent: 0, boxShadow: '-14px 0 30px rgba(15,30,60,0.16)', duration: 0.6, ease: 'expo.inOut' }, '+=0.65')
        .to(out, { xPercent: -30, filter: 'brightness(0.84)', duration: 0.6, ease: 'expo.inOut' }, '<');
    }
    // 7 the phone leaves through the top; the loop brings it straight back up from below
    tl.to(main, { yPercent: -115, scale: 0.96, duration: 0.55, ease: 'power3.in' }, '+=0.7');
    (root as any).__tl = tl; // lets a reviewer seek to any frame
    // it loops for as long as it is on screen, and starts at once if it already is
    const st = ScrollTrigger.create({ trigger: root, start: 'top 95%', end: 'bottom 5%', onToggle: (self) => (self.isActive ? tl.play() : tl.pause()) });
    if (st.isActive) tl.play();
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .intro { margin: 0; }
  .stage { position: relative; aspect-ratio: 16 / 9; background: #DFF4FF; border-radius: 16px; overflow: hidden; container-type: size; }
  .house { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
  .deck, .orbit { position: absolute; inset: 0; display: grid; place-items: center; }
  /* the phone: white, a 0.5px black outline, iPhone proportions and corners */
  .ph { position: relative; grid-area: 1 / 1; height: 78cqh; aspect-ratio: 1125 / 2436; border: 0.5px solid #0B0B0C; border-radius: 13% / 6%;
    background: #fff; overflow: hidden; box-shadow: 0 1.6cqh 4cqh -1.6cqh rgba(16, 52, 84, 0.16); will-change: transform; }
  .side { opacity: 0; }
  .scr { position: absolute; inset: 0; background: #fff; will-change: transform; }
  .ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }

  .orbit { opacity: 0; pointer-events: none; }
  .ring { grid-area: 1 / 1; border-radius: 50%; border: 1px solid rgba(1, 181, 236, 0.55); }
  .r1 { width: 90cqh; height: 90cqh; }
  .r2 { width: 70cqh; height: 70cqh; border-color: rgba(1, 181, 236, 0.32); }
  .spin { --r: 45cqh; grid-area: 1 / 1; position: relative; width: 90cqh; height: 90cqh; }
  .badge { position: absolute; left: 50%; top: 50%; width: 9cqh; height: 9cqh; margin: -4.5cqh 0 0 -4.5cqh;
    transform: rotate(var(--a)) translateY(calc(-1 * var(--r))) rotate(calc(-1 * var(--a))); }
  .up { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; background: #fff; border: 0.5px solid #0B0B0C; color: #1E1F4B; }
  .up :global(svg) { width: 52%; height: 52%; }
  .naira .up { background: #01B5EC; border-color: #01B5EC; color: #fff; }
</style>
