---
import { getCollection } from 'astro:content';
const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const work = all.filter((e) => e.data.tier === 1);
const screens = all.filter((e) => e.data.tier >= 2);
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/travel/', label: 'Travel' },
  { href: '/#about', label: 'About' },
];
---
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a class="mark" href="/" aria-label="yemmy.design, home">yemmy<i>.</i></a>
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="btn btn-primary btn-sm" href="mailto:hello@yemmy.design">Get in touch</a>
      <button class="menu-btn" id="menu-open" type="button" aria-controls="layers" aria-expanded="false">
        <span class="sr-only">Open menu</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <rect x="1.5" y="2.5" width="15" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
          <rect x="1.5" y="11" width="15" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="layers-backdrop" id="layers-backdrop" hidden></div>
<aside class="layers" id="layers" hidden role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="layers-head">
    <span class="eyebrow">Layers</span>
    <button class="icon-btn" id="menu-close" type="button"><span class="sr-only">Close menu</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
  </div>
  <ul class="layers-list">
    <li class="layer group">
      <a class="row" href="/#work">
        <svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1.5" y="1.5" width="11" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3"/><rect x="0" y="0" width="3" height="3" fill="currentColor"/><rect x="11" y="0" width="3" height="3" fill="currentColor"/><rect x="0" y="11" width="3" height="3" fill="currentColor"/><rect x="11" y="11" width="3" height="3" fill="currentColor"/></svg>
        <span>Work</span><span class="mono count">{work.length}</span>
      </a>
      <ul>
        {work.map((w) => (
          <li class="layer child">
            <a class="row" href={`/work/${w.id}/`}>
              <svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1.5" y="2.5" width="11" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/></svg>
              <span class="name">{w.data.org}</span>
              <span class={`dot ${w.data.status}`} aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </li>
    <li class="layer group">
      <a class="row" href="/#more">
        <svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1.5" y="2.5" width="11" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M1.5 5.5h11" stroke="currentColor" stroke-width="1.3"/></svg>
        <span>Screens</span><span class="mono count">{screens.length}</span>
      </a>
      <ul>
        {screens.map((w) => (
          <li class="layer child">
            <a class="row" href={`/screens/${w.id}/`}>
              <svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1.5" y="2.5" width="11" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/></svg>
              <span class="name">{w.data.org}</span>
              <span class={`dot ${w.data.status}`} aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </li>
    <li class="layer"><a class="row" href="/writing/"><svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 2.5h8v9H3z" stroke="currentColor" stroke-width="1.3"/><path d="M5 5.5h4M5 8h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span>Writing</span></a></li>
    <li class="layer"><a class="row" href="/travel/"><svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.3"/><path d="M1.5 7h11M7 1.5c2 2 2 9 0 11M7 1.5c-2 2-2 9 0 11" stroke="currentColor" stroke-width="1.3"/></svg><span>Travel</span></a></li>
    <li class="layer"><a class="row" href="/#approach"><svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 3.5h10M2 7h10M2 10.5h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span>Approach</span></a></li>
    <li class="layer"><a class="row" href="/#about"><svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="5" r="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 12.5c.6-2.5 2.4-3.5 4.5-3.5s3.9 1 4.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span>About</span></a></li>
    <li class="layer"><a class="row" href="mailto:hello@yemmy.design"><svg class="ic" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1.5" y="3" width="11" height="8" rx="1.3" stroke="currentColor" stroke-width="1.3"/><path d="M2 4l5 4 5-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Contact</span></a></li>
  </ul>
  <div class="layers-foot mono">
    <span><kbd>⌘</kbd><kbd>K</kbd> jump anywhere</span>
    <span>Calgary, Canada</span>
  </div>
</aside>

<div class="palette" id="palette" hidden role="dialog" aria-modal="true" aria-label="Jump to">
  <div class="palette-box">
    <label class="sr-only" for="palette-input">Jump to</label>
    <input id="palette-input" type="text" placeholder="Jump to a page or case study" autocomplete="off" spellcheck="false" />
    <ul id="palette-list">
      {links.map((l) => <li data-cmd={`page ${l.label}`}><a href={l.href}><span class="k">Page</span>{l.label}</a></li>)}
      {work.map((w) => <li data-cmd={`work ${w.data.org} ${w.data.title}`}><a href={`/work/${w.id}/`}><span class="k">Work</span>{w.data.org}<span class="sub">{w.data.title}</span></a></li>)}
      {screens.map((w) => <li data-cmd={`screens ${w.data.org} ${w.data.title}`}><a href={`/screens/${w.id}/`}><span class="k">Screens</span>{w.data.org}<span class="sub">{w.data.title}</span></a></li>)}
      <li data-cmd="contact email hello"><a href="mailto:hello@yemmy.design"><span class="k">Contact</span>hello@yemmy.design</a></li>
    </ul>
  </div>
</div>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 40; height: var(--nav-h);
    transition: transform 0.4s var(--ease), background 0.3s, border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav--solid { background: rgba(9, 9, 10, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom-color: var(--line-soft); }
  .nav-in { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .mark { font-weight: 600; font-size: 22px; letter-spacing: -0.035em; line-height: 1; display: inline-flex; align-items: baseline; }
  .mark i { font-style: normal; color: var(--accent); }
  .nav-links { display: flex; gap: 26px; font-size: 14px; color: var(--muted); }
  .nav-links a { padding: 8px 0; transition: color 0.2s; min-height: 24px; }
  .nav-links a:hover { color: var(--fg); }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .btn-sm { padding: 9px 15px; font-size: 13.5px; min-height: 40px; }
  .menu-btn, .icon-btn {
    display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px;
    border-radius: 10px; border: 1px solid var(--line-a); background: rgba(235,238,245,0.03); color: var(--fg); cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .menu-btn { display: none; }               /* desktop: the top-bar links carry the menu */
  .menu-btn:hover, .icon-btn:hover { background: rgba(235,238,245,0.08); border-color: rgba(235,238,245,0.2); }
  @media (max-width: 760px) { .nav-links { display: none; } .btn-sm { display: none; } .menu-btn { display: inline-flex; } }

  /* ---------- layers panel ---------- */
  .layers-backdrop { position: fixed; inset: 0; z-index: 50; background: rgba(9,9,10,0.55); opacity: 0; transition: opacity 0.3s; }
  .layers-backdrop.is-open { opacity: 1; }
  .layers {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: 51; width: min(400px, 100vw);
    background: var(--surface); border-left: 1px solid var(--line-a);
    display: flex; flex-direction: column;
    transform: translateX(100%); transition: transform 0.36s var(--ease);
  }
  .layers.is-open { transform: none; }
  .layers-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid var(--line-a); }
  .layers-list, .layers-list ul { list-style: none; margin: 0; padding: 0; }
  .layers-list { padding: 10px 0; flex: 1; overflow: auto; }
  .row {
    display: flex; align-items: center; gap: 12px; padding: 12px 20px; font-size: 15px; color: var(--fg);
    transition: background 0.15s; min-height: 44px;
  }
  .row:hover { background: rgba(235,238,245,0.04); }
  .ic { color: var(--dim); flex: none; }
  .row:hover .ic { color: var(--accent); }
  .count { margin-left: auto; font-size: 11px; color: var(--dim); }
  .child .row { padding-left: 46px; font-size: 14px; color: var(--muted); }
  .child .row:hover { color: var(--fg); }
  .child .name { flex: 1; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--dim); }
  .dot.live { background: var(--ok); } .dot.early-access { background: var(--accent); } .dot.concept { background: var(--warn); }
  .layers-foot { display: flex; justify-content: space-between; padding: 16px 20px; border-top: 1px solid var(--line-a); font-size: 11px; color: var(--dim); letter-spacing: 0.06em; }
  kbd { display: inline-block; font: inherit; padding: 1px 5px; border: 1px solid var(--line); border-radius: 4px; margin-right: 3px; color: var(--muted); }

  /* ---------- palette ---------- */
  .palette { position: fixed; inset: 0; z-index: 60; background: rgba(9,9,10,0.6); backdrop-filter: blur(6px); display: grid; place-items: start center; padding-top: 14vh; opacity: 0; transition: opacity 0.2s; }
  .palette.is-open { opacity: 1; }
  .palette-box { width: min(560px, calc(100vw - 32px)); background: var(--surface); border: 1px solid var(--line-a); border-radius: 14px; overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,0.5); }
  #palette-input { width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--line-a); color: var(--fg); font: 500 16px/1 var(--sans); padding: 18px 20px; outline: none; }
  #palette-list { list-style: none; margin: 0; padding: 8px; max-height: 50vh; overflow: auto; }
  #palette-list li a { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 8px; font-size: 14px; color: var(--fg); }
  #palette-list li.is-active a, #palette-list li a:hover { background: rgba(235,238,245,0.06); }
  #palette-list .k { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); width: 56px; flex: none; }
  #palette-list .sub { color: var(--dim); font-size: 12.5px; margin-left: auto; text-align: right; max-width: 55%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  html.menu-open { overflow: hidden; }
</style>
