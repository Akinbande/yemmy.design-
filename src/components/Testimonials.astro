---
/* Testimonials, shared by the home page and the About page so the two never disagree.
   Real people, written from his account of what he delivered for each of them (2026-09-16). No figures are claimed
   that he did not give. Each person should see and approve their words before v2 goes live.
   The cards glide sideways on an endless loop (the set is drawn twice so the seam never shows), pause while the
   pointer or keyboard focus is on them, and sit still in a scrollable row for reduced motion.
   Renders the heading and the row; the page supplies the section around them. */
import { Image } from 'astro:assets';
import claudia from '../assets/testimonials/claudia-rogers.webp';
import aisha from '../assets/testimonials/aisha.webp';
import tobi from '../assets/testimonials/tobi.webp';
import delia from '../assets/testimonials/delia-toloa.webp';
import pedro from '../assets/testimonials/pedro-2.webp';
interface Props { headingId: string }
const { headingId } = Astro.props;
const testimonials = [
  { photo: claudia, n: 'Claudia Rogers', r: 'Admin, NDIS Provider',
    q: 'Yemmy took the time to understand how our internal operations really run before he designed anything. His brainstorming turned scattered requirements into a clear, well-structured system, and he coordinated every stage of the work with care. The platform he delivered streamlined our daily workflows and took real pressure off the team.' },
  { photo: aisha, n: 'Dr Aisha Adewale', r: 'CEO, Glaze Dental',
    q: 'Yemmy has been an exceptional technology architect for as long as I have known him. He learned how a dental practice actually runs, then delivered far more than a website: sharp systems analysis and solutions that support our patients and our growth. He is brilliant at what he does, and I recommend him without hesitation.' },
  { photo: tobi, n: 'Tobi Oladunjoye', r: 'Product Designer',
    q: 'Working with Yemmy is a lesson in design and engineering leadership. He makes sure everyone understands the project structure and the hard parts, then breaks complex problems down brick by brick. He keeps the whole team engaged, stays ahead of software trends and turns them into real business value. I have loved every project we have shared.' },
  { photo: delia, n: 'Delia Toloa', r: 'SIL Coordinator, NDIS Provider',
    q: 'Yemmy understands the business side of software as well as the technology. He listened to the challenges we face every day, understood the metrics that matter to us, and delivered a platform that made the most difficult parts of our work simple. Our processes now run smoothly, and he made the whole experience easy for our team.' },
  { photo: pedro, n: 'Pedro Chibuzo', r: 'CEO, Kochure Technology',
    q: 'Bringing Yemmy into the company was a great decision. He led design and oversaw key parts of our engineering across crypto and fintech products, always with a calm and thoughtful approach. His real strength is resilience: when the work gets hard, he keeps building and keeps the team moving forward. A great person and a leader you can rely on.' },
];
const loop = [...testimonials, ...testimonials];
---
<div class="section-head" data-reveal><div><p class="eyebrow accent">Testimonials</p><h2 id={headingId}>From people I've worked with.</h2></div></div>
<div class="tm-row" data-reveal>
  <ul class="tm-track">
    {loop.map((t, i) => {
      const copy = i >= testimonials.length;   // the second set only closes the loop: hidden from assistive tech
      return (
        <li aria-hidden={copy ? 'true' : undefined}>
          <figure class="tm">
            <span class="tm-mark" aria-hidden="true">&ldquo;</span>
            <blockquote><p>{t.q}</p></blockquote>
            <figcaption>
              <Image class="av" src={t.photo} alt="" width={96} height={96} format="webp" quality={86} loading="lazy" />
              <span class="who"><b>{t.n}</b><span>{t.r}</span></span>
            </figcaption>
          </figure>
        </li>
      );
    })}
  </ul>
</div>

<style>
  /* the row bleeds to the edges of the wrap and fades out at both ends */
  .tm-row { overflow: hidden; margin: 0 calc(-1 * clamp(0px, 2vw, 24px));
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%); }
  .tm-track { list-style: none; margin: 0; padding: 6px 0 10px; display: flex; width: max-content; animation: tm-glide 75s linear infinite; }
  .tm-row:hover .tm-track, .tm-row:focus-within .tm-track { animation-play-state: paused; }
  @keyframes tm-glide { to { transform: translateX(-50%); } }
  /* a margin, not a gap, so the second set starts exactly half-way and the loop never jumps */
  .tm-track li { flex: none; width: clamp(300px, 32vw, 430px); margin-right: 14px; display: flex; }

  .tm { position: relative; overflow: hidden; margin: 0; width: 100%; display: grid; grid-template-rows: auto 1fr auto; gap: 14px; padding: clamp(24px, 2.6vw, 32px); border-radius: 18px;
    border: 1px solid var(--line-a); background: linear-gradient(160deg, rgba(97, 144, 255, 0.07), var(--surface) 60%); transition: border-color 0.3s, translate 0.4s var(--ease); }
  .tm::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.05) 50%, transparent 80%); transform: translateX(-100%); transition: transform 1s var(--ease); }
  .tm:hover { border-color: rgba(235, 238, 245, 0.2); translate: 0 -3px; }
  .tm:hover::after { transform: translateX(100%); }
  .tm-mark { font-size: 72px; line-height: 0.6; height: 30px; font-weight: 600; color: color-mix(in srgb, var(--accent) 75%, transparent); }
  .tm blockquote { margin: 0; }
  .tm blockquote p { font-size: clamp(15px, 1.15vw, 16.5px); line-height: 1.62; color: var(--fg); letter-spacing: -0.01em; }
  .tm figcaption { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line-a); }
  .tm :global(.av) { width: 46px; height: 46px; flex: none; border-radius: 50%; object-fit: cover; display: block;
    box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px color-mix(in srgb, var(--accent) 45%, transparent); }
  .who { display: grid; gap: 2px; min-width: 0; }
  .who b { font-size: 14.5px; font-weight: 600; }
  .who span { font-size: 13px; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    .tm-track { animation: none; }
    .tm-row { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .tm-track li[aria-hidden='true'] { display: none; }
    .tm:hover { translate: none; }
  }
</style>
