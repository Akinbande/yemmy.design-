---
/* How the Luca screens connect, laid out like a prototype board on #DFF4FF. Every frame is one of his screens; every
   blue wire runs from the spot you tap to the screen it opens. In view, the board builds itself (frames, tap spots, wires),
   then plays one everyday job at a time: the tap spot lights, a dot runs along the wire, the next screen lights up.
   Nothing here is selectable. */
import { Image } from 'astro:assets';
import onb1 from '../assets/luca/onb1.png';
import home from '../assets/luca/app-home.png';
import sell from '../assets/luca/app-sell.png';
import buy from '../assets/luca/app-buy.png';
import products from '../assets/luca/app-products.png';
import wallet from '../assets/luca/app-wallet.png';
import edit from '../assets/luca/app-inventory2.png';
import electricity from '../assets/luca/app-e1.png';
import provider from '../assets/luca/app-e2.png';

// the board is 1778 x 1000 units (16:9); a frame is 94.7 x 205 units, the proportions of the phone screens
const U = { w: 1778, h: 1000 }, F = { w: 94.7, h: 205 };
const frames = [
  { id: 'onb', label: 'Onboarding', src: onb1, x: 230, y: 507 },
  { id: 'home', label: 'Home', src: home, x: 530, y: 507 },
  { id: 'sell', label: 'Sell', src: sell, x: 870, y: 140 },
  { id: 'buy', label: 'Buy', src: buy, x: 870, y: 385 },
  { id: 'products', label: 'Products', src: products, x: 870, y: 630 },
  { id: 'wallet', label: 'Wallet', src: wallet, x: 870, y: 875 },
  { id: 'edit', label: 'Edit product', src: edit, x: 1210, y: 630 },
  { id: 'electricity', label: 'Electricity', src: electricity, x: 1210, y: 875 },
  { id: 'provider', label: 'Choose provider', src: provider, x: 1550, y: 875 },
];
const at = Object.fromEntries(frames.map((f) => [f.id, f]));
// a wire leaves the tap spot (centre x, centre y, width, height, as a share of the frame, read from his screens)
// and ends on the left edge of the screen it opens
const wires = [
  { id: 'start', from: 'onb', to: 'home', hot: [0.745, 0.808, 0.34, 0.055] },
  { id: 'sell', from: 'home', to: 'sell', hot: [0.257, 0.362, 0.39, 0.052] },
  { id: 'buy', from: 'home', to: 'buy', hot: [0.74, 0.362, 0.39, 0.052] },
  { id: 'products', from: 'home', to: 'products', hot: [0.367, 0.925, 0.2, 0.08] },
  { id: 'wallet', from: 'home', to: 'wallet', hot: [0.634, 0.925, 0.2, 0.08] },
  { id: 'edit', from: 'products', to: 'edit', hot: [0.51, 0.462, 0.9, 0.124] },
  { id: 'bills', from: 'wallet', to: 'electricity', hot: [0.5, 0.449, 0.88, 0.06] },
  { id: 'provider', from: 'electricity', to: 'provider', hot: [0.5, 0.225, 0.88, 0.05] },
].map((w) => {
  const a = at[w.from], b = at[w.to];
  const [hx, hy, hw, hh] = w.hot;
  const rect = { x: a.x - F.w / 2 + (hx - hw / 2) * F.w, y: a.y - F.h / 2 + (hy - hh / 2) * F.h, w: hw * F.w, h: hh * F.h };
  const sx = rect.x + rect.w, sy = rect.y + rect.h / 2, tx = b.x - F.w / 2 - 5, ty = b.y;
  const k = Math.max(50, (tx - sx) * 0.5);
  const n = (v: number) => v.toFixed(1);
  return { ...w, rect, d: `M${n(sx)} ${n(sy)} C${n(sx + k)} ${n(sy)} ${n(tx - k)} ${n(ty)} ${n(tx)} ${n(ty)}`,
    tip: `M${n(tx - 9)} ${n(ty - 6)} L${n(tx)} ${n(ty)} L${n(tx - 9)} ${n(ty + 6)}` };
});
// the jobs it plays, one at a time
const journeys = [
  { name: 'Get started', steps: ['start'] },
  { name: 'Record a sale', steps: ['sell'] },
  { name: 'Buy new stock', steps: ['buy'] },
  { name: 'Edit a product', steps: ['products', 'edit'] },
  { name: 'Pay for electricity', steps: ['wallet', 'bills', 'provider'] },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const route = Object.fromEntries(wires.map((w) => [w.id, [w.from, w.to]]));
---
<div class="proto-scroll">
  <figure class="proto" id="luca-proto" role="img" data-journeys={JSON.stringify(journeys)} data-route={JSON.stringify(route)}
    aria-label="How the Luca screens connect: Onboarding leads to Home; Home opens Sell, Buy, Products and Wallet; Products opens Edit product; Wallet opens Electricity, which opens Choose provider">
    <div class="board">
      {frames.map((f) => (
        <div class="frame" data-id={f.id} style={`left:${pct(f.x - F.w / 2, U.w)};top:${pct(f.y - F.h / 2, U.h)};width:${pct(F.w, U.w)};height:${pct(F.h, U.h)}`}>
          <span class="name mono">{f.label}</span>
          <div class="scr"><Image src={f.src} alt="" width={360} format="webp" quality={86} loading="lazy" /></div>
        </div>
      ))}
      <svg class="wires" viewBox={`0 0 ${U.w} ${U.h}`} aria-hidden="true">
        {wires.map((w) => (
          <g class="wire" data-id={w.id}>
            <rect class="hot" x={w.rect.x.toFixed(1)} y={w.rect.y.toFixed(1)} width={w.rect.w.toFixed(1)} height={w.rect.h.toFixed(1)} rx="3" />
            <path class="line" d={w.d} />
            <path class="tip" d={w.tip} />
          </g>
        ))}
        <circle class="dot" r="6" cx="-20" cy="-20" />
      </svg>
      <p class="cap mono" aria-hidden="true"><i></i><span>Get started</span></p>
    </div>
  </figure>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const root = document.getElementById('luca-proto');
    if (!root || root.dataset.init) return; root.dataset.init = '1';
    const journeys: { name: string; steps: string[] }[] = JSON.parse(root.dataset.journeys!);
    const route: Record<string, [string, string]> = JSON.parse(root.dataset.route!);
    const frames = [...root.querySelectorAll<HTMLElement>('.frame')];
    const frame = (id: string) => frames.find((f) => f.dataset.id === id)!;
    const groups = [...root.querySelectorAll<SVGGElement>('.wire')];
    const wire = (id: string) => groups.find((g) => g.dataset.id === id)!;
    const lines = groups.map((g) => g.querySelector<SVGPathElement>('.line')!);
    const tips = groups.map((g) => g.querySelector('.tip')!), hots = groups.map((g) => g.querySelector('.hot')!);
    const dot = root.querySelector<SVGCircleElement>('.dot')!, cap = root.querySelector<HTMLElement>('.cap')!, capText = cap.querySelector('span')!;
    const lens = lines.map((l) => l.getTotalLength());
    gsap.set(lines, { strokeDasharray: (i: number) => lens[i] });
    // decode every screen now, so no frame shows white as the board builds
    root.querySelectorAll('img').forEach((im) => { im.loading = 'eager'; im.decode?.().catch(() => {}); });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;   // the board simply shows, complete

    const tl = gsap.timeline({ paused: true });
    // the board builds itself: frames left to right, the tap spots, then each wire draws out of its spot
    tl.set(frames, { opacity: 0, y: 14 }).set([...tips, ...hots, dot, cap], { opacity: 0 }).set(lines, { strokeDashoffset: (i: number) => lens[i] })
      .to(frames, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.07 })
      .to(hots, { opacity: 1, duration: 0.3, stagger: 0.06 }, '-=0.2')
      .to(lines, { strokeDashoffset: 0, duration: 0.7, ease: 'power2.inOut', stagger: 0.09 }, '<')
      .to(tips, { opacity: 1, duration: 0.2, stagger: 0.09 }, '<+0.55')
      .to(cap, { opacity: 1, duration: 0.3 });
    // then one job at a time, on a loop: only its screens and wires stay bright
    const play = gsap.timeline({ repeat: -1 });
    journeys.forEach((j) => {
      const on = new Set(j.steps.flatMap((id) => route[id]));
      play.to(cap, { opacity: 0, duration: 0.18 })
        .call(() => { capText.textContent = j.name; })
        .to(cap, { opacity: 1, duration: 0.25 })
        .to(groups.filter((g) => !j.steps.includes(g.dataset.id!)), { opacity: 0.16, duration: 0.35 }, '<')
        .to(groups.filter((g) => j.steps.includes(g.dataset.id!)), { opacity: 1, duration: 0.35 }, '<')
        .to(frames.filter((f) => !on.has(f.dataset.id!)), { opacity: 0.38, duration: 0.35 }, '<')
        .to(frames.filter((f) => on.has(f.dataset.id!)), { opacity: 1, duration: 0.35 }, '<')
        .to(frame(route[j.steps[0]][0]), { '--on': 1, duration: 0.25 }, '<');
      j.steps.forEach((id) => {
        const g = wire(id), path = g.querySelector<SVGPathElement>('.line')!, len = path.getTotalLength(), p = { t: 0 };
        play.to(g.querySelector('.hot'), { fillOpacity: 0.5, duration: 0.16, yoyo: true, repeat: 1 })
          .set(dot, { opacity: 1 })
          .fromTo(p, { t: 0 }, { t: 1, duration: 0.8, ease: 'power1.inOut', onUpdate: () => {
            const pt = path.getPointAtLength(p.t * len); dot.setAttribute('cx', pt.x.toFixed(1)); dot.setAttribute('cy', pt.y.toFixed(1));
          } })
          .set(dot, { opacity: 0 })
          .to(frame(route[id][1]), { '--on': 1, duration: 0.25 }, '-=0.1')
          .to(frame(route[id][0]), { '--on': 0, duration: 0.25 }, '<');
      });
      play.to({}, { duration: 1.1 }).to(frames, { '--on': 0, duration: 0.3 });
    });
    play.to(groups, { opacity: 1, duration: 0.4 }).to(frames, { opacity: 1, duration: 0.4 }, '<').to({}, { duration: 0.6 });
    tl.add(play);
    (root as any).__tl = tl; // lets a reviewer seek to any frame
    const st = ScrollTrigger.create({ trigger: root, start: 'top 85%', end: 'bottom 10%', onToggle: (self) => (self.isActive ? tl.play() : tl.pause()) });
    if (st.isActive) tl.play();
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .proto { margin: 0; }
  /* a canvas of faint dots, like a design tool's board */
  .board { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; container-type: size; user-select: none; -webkit-user-select: none;
    background: radial-gradient(rgba(30, 31, 75, 0.11) 1px, transparent 1.2px) 0 0 / 2.4cqh 2.4cqh, #DFF4FF; }
  .frame { --on: 0; position: absolute; }
  .scr { position: absolute; inset: 0; overflow: hidden; background: #fff; border: 0.5px solid #0B0B0C; border-radius: 9% / 4.2%;
    box-shadow: 0 0 0 calc(var(--on) * 2.5px) #01B5EC, 0 1cqh 2.4cqh -1cqh rgba(16, 52, 84, 0.2); }
  .scr :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  /* each frame's name sits above it, as on a design board */
  .name { position: absolute; left: 0; bottom: 100%; margin-bottom: 0.9cqh; white-space: nowrap; font-size: clamp(8px, 0.72cqw, 12px); letter-spacing: 0.02em; color: #4E5876; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .hot { fill: #01B5EC; fill-opacity: 0.12; stroke: #01B5EC; stroke-width: 1.6; }
  .line { fill: none; stroke: #01B5EC; stroke-width: 2; stroke-linecap: round; }
  .tip { fill: none; stroke: #01B5EC; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .dot { fill: #01B5EC; stroke: #fff; stroke-width: 2.5; opacity: 0; }
  /* which job is playing */
  .cap { position: absolute; left: 2.4cqw; top: 4cqh; margin: 0; display: flex; align-items: center; gap: 0.6cqw; padding: 1cqh 1.3cqw;
    border-radius: 999px; background: #fff; border: 0.5px solid #0B0B0C; color: #1E1F4B; font-size: clamp(10px, 0.95cqw, 14px); letter-spacing: 0.02em; }
  .cap i { width: 0.55cqw; height: 0.55cqw; min-width: 6px; min-height: 6px; border-radius: 50%; background: #01B5EC; }
  /* phones: the board keeps a readable size and scrolls sideways inside its own frame */
  @media (max-width: 760px) {
    .proto-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 16px; }
    .proto { min-width: 720px; }
  }
</style>
