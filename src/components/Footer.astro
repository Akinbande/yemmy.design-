      </svg>
    </a>
    <div class="side">
      <p class="tag mono">Senior Service &amp; UX Designer &middot; Calgary, Alberta</p>
      <ul class="social" aria-label="Social">
        {links.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${l.label} (opens in a new tab)`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[l.key as keyof typeof icons]} />
          </a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap base mono">
    <span>&copy; {year} Oluwayemi Akinbande</span>
    <span>Built with Astro and Three.js</span>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function init() {
    const svg = document.querySelector<SVGSVGElement>('.wordmark');
    if (!svg || svg.dataset.init) return;
    svg.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const letters = [...svg.querySelectorAll<SVGPathElement>('.ltr')];
    const dot = svg.querySelector<SVGPathElement>('.dot');
    letters.forEach((p) => {
      const len = p.getTotalLength();
      gsap.set(p, { strokeDasharray: len, strokeDashoffset: len, fillOpacity: 0, strokeWidth: 1.1 });
    });
    if (dot) gsap.set(dot, { scale: 0, transformOrigin: '50% 50%' });

    // the mark is drawn, then inked, then the point lands
    const tl = gsap.timeline({ paused: true });
    tl.to(letters, { strokeDashoffset: 0, duration: 1.5, ease: 'power2.inOut', stagger: 0.11 })
      .to(letters, { fillOpacity: 1, duration: 0.7, ease: 'power2.out', stagger: 0.05 }, '-=0.7')
      .to(letters, { strokeWidth: 0, duration: 0.5 }, '-=0.35');
    if (dot) tl.to(dot, { scale: 1, duration: 0.55, ease: 'back.out(2.4)' }, '-=0.3');
    ScrollTrigger.create({ trigger: svg, start: 'top 94%', once: true, onEnter: () => tl.play() });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .foot { position: relative; z-index: 1; border-top: 1px solid var(--line-a); background: var(--ink); }
  .in { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px 40px; padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(28px, 4vw, 44px); }
  .logo { display: block; width: min(420px, 70vw); }
  .wordmark { width: 100%; height: auto; display: block; overflow: visible; }
  .ltr { fill: var(--fg); stroke: var(--fg); stroke-width: 0; }
  .dot { fill: var(--accent); }
  .side { display: grid; gap: 14px; justify-items: end; }
  .tag { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; }
  .social a { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line-a); color: var(--muted); transition: color 0.2s, border-color 0.2s, background 0.2s; }
  .social a:hover { color: var(--fg); border-color: rgba(235,238,245,0.24); background: rgba(235,238,245,0.04); }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-top: 18px; padding-bottom: 28px; border-top: 1px solid var(--line-soft); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); }
  @media (max-width: 760px) { .side { justify-items: start; } }
</style>
