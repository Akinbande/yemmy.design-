---
/* Get in touch: a panel that slides in from the right (a full-height sheet on phones) over whatever page the visitor is on.
   Any link to /contact/ or anything marked data-contact opens it; on /contact/ itself those links go to the page's form.
   Built on <dialog>, so focus stays inside, Escape closes it, and the page behind is inert. */
import ContactForm from './ContactForm.astro';
import { social } from '../config';
const EMAIL = 'hello@yemmy.design';
---
<dialog class="cd" id="contact-dialog" aria-labelledby="cd-title">
  <div class="sheet">
    <header class="head">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2 id="cd-title" tabindex="-1">Let's talk</h2>
        <p class="sub">A few quick questions, so your message arrives with everything I need.</p>
      </div>
      <button type="button" class="x" data-close><span class="sr-only">Close</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </header>
    <div class="body" data-lenis-prevent><ContactForm uid="cd" /></div>
    <footer class="foot">
      <div class="mail"><span class="mono">Prefer email?</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a><button type="button" class="copy" data-copy={EMAIL}>Copy</button></div>
      <div class="meta mono"><a href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a><span>Calgary, Canada · Mountain Time</span></div>
    </footer>
  </div>
</dialog>

<script>
  let ctl: AbortController | null = null;
  function init() {
    ctl?.abort(); ctl = new AbortController();
    const { signal } = ctl;
    const dlg = document.getElementById('contact-dialog') as HTMLDialogElement | null;
    if (!dlg) return;
    const lenis = () => (window as any).__lenis;
    const open = () => {
      if (dlg.open) return;
      const form = dlg.querySelector<HTMLFormElement>('form');
      // a finished message starts fresh next time
      if (form && !form.querySelector<HTMLElement>('.step[data-step="3"]')!.hidden) (form.querySelector('.again') as HTMLButtonElement)?.click();
      dlg.classList.remove('is-closing');
      dlg.showModal();
      document.documentElement.classList.add('menu-open'); lenis()?.stop?.();
      dlg.querySelector<HTMLElement>('#cd-title')?.focus({ preventScroll: true });
    };
    const unlock = () => { document.documentElement.classList.remove('menu-open'); lenis()?.start?.(); };
    // the page scrolls again the moment the panel starts to close; the panel itself closes when its slide-out ends
    // (a timer backs that up), or at once when there is no animation to wait for
    const close = () => {
      if (!dlg.open || dlg.classList.contains('is-closing')) return;
      unlock();
      if (document.hidden || matchMedia('(prefers-reduced-motion: reduce)').matches) { dlg.close(); return; }
      dlg.classList.add('is-closing');
      let done = false;
      const finish = () => { if (!done) { done = true; dlg.close(); } };
      dlg.querySelector('.sheet')!.addEventListener('animationend', finish, { once: true });
      setTimeout(finish, 320);
    };
    // however the panel closes (the button, Escape, the page behind, or the browser itself), the page always scrolls again
    dlg.addEventListener('close', () => { dlg.classList.remove('is-closing'); unlock(); }, { signal });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); close(); } }, { signal });
    (window as any).__contact = { open, close };
    // links to the contact page open the panel instead (new-tab clicks still go to the page)
    document.addEventListener('click', (e) => {
      const t = (e.target as Element | null)?.closest?.('a[href="/contact/"], [data-contact]');
      if (!t || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      if (location.pathname.startsWith('/contact')) {
        const f = document.querySelector<HTMLElement>('.contact-page [data-contact-form]');
        f?.scrollIntoView({ behavior: 'smooth', block: 'start' }); f?.querySelector<HTMLElement>('input[name="intent"]')?.focus({ preventScroll: true });
        return;
      }
      open();
    }, { capture: true, signal });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); }, { signal });          // Escape
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); }, { signal });          // the dimmed page behind
    dlg.querySelector('[data-close]')!.addEventListener('click', close, { signal });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* the dialog covers the viewport and stays see-through; the sheet sits at the right edge */
  .cd { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: var(--fg); overflow: hidden; }
  .cd::backdrop { background: rgba(5, 5, 6, 0.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .cd[open]::backdrop { animation: cd-fade 0.3s ease both; }
  .sheet { position: absolute; top: 0; right: 0; bottom: 0; width: min(580px, 100vw); display: grid; grid-template-rows: auto minmax(0, 1fr) auto;
    background: var(--surface); border-left: 1px solid var(--line-a); box-shadow: -30px 0 80px rgba(0, 0, 0, 0.45); animation: cd-in 0.42s var(--ease) both; }
  .cd.is-closing .sheet { animation: cd-out 0.23s ease-in both; }
  .cd.is-closing::backdrop { animation: cd-fade 0.23s ease-in reverse both; }
  @keyframes cd-in { from { transform: translateX(100%); } to { transform: none; } }
  @keyframes cd-out { from { transform: none; } to { transform: translateX(100%); } }
  @keyframes cd-fade { from { opacity: 0; } to { opacity: 1; } }

  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 24px 28px 18px; border-bottom: 1px solid var(--line-a); }
  .head h2 { font-size: 28px; margin-top: 8px; outline: none; }
  .sub { color: var(--muted); font-size: 14.5px; line-height: 1.5; margin-top: 8px; max-width: 42ch; }
  .x { display: inline-grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 10px; border: 1px solid var(--line-a); background: rgba(235, 238, 245, 0.03); color: var(--fg); cursor: pointer; transition: background 0.2s; }
  .x:hover { background: rgba(235, 238, 245, 0.08); }
  .body { overflow: auto; overscroll-behavior: contain; padding: 22px 28px 30px; }
  .foot { display: grid; gap: 6px; padding: 14px 28px calc(14px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line-a); background: rgba(235, 238, 245, 0.02); }
  .mail { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 14px; }
  .mail .mono { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .mail a { color: var(--fg); border-bottom: 1px solid var(--line); }
  .copy { background: none; border: 1px solid var(--line-a); color: var(--muted); border-radius: 999px; font: 500 12px/1 var(--sans); padding: 6px 10px; cursor: pointer; min-height: 28px; }
  .copy:hover { color: var(--fg); border-color: rgba(235, 238, 245, 0.22); }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 11px; letter-spacing: 0.06em; color: var(--dim); }
  .meta a { color: var(--muted); }
  .meta a:hover { color: var(--fg); }

  /* phones: the panel rises as a full-height sheet */
  @media (max-width: 600px) {
    .sheet { width: 100vw; border-left: 0; animation-name: cd-up; }
    .cd.is-closing .sheet { animation-name: cd-down; }
    .head { padding: 20px 20px 16px; } .body { padding: 18px 20px 26px; } .foot { padding-left: 20px; padding-right: 20px; }
    @keyframes cd-up { from { transform: translateY(100%); } to { transform: none; } }
    @keyframes cd-down { from { transform: none; } to { transform: translateY(100%); } }
  }
  @media (prefers-reduced-motion: reduce) { .sheet, .cd::backdrop { animation: none !important; } }
</style>
