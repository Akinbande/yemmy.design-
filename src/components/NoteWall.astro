---
/* The seam, mapped: one birth registration as it is (four agencies, the same facts four times)
   and as Collga treats it (facts entered once, one journey). Sticky notes settle from a scatter. */
const facts = ["Child's full name", 'Date of birth', 'Place of birth', "Parent's NIN", 'Home address'];
const agencies = [
  { n: 'Odeda General Hospital', t: 'Birth notification', tier: 'Hospital' },
  { n: 'Odeda LGA Registry', t: 'Birth certificate', tier: 'Local government' },
  { n: 'National Identity Commission', t: 'NIN enrolment', tier: 'Federal' },
  { n: 'Ogun State Health Insurance', t: 'Enrol the child', tier: 'State' },
];
---
<div class="wall" id="notewall">
  <div class="board">
    <p class="eyebrow lbl">The seam, mapped &middot; registering one birth</p>
    <div class="lanes">
      {agencies.map((a, i) => (
        <div class="lane">
          <div class={`note agency c${i}`}><span class="mono tier">{a.tier}</span><b>{a.n}</b><span>{a.t}</span></div>
          {facts.slice(0, 3 + (i % 2)).map((f) => <div class="note fact"><span class="mono">form field</span><b>{f}</b></div>)}
        </div>
      ))}
    </div>
    <div class="once">
      <span class="eyebrow">Entered once</span>
      <div class="stack">{facts.map((f, i) => <div class={`note fact pinned`} style={`--i:${i}`}><b>{f}</b><span class="mono re">re-used 4&times;</span></div>)}</div>
    </div>
  </div>
</div>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const wall = document.getElementById('notewall');
    if (!wall || wall.dataset.init) return; wall.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const seeded = (n: number) => { const s = Math.sin(n * 12.9898) * 43758.5453; return s - Math.floor(s); };
    const notes = [...wall.querySelectorAll<HTMLElement>('.lanes .note')];
    const once = wall.querySelector<HTMLElement>('.once')!;
    notes.forEach((n, i) => gsap.set(n, { x: (seeded(i + 1) - 0.5) * 420, y: (seeded(i + 9) - 0.5) * 260, rotation: (seeded(i + 3) - 0.5) * 40, opacity: 0 }));
    gsap.set(once, { opacity: 0, y: 24 });
    gsap.timeline({ defaults: { ease: 'power3.out' }, scrollTrigger: { trigger: wall, start: 'top 75%', toggleActions: 'play none none reverse' } })
      .to(notes, { opacity: 1, duration: 0.4, stagger: { each: 0.03, from: 'random' } })
      .to(notes, { x: 0, y: 0, rotation: (i) => (seeded(i + 21) - 0.5) * 6, duration: 1.3, stagger: { each: 0.05, from: 'random' } }, '<0.1')
      .to(wall.querySelectorAll('.lanes .fact'), { opacity: 0.28, duration: 0.6 }, '+=0.6')
      .to(once, { opacity: 1, y: 0, duration: 0.8 }, '<0.2');
  }
  document.addEventListener('astro:page-load', init);
</script>
<style>
  .wall { border: 1px solid var(--line-a); border-radius: var(--r); background: var(--surface); overflow: hidden; }
  .board { position: relative; padding: clamp(18px, 3vw, 32px); background-image: radial-gradient(rgba(235,238,245,0.07) 1px, transparent 1px); background-size: 22px 22px; }
  .lbl { margin-bottom: 18px; }
  .lanes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .lane { display: grid; gap: 10px; }
  .note { padding: 12px 13px; border-radius: 4px; display: grid; gap: 4px; font-size: 12.5px; line-height: 1.35; color: #1E1F22; box-shadow: 0 10px 24px rgba(0,0,0,0.35), inset 0 -1px 0 rgba(0,0,0,0.08); transform-origin: 50% 20%; }
  .note b { font-weight: 600; letter-spacing: -0.01em; }
  .note .mono { font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; }
  .agency { background: #F7E36A; }
  .agency.c1 { background: #A9E0A0; } .agency.c2 { background: #9FD3F5; } .agency.c3 { background: #F5B08C; }
  .fact { background: #F2EFE6; }
  .once { margin-top: 22px; padding-top: 18px; border-top: 1px dashed var(--line); display: grid; gap: 12px; }
  .stack { display: flex; flex-wrap: wrap; gap: 10px; }
  .pinned { background: #E9F0FF; border-left: 3px solid var(--accent); transform: rotate(calc((var(--i) - 2) * 1deg)); }
  .pinned .re { color: var(--brand-on-light); opacity: 1; }
  @media (max-width: 860px) { .lanes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
