---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Stack from '../../components/Stack.astro';
import Marquee from '../../components/Marquee.astro';
import SystemBoard from '../../components/SystemBoard.astro';
import lockupSvg from '../../../public/collga/collga-lockup.svg?raw';

const entry = (await getEntry('work', 'collga'))!;
const d = entry.data;
const all = (await getCollection('work', (e) => e.data.tier === 1)).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((e) => e.id === 'collga') + 1) % all.length];

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/collga/**/*.png', { eager: true });
const img = (name: string) => { const k = Object.keys(files).find((p) => p.endsWith(`/${name}.png`)); if (!k) throw new Error('missing ' + name); return files[k].default; };
const shots = (names: [string, string][]) => names.map(([n, alt]) => ({ src: img(n), alt }));
const lockup = lockupSvg.replace('<svg ', '<svg class="lockup" ');

const breakdown = [
  { k: 'Who it serves', v: 'Citizens, businesses and administrators', s: 'Three account types behind one login' },
  { k: 'What it covers', v: 'Sixteen systems across four tiers of government', s: 'Federal, state, local government and platform' },
  { k: 'Services', v: 'Twenty-one e-services in nine categories', s: 'Each with its fee, requirements and generated form' },
  { k: 'Channels', v: 'Web, USSD, a ward agent and voice', s: 'English, Yoruba, Hausa, Igbo and Nigerian Pidgin' },
  { k: 'Identity', v: 'Six credentials in a consent wallet', s: 'Agencies ask before they read, and every read is logged' },
  { k: 'The pilot', v: 'Odeda Local Government, Ogun State', s: 'Every screen is set in the 2020 pilot year' },
];
const tiers = [
  ['Federal', ['Life-Event Journeys', 'National ID and Consent Wallet', 'Freedom of Information']],
  ['State', ['Internal Revenue Service', 'Public Procurement', "Governor's Delivery Dashboard", 'Physical Planning', 'Social Investment Registry']],
  ['Local government', ['Citizen and Business Portal', 'Admin Control Panel', 'E-Services Catalogue', 'Land and Property Registry', 'Business Registry']],
  ['Platform', ['Assisted Digital and Inclusion', 'Design System', 'Government Data Exchange']],
];
const rules = [['Enter data once', 'A fact is typed one time and re-used, visibly, by every step that needs it.'], ['Share only with consent', 'An agency must ask first, naming the fields, the duration and the legal basis.'], ['Log every access', 'Every read is written to a log the citizen can open.'], ['Check claims against measurement', 'What an agency reports sits beside what someone measured on site.']];
const decisions = [
  { t: 'Enter once, re-use with consent', p: 'A fact is typed one time. Every step that needs it re-uses it in plain sight, and each re-use is tied to a consent the citizen gave and can withdraw. The convenience and the control are the same mechanism.' },
  { t: 'Privacy you can see working', img: 'id-1', alt: 'Six credentials with their numbers masked, verified at source', p: 'Credential numbers stay masked by default. An officer checking age is told over 18, never a date of birth. What was disclosed and what was withheld both appear on the screen, so privacy is a feature people can watch, not a line in a policy.' },
  { t: 'One notice, every authority', img: 'consolidated', alt: 'A consolidated demand notice assessing state taxes and local levies together', p: 'State taxes and local levies are assessed on one notice. A business pays once and each authority receives its share automatically. It ends the most common complaint of Nigerian businesses: being assessed twice for the same year.' },
  { t: 'Fairness built into the flow', img: 'public-evaluation', alt: 'Evaluation room with bidders anonymised A to E and financial scores computed', p: 'Bids stay sealed until the public opening, bidders are anonymised A to E, financial scores are computed rather than typed, and the award button stays disabled until every evaluator has submitted. The integrity lives in the interaction.' },
  { t: 'Assisted is not second-class', img: 'collections', alt: 'Field collection: agents on duty with a POS app issuing numbered receipts', p: "The channel is the citizen's choice, never the service's. A receipt issued at a market stall by an agent on a POS device is the same receipt, with the same number, as one issued on the web." },
  { t: 'A tile map, not a land map', p: 'Delivery by local government uses equal-area tiles, so no LGA looks more important than another because of its size on a map.' },
];
const swatches = [['#4C9C40', 'Collga Green', 'Primary actions, active nav, brand'], ['#6CB460', 'Leaf', 'Light half of the shield, hover'], ['#1E3F1A', 'Forest', 'Dark buttons, issued badges'], ['#F0913A', 'Civic Orange', 'Landing login, due status'], ['#1E88E5', 'Info Blue', 'Sent, under review'], ['#E53935', 'Danger Red', 'Unpaid, overdue, rejected'], ['#E0E8F0', 'Mist', 'Shield interior, neutral badges'], ['#F5F6F5', 'Ground', 'Page background']];
---
<Base title={`${d.title} · Oluwayemi Akinbande`} ogTitle={d.title} description={d.summary}>
  <article class="study">
    <header class="wrap head">
      <div class="lead">
        <p class="mono crumbs" data-reveal><a href="/#work">Work</a><span class="sep">/</span><span>{d.org}</span></p>
        <h1 data-reveal data-reveal-delay="0.1">{d.title}</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">{d.summary}</p>
      </div>
      <div data-reveal data-reveal-delay="0.25"><Facts d={d} /></div>
    </header>

    <div class="wrap body">

      <section class="sec">
        <div class="copy" data-reveal><h2>What was designed</h2></div>
        <ul class="cards wide" id="glance">
          {breakdown.map((b, i) => (
            <li class="bd" data-reveal data-reveal-delay={String((i % 3) * 0.08)} style={`--i:${i}`}><span class="mono k">{b.k}</span><b>{b.v}</b><span class="s">{b.s}</span></li>
          ))}
        </ul>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Where it started</h2>
          <p>Collga was designed in 2020 for Nigerian state and local governments, with Odeda Local Government as the pilot. The first screens are the ones a citizen meets first: a public front door, one login for everyone, and registration verified against the LGA register.</p>
        </div>
        <div class="wide"><Stack items={shots([['landingpage', 'Landing page with one search box across every government service'], ['aut1', 'Get started: register as a citizen or a business'], ['aut3', 'Citizen account, verified by LGA ID number']])} /></div>
        <div class="wide"><Marquee items={shots([['aut2', 'Business account, verified by RC number'], ['aut5', 'Fetching the applicant record from the LGA database'], ['aut4', 'Error state when the ID or email does not match']])} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>The problem is the seam, not the screen</h2>
          <p>Every service a citizen needs is spread across agencies that do not share a record. Register a business and you deal with the local government, the state tax office and a federal registry, each with its own form, its own queue and its own copy of your details. Collga was designed around that seam, and the board below shows how much of government it had to hold.</p>
        </div>
        <div class="wide"><SystemBoard /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Four rules make crossing the seam safe</h2>
          <p>Almost everything distinctive in the platform comes from them.</p>
        </div>
        <ul class="rules wide">
          {rules.map(([t, p], i) => <li class="panel" data-reveal data-reveal-delay={String(i * 0.07)}><h3>{t}</h3><p>{p}</p></li>)}
        </ul>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Sixteen systems, grouped by the tier that owns them</h2>
          <p>Held together by a platform hub, where an administrator sees the whole estate on one screen.</p>
        </div>
        <div class="tiers wide" data-reveal>
          {tiers.map(([name, list]) => (
            <div class="tier panel"><span class="eyebrow">{name}</span><ul>{(list as string[]).map((s) => <li><i></i>{s}</li>)}</ul></div>
          ))}
        </div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal><h2>Six decisions I would defend in a review</h2></div>
        <ol class="dec wide">
          {decisions.map((x, i) => (
            <li class="d" data-reveal>
              <div class="dt"><h3>{x.t}</h3><p>{x.p}</p></div>
              {x.img && <figure class="shot"><Image src={img(x.img)} alt={x.alt!} width={2400} format="webp" quality={82} loading="lazy" /></figure>}
            </li>
          ))}
        </ol>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Citizen and Business Portal</h2>
          <p>Where residents and businesses apply, pay levies and track what they applied for. Twenty-one services, a five-step wizard, a live status timeline, and a vault for every document issued.</p>
        </div>
        <div class="wide"><Stack items={shots([['citizen1', 'Dashboard: wallet, invoices due, active applications and quick actions'], ['citizen3', 'Birth certificate, step one: applicant details pre-filled from the profile'], ['citizen5', 'Application tracking with the reviewer note and a live timeline']])} /></div>
        <div class="wide"><Marquee items={shots([['citizen2', 'E-services inside the portal'], ['e-service2', 'The public catalogue with fees and processing times'], ['citizen4', 'Step two: the form generated from the service definition'], ['documen-list', 'Documents issued, each verifiable'], ['payment2', 'The wallet and every transaction']])} speed={70} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Admin Control Panel</h2>
          <p>The other side of the same counter. A review queue with assignment and service-level tracking, registries, revenue reporting, and staff with roles.</p>
        </div>
        <div class="wide"><Stack items={shots([['admin1', 'Admin dashboard: collected against invoiced, applications by status'], ['admin2', 'Applications queue with assignees, priority and status'], ['staff-role', 'Staff and roles across departments']])} /></div>
        <div class="wide"><Marquee items={shots([['admin3', 'Business registry with permits and outstanding levies'], ['recvenue1', 'Revenue: collections against invoices'], ['revenue2', 'Revenue by service, channel and ward']])} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Internal Revenue Service</h2>
          <p>The state's view: collected against target by tax type and by local government, and a registry of every taxpayer with a TIN.</p>
        </div>
        <div class="wide"><Stack items={shots([['state-revenue', 'Internal Revenue Service dashboard: collected against target'], ['state-revenue-taxpayer', 'Taxpayers: every individual and business with a TIN']])} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Identity, land and procurement</h2>
          <p>Consent requests that name their legal basis. A parcel map, a title record with its ownership chain, and a transfer that each party signs in turn. Tenders published, bids sealed.</p>
        </div>
        <div class="wide"><Stack items={shots([['id-2', 'Consent requests: the fields, the duration and the legal basis'], ['land1', 'Land and property registry: parcel map by registration status'], ['land-title2', 'Title record with its ownership chain and encumbrances']])} /></div>
        <div class="wide"><Marquee items={shots([['id-request', 'Transfer: each party signs in turn through consent, stamp duty and registration'], ['public1', 'Public procurement: every tender published'], ['public-supply2', 'A sealed bid, unreadable until the public opening']])} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>One identity for sixteen systems</h2>
          <p>Collga Green sampled from the shield. Montserrat for the interface, Roboto for sign-in and long copy. One shell, themed per system, so sixteen products still feel like one government.</p>
        </div>
        <figure class="panel board wide" id="logo-board" data-reveal><div class="art" set:html={lockup} /></figure>
        <ul class="swatches wide" data-reveal>
          {swatches.map(([hex, name, use]) => <li><i style={`background:${hex}`}></i><b>{name}</b><span class="mono">{hex}</span><span class="u">{use}</span></li>)}
        </ul>
      </section>

      <section class="sec">
        <div class="close wide" data-reveal>
          <div class="close-l">
            <span class="eyebrow">Scope</span>
            <h2>A concept, presented in 2020</h2>
            <p>The data on every screen is invented but realistic, modelled on how Nigerian state and local government actually operate: LGA identification numbers, CAC registration, PAYE and tenement rates, governor's consent on land transfers, open-contracting rules.</p>
            <a class="btn btn-ghost" href="/#work">All work
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <a class="close-r" href={`/work/${next.id}/`}>
            <span class="eyebrow">Next study</span>
            <span class="t">{next.data.title}</span>
            <span class="mono o">{next.data.org} &middot; {next.data.year}</span>
            <span class="go"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </section>
    </div>
  </article>
</Base>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function glance() {
    const el = document.getElementById('glance');
    if (!el || el.dataset.init) return; el.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.to(el.querySelectorAll('.bd'), { '--sweep': '220%', duration: 5, ease: 'none', repeat: -1, stagger: { each: 0.35, repeat: -1 },
      scrollTrigger: { trigger: el, start: 'top 90%', end: 'bottom 10%', toggleActions: 'play pause resume pause' } });
  }
  function logo() {
    const board = document.getElementById('logo-board');
    const svg = board?.querySelector<SVGSVGElement>('svg.lockup');
    if (!board || !svg || board.dataset.init) return; board.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const q = (id: string) => svg.querySelector<SVGPathElement>('#' + id)!;
    const dark = q('dark-green'), light = q('light-green'), circle = q('circle'), white = q('circle-white'), gray = q('gray');
    const len = dark.getTotalLength();
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.2, scrollTrigger: { trigger: board, start: 'top 85%', end: 'bottom 10%', toggleActions: 'play pause resume pause' } });
    tl.set([circle, white], { scale: 0, transformOrigin: '50% 50%' }).set(light, { x: -90, opacity: 0 })
      .set(dark, { strokeDasharray: len, strokeDashoffset: len, fillOpacity: 0, stroke: '#4C9C40', strokeWidth: 3 }).set(gray, { opacity: 0, y: 12 })
      .to(light, { x: 0, opacity: 1, duration: 0.7, ease: 'power3.out' })
      .to(dark, { strokeDashoffset: 0, duration: 2.2, ease: 'power2.inOut' }, '-=0.3')
      .to(dark, { fillOpacity: 1, duration: 0.8, ease: 'power2.out' }, '-=0.9')
      .to(dark, { strokeWidth: 0, duration: 0.4 }, '-=0.3')
      .to(circle, { scale: 1, duration: 0.5, ease: 'back.out(2)' }, '-=0.6')
      .to(white, { scale: 1, duration: 0.45, ease: 'back.out(2)' }, '-=0.3')
      .to(gray, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.2')
      .to({}, { duration: 3 })
      .to([dark, light, circle, white, gray], { opacity: 0, duration: 0.6, ease: 'power2.in' })
      .set([dark, light, circle, white, gray], { opacity: 1 });
  }
  document.addEventListener('astro:page-load', () => { glance(); logo(); });
</script>

<style>
  .study { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .lead { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .crumbs a:hover { color: var(--fg); } .sep { opacity: 0.5; }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -0.04em; max-width: 18ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 52ch; }

  .body { display: grid; gap: clamp(72px, 10vw, 140px); margin-top: clamp(56px, 8vw, 112px); }
  .sec { display: grid; gap: clamp(22px, 3vw, 36px); justify-items: center; }
  .copy { display: grid; gap: 14px; justify-items: center; text-align: center; max-width: 760px; }
  .copy h2 { font-size: clamp(26px, 3vw, 40px); max-width: 22ch; }
  .copy p { color: var(--muted); font-size: clamp(15.5px, 1.25vw, 17px); line-height: 1.7; max-width: 62ch; }
  .wide { width: 100%; max-width: 1240px; margin: 0 auto; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .bd { --sweep: -60%; position: relative; overflow: hidden; padding: clamp(22px, 2.6vw, 30px); display: grid; gap: 10px; align-content: start; border-radius: 16px;
    border: 1px solid rgba(108,180,96,0.18); background: linear-gradient(160deg, #163012 0%, #0F2314 45%, #09150C 100%); box-shadow: inset 0 1px 0 rgba(169,224,160,0.10); }
  .bd::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 0%, rgba(169,224,160,0.14) 50%, transparent 100%); transform: translateX(var(--sweep)); }
  .bd .k { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #9CCD93; }
  .bd b { font-size: clamp(17px, 1.6vw, 20px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: #F2F8F0; }
  .bd .s { color: rgba(242,248,240,0.66); font-size: 13.5px; line-height: 1.5; }

  .rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .rules li { padding: 22px 24px; display: grid; gap: 8px; }
  .rules h3 { font-size: 18px; letter-spacing: -0.02em; }
  .rules p { color: var(--muted); font-size: 14.5px; line-height: 1.6; }
  .tiers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .tier { padding: 20px 22px; display: grid; gap: 12px; }
  .tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14.5px; color: var(--fg); }
  .tier li { display: flex; align-items: center; gap: 10px; }
  .tier li i { width: 7px; height: 7px; border-radius: 50%; background: #4C9C40; flex: none; }

  .dec { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(36px, 5vw, 64px); }
  .d { display: grid; gap: 22px; justify-items: center; }
  .dt { display: grid; gap: 10px; justify-items: center; text-align: center; max-width: 720px; }
  .dt h3 { font-size: clamp(20px, 2.2vw, 26px); letter-spacing: -0.02em; }
  .dt p { color: var(--muted); font-size: 15px; line-height: 1.65; }
  .shot { margin: 0; width: 100%; border: 1px solid var(--line-a); border-radius: 16px; overflow: hidden; background: #F5F6F5; }
  .shot :global(img) { width: 100%; height: auto; display: block; }

  .board { margin: 0; padding: 12px; }
  .art { aspect-ratio: 2400 / 1000; border-radius: 12px; background: #F5F6F5; display: grid; place-items: center; overflow: hidden; }
  .art :global(svg.lockup) { width: 48%; height: auto; overflow: visible; }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .swatches li { display: grid; gap: 4px; padding: 12px; border: 1px solid var(--line-a); border-radius: 12px; background: var(--surface); font-size: 13px; }
  .swatches i { height: 44px; border-radius: 8px; margin-bottom: 6px; }
  .swatches .mono { font-size: 10.5px; color: var(--dim); }
  .swatches .u { color: var(--muted); font-size: 12px; }

  /* closing panel: scope on the left, the next study on the right */
  .close { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); border: 1px solid rgba(108,180,96,0.18); border-radius: var(--r); overflow: hidden; background: linear-gradient(160deg, #0F2314 0%, var(--surface) 55%); }
  .close-l { padding: clamp(28px, 4vw, 48px); display: grid; gap: 14px; align-content: start; justify-items: start; }
  .close-l h2 { font-size: clamp(24px, 2.8vw, 34px); letter-spacing: -0.03em; }
  .close-l p { color: var(--muted); font-size: 15px; line-height: 1.65; max-width: 56ch; }
  .close-l .btn { margin-top: 8px; }
  .close-r { position: relative; padding: clamp(28px, 4vw, 48px); border-left: 1px solid var(--line-a); display: grid; gap: 10px; align-content: center; transition: background 0.25s; }
  .close-r:hover { background: rgba(235,238,245,0.03); }
  .close-r .t { font-size: clamp(20px, 2.4vw, 30px); font-weight: 600; letter-spacing: -0.03em; max-width: 16ch; }
  .close-r .o { font-size: 11px; color: var(--dim); letter-spacing: 0.08em; text-transform: uppercase; }
  .close-r .go { position: absolute; right: clamp(20px, 3vw, 32px); bottom: clamp(20px, 3vw, 32px); width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-a); display: grid; place-items: center; color: var(--fg); transition: transform 0.3s var(--ease), border-color 0.2s; }
  .close-r:hover .go { transform: translateX(4px); border-color: var(--accent); color: var(--accent); }

  @media (max-width: 860px) { .head, .rules, .tiers, .swatches, .close { grid-template-columns: 1fr; } .close-r { border-left: 0; border-top: 1px solid var(--line-a); } .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .cards { grid-template-columns: 1fr; } .art { aspect-ratio: 2400 / 1400; } .art :global(svg.lockup) { width: 76%; } }
</style>
