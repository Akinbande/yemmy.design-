---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Slider from '../../components/Slider.astro';
import NoteWall from '../../components/NoteWall.astro';
import lockupSvg from '../../../public/collga/collga-lockup.svg?raw';

const entry = (await getEntry('work', 'collga'))!;
const d = entry.data;
const all = (await getCollection('work', (e) => e.data.tier === 1)).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((e) => e.id === 'collga') + 1) % all.length];

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/collga/**/*.png', { eager: true });
const img = (name: string) => { const k = Object.keys(files).find((p) => p.endsWith(`/${name}.png`)); if (!k) throw new Error('missing ' + name); return files[k].default; };
const g = (names: [string, string][]) => names.map(([n, cap]) => ({ src: img(n), alt: cap, cap }));
const lockup = lockupSvg.replace('<svg ', '<svg class="lockup" ');

const tiers = [
  ['Federal', ['Life-Event Journeys', 'National ID and Consent Wallet'], ['Freedom of Information']],
  ['State', ['Internal Revenue Service', 'Public Procurement', "Governor's Delivery Dashboard"], ['Physical Planning', 'Social Investment Registry']],
  ['Local government', ['Citizen and Business Portal', 'Admin Control Panel', 'E-Services Catalogue', 'Land and Property Registry', 'Business Registry'], []],
  ['Platform', ['Assisted Digital and Inclusion', 'Design System'], ['Government Data Exchange']],
];
const decisions = [
  { t: 'Enter once, re-use with consent', p: "A fact is typed one time. Every step that needs it re-uses it, visibly, and each re-use is tied to a consent the citizen granted and can withdraw. The convenience and the control are one mechanism." },
  { t: 'Minimal disclosure you can see', img: 'id-1', alt: 'My credentials: six government-issued identities with their numbers masked, verified at source',
    p: "Credentials show their numbers masked by default, and an officer checking age is told over 18, never a date of birth. What was disclosed and what was withheld both sit on the screen. Privacy stops being a policy in a footer." },
  { t: 'One notice, two authorities', img: 'consolidated', alt: 'Consolidated demand notice assessing Ogun State taxes and Odeda LGA levies on one document',
    p: "The consolidated demand notice assesses state taxes and local levies together. A business pays once and each authority receives its share automatically. It ends the most common complaint of Nigerian businesses: being assessed separately, and repeatedly, for the same year." },
  { t: 'Claimed against verified', img: 'component/04-mda-scorecard-table', alt: 'Ministry scorecard comparing reported progress with what field officers measured',
    p: "What a ministry reports sits beside what a field officer measured on site, and ministries are scored on reporting accuracy as well as delivery. Designing for that gap, rather than assuming the returns are true, is what a delivery unit is for." },
  { t: 'Fairness engineered into the flow', img: 'public-evaluation', alt: 'Evaluation room with bidders anonymised A to E and computed financial scores',
    p: "Bids stay sealed until the public opening, bidders are anonymised A to E, financial scores are computed rather than typed, and the award button stays disabled until every evaluator has submitted. The integrity is in the interaction, not in a document." },
  { t: 'Assisted is not second-class', img: 'collections', alt: 'Field collection: agents on duty with a POS app issuing numbered receipts settled in real time',
    p: "Channel is the citizen's choice, never the service's. A receipt issued at a market stall by an agent on a POS device is the same receipt, with the same number, as one issued on the web." },
  { t: 'A tile cartogram, not a map', img: 'component/02-lga-cartogram', alt: 'Equal-area tile cartogram of local governments',
    p: "Delivery by local government uses equal-area tiles, so no LGA looks more important than another because of its land area." },
];
const swatches = [['#4C9C40', 'Collga Green', 'Primary actions, active nav, brand'], ['#6CB460', 'Leaf', 'Light half of the shield, hover'], ['#1E3F1A', 'Forest', 'Dark buttons, issued badges'], ['#F0913A', 'Civic Orange', 'Landing login, due status'], ['#1E88E5', 'Info Blue', 'Sent, under review'], ['#E53935', 'Danger Red', 'Unpaid, overdue, rejected'], ['#E0E8F0', 'Mist', 'Shield interior, neutral badges'], ['#F5F6F5', 'Ground', 'Page background']];
const comps: [string, string][] = [['component/02-system-card', 'System card'], ['component/03-credential-card', 'Credential card'], ['component/04-service-card', 'Service card'], ['component/05-stat-card', 'Stat card'], ['component/06-shield-choice-card', 'Shield choice card'], ['component/01-pillar-ring-card', 'Pillar ring card'], ['component/10-multi-party-signing', 'Multi-party signing'], ['component/04-mda-scorecard-table', 'Scorecard table'], ['component/02-lga-cartogram', 'LGA cartogram']];
---
<Base title={`${d.title} · Oluwayemi Akinbande`} ogTitle={d.title} description={d.summary}>
  <article class="study">
    <header class="wrap head">
      <div class="lead">
        <p class="mono crumbs" data-reveal><a href="/#work">Work</a><span class="sep">/</span><span>{d.org}</span></p>
        <h1 data-reveal data-reveal-delay="0.1">{d.title}</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">{d.summary}</p>
        <ul class="stats mono" data-reveal data-reveal-delay="0.3"><li><b>16</b>systems</li><li><b>21</b>services</li><li><b>5</b>languages</li><li><b>4</b>channels</li></ul>
      </div>
      <div data-reveal data-reveal-delay="0.25"><Facts d={d} /></div>
    </header>

    <div class="wrap body">
      <section id="start" class="sec">
        <p class="eyebrow accent" data-reveal>01 &middot; Where it started</p>
        <h2 data-reveal>A front door, a login, and a way to pay.</h2>
        <p data-reveal>Collga was pitched in 2020 as an e-government platform for Nigerian state and local governments, with Odeda Local Government in Ogun State as the pilot. The first screens were the ones a citizen meets first: the public landing page, One Login, and registration as a citizen or a business, verified against the LGA register.</p>
        <div data-reveal><Slider id="s-start" items={g([['landingpage', 'Landing page: one search box over the whole of government'], ['aut1', 'Let us get you started: e-citizens or e-business'], ['aut3', 'Citizen account, verified by LGA ID number'], ['aut2', 'Business account, verified by RC number'], ['aut5', 'Fetching the record from the LGA database'], ['aut4', 'When the ID or email does not match']])} /></div>
      </section>

      <section id="seam" class="sec">
        <p class="eyebrow accent" data-reveal>02 &middot; The seam</p>
        <h2 data-reveal>Government digital work fails between agencies, not on the screen.</h2>
        <p data-reveal>A citizen registering a birth deals with a hospital, a local government registry, a federal identity commission and a state health insurer. Four organisations, four forms, four queues, and the same details typed four times. Mapping that one journey is where the design started.</p>
        <NoteWall />
      </section>

      <section id="idea" class="sec">
        <p class="eyebrow accent" data-reveal>03 &middot; The idea</p>
        <h2 data-reveal>The unit of design is the journey across tiers of government, not the form.</h2>
        <p data-reveal>Four rules make crossing the seam safe. Almost everything distinctive in the platform comes from them.</p>
        <ul class="rules">
          {[['Enter data once', 'A fact is typed one time and re-used, visibly, by every step that needs it.'], ['Share only with consent', 'An agency must ask, stating the exact fields, the duration and the legal basis.'], ['Log every access', 'Every read is written to a log the citizen can open.'], ['Check claims against measurement', 'What an agency reports sits beside what someone measured on site.']].map(([t, p], i) => (
            <li class="panel" data-reveal data-reveal-delay={String(i * 0.07)}><span class="mono n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{p}</p></li>
          ))}
        </ul>
      </section>

      <section id="platform" class="sec">
        <p class="eyebrow accent" data-reveal>04 &middot; The platform</p>
        <h2 data-reveal>Sixteen systems, grouped by the tier that owns them.</h2>
        <p data-reveal>Twelve designed in depth, four scoped and deliberately left as outlines. An honest map is more useful than a flattering one.</p>
        <div class="tiers" data-reveal>
          {tiers.map(([name, built, planned]) => (
            <div class="tier panel">
              <span class="eyebrow">{name}</span>
              <ul>{(built as string[]).map((s) => <li><i class="ok"></i>{s}</li>)}{(planned as string[]).map((s) => <li class="pl"><i></i>{s}<span class="mono">scoped</span></li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <section id="decisions" class="sec">
        <p class="eyebrow accent" data-reveal>05 &middot; The decisions</p>
        <h2 data-reveal>Seven ideas I would defend in a review.</h2>
        <ol class="dec">
          {decisions.map((x, i) => (
            <li class={`d ${x.img ? '' : 'text'}`} data-reveal>
              <div class="dt"><span class="mono n">{String(i + 1).padStart(2, '0')}</span><h3>{x.t}</h3><p>{x.p}</p></div>
              {x.img && <figure class="df"><Image src={img(x.img)} alt={x.alt!} width={2400} format="webp" quality={82} loading="lazy" /></figure>}
            </li>
          ))}
        </ol>
      </section>

      <section id="modules" class="sec">
        <p class="eyebrow accent" data-reveal>06 &middot; Core modules</p>
        <h2 data-reveal>Both sides of the counter, and the tiers above it.</h2>

        <h3 class="mh" data-reveal>Citizen and Business Portal <span class="mono">local government</span></h3>
        <p data-reveal>Where residents and businesses of Odeda apply, pay levies and track applications. Twenty-one services in nine categories, a five-step wizard, a live status timeline, invoices, a three-step checkout and a document vault for what gets issued.</p>
        <div data-reveal><Slider id="s-citizen" items={g([['citizen1', 'Dashboard: wallet, outstanding invoices, applications, quick actions'], ['citizen2', 'E-Services inside the portal, by category'], ['e-service2', 'The public catalogue with filters and fees'], ['citizen3', 'Birth Certificate, step 1: applicant, pre-filled from the profile'], ['citizen4', 'Step 2: the form generated from the service definition'], ['citizen5', 'Application tracking with the reviewer note and progress'], ['documen-list', 'Documents: certificates, permits and receipts, verifiable'], ['payment1', 'Checkout: debit card, bank transfer or wallet'], ['payment2', 'Payments: the Collga wallet and every transaction']])} /></div>

        <h3 class="mh" data-reveal>Admin Control Panel <span class="mono">local government</span></h3>
        <p data-reveal>The other side of the same counter: a review queue with assignment and service-level tracking, approve, reject or request-information decisions, registries, revenue reporting, staff and roles.</p>
        <div data-reveal><Slider id="s-admin" items={g([['admin1', 'Admin Control Panel: revenue collected against invoiced, applications by status'], ['admin2', 'Applications queue with assignees, priority and status'], ['admin3', 'Business registry with permits and outstanding levies'], ['staff-role', 'Staff and roles across departments'], ['recvenue1', 'Revenue: collections, invoicing and channel performance'], ['revenue2', 'Revenue by service, by channel and by ward']])} /></div>

        <h3 class="mh" data-reveal>Internal Revenue Service <span class="mono">state</span></h3>
        <p data-reveal>A taxpayer registry, the consolidated demand notice that settles state and local authorities from one payment, field collection on POS devices with real-time settlement, and a revenue-assurance queue.</p>
        <div data-reveal><Slider id="s-state" items={g([['state-revenue', 'Ogun Internal Revenue Service: collected against target, by tax type and by LGA'], ['state-revenue-taxpayer', 'Taxpayers: every individual and business with a TIN'], ['consolidated', 'Consolidated demand notices: one notice, every authority'], ['collections', 'Field collection: agents on duty and end-of-day reconciliation']])} /></div>

        <h3 class="mh" data-reveal>Identity, Land and Procurement <span class="mono">federal and state</span></h3>
        <p data-reveal>Six verifiable credentials with consent requests that state their legal basis. A parcel map, a title record with its ownership chain, and a transfer signed in turn. Open tenders, sealed bids and a blind evaluation room.</p>
        <div data-reveal><Slider id="s-more" items={g([['id-1', 'My credentials: six identities, verified at source'], ['id-2', 'Consent requests: fields, duration and legal basis, allow or decline'], ['land1', 'Land and Property Registry: parcel map by registration status'], ['land-title2', 'Title record with the ownership chain and encumbrances'], ['id-request', 'Transfer: each party signs in turn through governor\'s consent'], ['public1', 'Public procurement: every tender published'], ['public-supply2', 'A sealed bid, encrypted until the public opening'], ['public-evaluation', 'Evaluation room: bidders anonymised, scores computed']])} /></div>
      </section>

      <section id="system" class="sec">
        <p class="eyebrow accent" data-reveal>07 &middot; Design system</p>
        <h2 data-reveal>One identity carrying sixteen systems.</h2>
        <figure class="panel board" id="logo-board" data-reveal>
          <div class="art" set:html={lockup} />
          <figcaption class="mono"><span class="n">The mark</span>Collga Green sampled from the shield, Montserrat for the interface, Roboto for authentication and long copy.</figcaption>
        </figure>
        <p data-reveal>One shell, a white sidebar, a floating top bar and cards on a pale ground, themed per system so sixteen products still feel like one government. 134 icons in one family at one weight, grouped by the six roles they play.</p>
        <ul class="swatches" data-reveal>
          {swatches.map(([hex, name, use]) => <li><i style={`background:${hex}`}></i><b>{name}</b><span class="mono">{hex}</span><span class="u">{use}</span></li>)}
        </ul>
        <div data-reveal><Slider id="s-sys" ratio="2272 / 1268" items={g([['01-buttons', 'Buttons: one primary per view, grey secondary, accent orange for the landing login only'], ['02-inputs', 'Inputs and validation'], ['03-selects-and-toggles', 'Selects, textarea and toggles'], ['04-status-badges', 'Status badges mapped to meaning'], ['05-alerts', 'Alerts'], ['06-stepper-timeline-pagination', 'Stepper, timeline and pagination']])} /></div>
        <p class="eyebrow" data-reveal>Components cropped from the product</p>
        <ul class="comps">
          {comps.map(([n, cap], i) => <li class="panel" data-reveal data-reveal-delay={String((i % 3) * 0.06)} style={`--i:${i}`}><Image src={img(n)} alt={cap} width={900} format="webp" quality={80} loading="lazy" /><span class="mono">{cap}</span></li>)}
        </ul>
        <figure class="panel film" data-reveal>
          <video src="/collga/collga-icon-system.mp4" autoplay muted loop playsinline aria-label="The icon system: 72 of the 134 icons, grouped by role, turning on a loop"></video>
          <figcaption class="mono"><span class="n">Icon system</span>72 of the 134 icons, grouped by role and colour.</figcaption>
        </figure>
      </section>

      <section id="scope" class="sec">
        <p class="eyebrow accent" data-reveal>08 &middot; Status and scope</p>
        <div class="panel scope" data-reveal>
          <p>Collga was a pitch, not a system in government service. It secured stakeholder interest and did not proceed to build. The data on every screen is invented but realistic, modelled on how Nigerian state and local government actually operate: LGA identification numbers, CAC registration, PAYE and tenement rates, governor's consent on land transfers, open-contracting rules. Where a decision is a judgement call rather than a fact, the screen says so.</p>
        </div>
      </section>
    </div>

    <nav class="wrap next" aria-label="Next case study">
      <a href={`/work/${next.id}/`} class="panel"><span class="eyebrow">Next</span><span class="t">{next.data.title}</span><span class="mono o">{next.data.org} &middot; {next.data.year}</span></a>
    </nav>
  </article>
</Base>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const board = document.getElementById('logo-board');
    const svg = board?.querySelector<SVGSVGElement>('svg.lockup');
    if (!board || !svg || board.dataset.init) return; board.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const q = (id: string) => svg.querySelector<SVGPathElement>('#' + id)!;
    const dark = q('dark-green'), light = q('light-green'), circle = q('circle'), white = q('circle-white'), gray = q('gray');
    const len = dark.getTotalLength();
    // the shield assembles, the wordmark is drawn then inked, the tagline settles; loops while on screen
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.2, scrollTrigger: { trigger: board, start: 'top 85%', end: 'bottom 10%', toggleActions: 'play pause resume pause' } });
    tl.set([circle, white], { scale: 0, transformOrigin: '50% 50%' })
      .set(light, { x: -90, opacity: 0 })
      .set(dark, { strokeDasharray: len, strokeDashoffset: len, fillOpacity: 0, stroke: '#4C9C40', strokeWidth: 3 })
      .set(gray, { opacity: 0, y: 12 })
      .to(light, { x: 0, opacity: 1, duration: 0.7, ease: 'power3.out' })
      .to(dark, { strokeDashoffset: 0, duration: 2.2, ease: 'power2.inOut' }, '-=0.3')
      .to(dark, { fillOpacity: 1, duration: 0.8, ease: 'power2.out' }, '-=0.9')
      .to(dark, { strokeWidth: 0, duration: 0.4 }, '-=0.3')
      .to(circle, { scale: 1, duration: 0.5, ease: 'back.out(2)' }, '-=0.6')
      .to(white, { scale: 1, duration: 0.45, ease: 'back.out(2)' }, '-=0.3')
      .to(gray, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.2')
      .to({}, { duration: 3 })
      .to([dark, light, circle, white, gray], { opacity: 0, duration: 0.6, ease: 'power2.in' })
      .set([dark, light, circle, white, gray], { opacity: 1 });
  }
  // the film: some browsers only honour muted autoplay once the element is on screen
  function film() {
    const v = document.querySelector<HTMLVideoElement>('.film video');
    if (!v || v.dataset.init) return; v.dataset.init = '1';
    new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }), { threshold: 0.2 }).observe(v);
  }
  document.addEventListener('astro:page-load', () => { init(); film(); });
</script>

<style>
  .study { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .lead { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .crumbs a:hover { color: var(--fg); } .sep { opacity: 0.5; }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -0.04em; max-width: 18ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 52ch; }
  .stats { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 26px; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .stats li { display: flex; align-items: baseline; gap: 8px; }
  .stats b { font-size: 20px; font-weight: 500; color: var(--fg); letter-spacing: -0.02em; }

  .body { display: grid; gap: clamp(64px, 9vw, 128px); margin-top: clamp(48px, 7vw, 96px); }
  .sec { display: grid; gap: 18px; max-width: 1100px; }
  .sec h2 { font-size: clamp(24px, 2.8vw, 36px); max-width: 24ch; }
  .sec > p { color: var(--muted); font-size: clamp(15.5px, 1.25vw, 17px); line-height: 1.7; max-width: 66ch; }
  .sec h3 { font-size: 18px; letter-spacing: -0.02em; }
  .mh { margin-top: 18px; display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .mh .mono { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }

  .rules { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .rules li { padding: 20px 22px; display: grid; gap: 8px; }
  .rules .n { font-size: 11px; color: var(--accent); letter-spacing: 0.1em; }
  .rules p { color: var(--muted); font-size: 14.5px; line-height: 1.6; }
  .tiers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .tier { padding: 18px 20px; display: grid; gap: 12px; }
  .tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14px; }
  .tier li { display: flex; align-items: center; gap: 10px; }
  .tier li i { width: 7px; height: 7px; border-radius: 50%; background: var(--dim); flex: none; }
  .tier li i.ok { background: var(--ok); }
  .tier .pl { color: var(--dim); }
  .tier .pl .mono { margin-left: auto; font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; }

  .dec { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .d { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 20px; align-items: start; border-top: 1px solid var(--line-a); padding-top: 22px; }
  .d.text { grid-template-columns: 1fr; }
  .dt { display: grid; gap: 10px; }
  .dt .n { font-size: 11px; color: var(--accent); letter-spacing: 0.1em; }
  .dt p { color: var(--muted); font-size: 14.5px; line-height: 1.65; max-width: 48ch; }
  .df { margin: 0; border: 1px solid var(--line-a); border-radius: 14px; overflow: hidden; background: #F5F6F5; }
  .df :global(img) { width: 100%; height: auto; display: block; }

  .board { margin: 0; padding: 12px; display: grid; gap: 12px; }
  .art { aspect-ratio: 2400 / 1557; border-radius: 10px; background: #F5F6F5; display: grid; place-items: center; overflow: hidden; }
  .art :global(svg.lockup) { width: 62%; height: auto; overflow: visible; }
  figcaption.mono, .board figcaption { display: flex; gap: 10px; align-items: baseline; font-size: 11px; letter-spacing: 0.06em; color: var(--muted); }
  figcaption .n { color: var(--accent); letter-spacing: 0.1em; }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .swatches li { display: grid; gap: 4px; padding: 12px; border: 1px solid var(--line-a); border-radius: 12px; background: var(--surface); font-size: 13px; }
  .swatches i { height: 44px; border-radius: 8px; margin-bottom: 6px; }
  .swatches .mono { font-size: 10.5px; color: var(--dim); }
  .swatches .u { color: var(--muted); font-size: 12px; }
  .comps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .comps li { padding: 12px; display: grid; gap: 10px; background: #F5F6F5; border-color: transparent; transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  .comps li:hover { transform: translateY(-4px) rotate(calc((var(--i) - 4) * 0.25deg)); box-shadow: 0 24px 50px rgba(0,0,0,0.45); }
  .comps :global(img) { width: 100%; height: auto; display: block; border-radius: 6px; }
  .comps .mono { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: #5A605B; }
  .film { margin: 0; padding: 12px; display: grid; gap: 12px; background: #F5F6F5; }
  .film video { width: 100%; height: auto; border-radius: 10px; display: block; }
  .film figcaption { color: #5A605B; }
  .film figcaption .n { color: #4C9C40; }
  .scope { padding: clamp(20px, 3vw, 28px); border-left: 3px solid var(--accent); border-radius: 0 12px 12px 0; }
  .scope p { color: var(--muted); font-size: 15px; line-height: 1.65; }

  .next { margin-top: clamp(56px, 8vw, 96px); }
  .next a { display: grid; gap: 8px; padding: 28px; transition: border-color 0.2s; }
  .next a:hover { border-color: rgba(235,238,245,0.22); }
  .next .t { font-size: clamp(20px, 2.2vw, 26px); font-weight: 600; letter-spacing: -0.02em; }
