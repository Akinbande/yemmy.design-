---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Stack from '../../components/Stack.astro';
import Marquee from '../../components/Marquee.astro';
import StickyBoard from '../../components/StickyBoard.astro';
import LucaIntro from '../../components/LucaIntro.astro';
import LedgerStream from '../../components/LedgerStream.astro';
import LucaLanding from '../../components/LucaLanding.astro';

const entry = (await getEntry('work', 'luca'))!;
const d = entry.data;
const all = (await getCollection('work', (e) => e.data.tier === 1)).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((e) => e.id === 'luca') + 1) % all.length];

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/luca/*.png', { eager: true });
const img = (name: string) => { const k = Object.keys(files).find((p) => p.endsWith(`/${name}.png`)); if (!k) throw new Error('missing ' + name); return files[k].default; };
const shots = (names: [string, string][]) => names.map(([n, alt]) => ({ src: img(n), alt }));

const breakdown = [
  { k: 'For', v: 'Small business owners', s: 'Micro and small businesses across Nigeria' },
  { k: 'Covers', v: 'Sales, expenses, debts and stock', s: 'All in one app' },
  { k: 'Platforms', v: 'Mobile app, web app and admin', s: 'Plus a landing page' },
  { k: 'Works', v: 'With little or no internet', s: 'Built to use very little data' },
  { k: 'My role', v: 'Product design lead', s: 'Research, UX flows, UI design and prototypes' },
  { k: 'Timeline', v: '2021 to 2022', s: 'UX flows mapped in 2021' },
];

// the board: the everyday bookkeeping of a small shop
const colors = { in: '#A9E0A0', out: '#FFC9CF', owe: '#F7E36A', stock: '#9FD3F5', wallet: '#D8CCFF' };
const notes: [string, string, string][] = [
  ['Record a sale at the counter', 'Sell', 'in'], ['Total sales today', 'Home', 'in'], ['Cash, transfer or POS', 'Payment', 'in'], ['Invoice #020921', 'Invoice', 'in'],
  ['Fully paid', 'Invoice', 'in'], ['Share a report as PDF or Excel', 'Reports', 'in'],
  ['Fuel refill, 5:10 PM', 'Pay out', 'out'], ['Buy new stock', 'Buy', 'out'], ['Market price against sell price', 'Product', 'out'], ['Profit and loss, worked out', 'Reports', 'out'],
  ['An expense nobody wrote down', 'Before Luca', 'out'],
  ['Mrs Adebayo owes ₦20,000', 'Customers', 'owe'], ['You owe Ayomide ₦10,000', 'Customers', 'owe'], ['Total due to you', 'Customers', 'owe'], ['Payment due 31 Aug', 'Invoice', 'owe'],
  ['Credit kept in memory', 'Before Luca', 'owe'], ['Search a customer', 'Customers', 'owe'],
  ['85 products', 'Products', 'stock'], ['Vintage bag, ₦20,000', 'Products', 'stock'], ['Edit a product', 'Products', 'stock'], ['Stock counted by eye', 'Before Luca', 'stock'],
  ['Upload a product photo', 'Products', 'stock'],
  ['Wallet balance ₦300,000', 'Wallet', 'wallet'], ['Deposit by bank transfer', 'Wallet', 'wallet'], ['Top up with a card', 'Wallet', 'wallet'], ['Create a PIN code', 'Onboarding', 'wallet'],
  ['Pay for electricity', 'Bills', 'wallet'], ['Prepaid or postpaid meter', 'Bills', 'wallet'],
];
const legend: [string, string][] = [['in', 'Money in'], ['out', 'Money out'], ['owe', 'Who owes whom'], ['stock', 'Stock'], ['wallet', 'Wallet and bills']];

const process = [
  ['Interviews and surveys', 'I spoke with business owners about how they keep their books today and where it goes wrong.'],
  ['UX flows', 'In 2021 I mapped every flow in Whimsical: sign-up and PIN, selling and buying, customers, stock, invoices and the wallet.'],
  ['Design and prototypes', 'I designed the app in Figma and turned the key flows into clickable prototypes.'],
  ['User testing', 'I tested each flow with business owners over several rounds.'],
];
const results = [['50%', 'more accurate records'], ['30%', 'less time spent on bookkeeping'], ['80%', 'of users kept using the app']];
---
<Base title={`${d.title} · Oluwayemi Akinbande`} ogTitle={d.title} description={d.summary}>
  <article class="study">
    <div class="atmos" aria-hidden="true"></div>
    <header class="wrap head">
      <div class="lead">
        <p class="mono crumbs" data-reveal><a href="/work/">Work</a><span class="sep">/</span><span>{d.org}</span></p>
        <h1 data-reveal data-reveal-delay="0.1">{d.title}</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">{d.summary}</p>
      </div>
      <div data-reveal data-reveal-delay="0.25"><Facts d={d} /></div>
    </header>

    <div class="wrap body">
      <section class="sec">
        <div class="wide"><LucaIntro /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal><h2>What was designed</h2></div>
        <ul class="cards wide" id="glance">
          {breakdown.map((b, i) => (
            <li class="bd" data-reveal data-reveal-delay={String((i % 3) * 0.08)}><span class="mono k">{b.k}</span><b>{b.v}</b><span class="s">{b.s}</span></li>
          ))}
        </ul>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>The home screen answers the first question</h2>
          <p>How much did I sell today? Total sales sit at the top. Sell and Buy are one tap away. Every payment in or out is listed with its time and method.</p>
        </div>
        <div class="wide"><Stack items={shots([
          ['l1', 'Home: total sales, Sell and Buy, and every transaction with its time and channel'],
          ['l2', 'Selling: the home screen, a sale with products and a customer, and the invoice it produces'],
          ['l3', 'Wallet: the balance, a bank transfer to fund it, and the ways to deposit'],
        ])} /></div>
        <div class="wide"><Marquee items={shots([
          ['l-customer', 'Customers: the total due to you, and who owes whom'],
          ['l-inventory', 'Products: the list, editing a product with its market and sell price, and deleting one'],
          ['electricity', 'Electricity: the form, choosing a provider, and choosing a meter type'],
        ])} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>A shop's books</h2>
          <p>Everything a small shop keeps track of: sales, expenses, debts, stock and bills.</p>
        </div>
        <div class="wide"><StickyBoard id="luca-board" label="A small shop's bookkeeping jobs, grouped by money in, money out, debts, stock, and wallet and bills"
          eyebrow="Everyday bookkeeping" sub="Twenty-eight everyday tasks Luca handles, from recording a sale to paying for electricity"
          notes={notes} legend={legend} colors={colors} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Six jobs, one app</h2>
          <p>Each of these jobs was slow or easy to get wrong on paper. Here is what Luca does instead.</p>
        </div>
        <div class="wide"><LedgerStream /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal><h2>How I got there</h2></div>
        <ul class="rules wide">
          {process.map(([t, p], i) => <li class="panel" data-reveal data-reveal-delay={String(i * 0.07)}><h3>{t}</h3><p>{p}</p></li>)}
        </ul>
      </section>

      <section class="sec">
        <div class="copy" data-reveal><h2>What changed</h2></div>
        <ul class="stats wide" data-reveal>
          {results.map(([n, l]) => <li><b>{n}</b><span>{l}</span></li>)}
        </ul>
        <p class="note mono" data-reveal>Figures from the original Luca case study.</p>
      </section>

      <section class="sec">
        <div class="wide"><LucaLanding /></div>
      </section>

      <section class="sec">
        <div class="close wide" data-reveal>
          <div class="close-l">
            <span class="eyebrow">Status</span>
            <h2>Live at luca.africa</h2>
            <p>Built for micro and small businesses across Nigeria, on the phone they already use.</p>
            <div class="acts">
              {d.link && <a class="btn btn-ghost" href={d.link} target="_blank" rel="noopener noreferrer">Visit luca.africa<span class="sr-only"> (opens in a new tab)</span>
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11 11 5M11 5H6.2M11 5v4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>}
              <a class="btn btn-ghost" href="/work/">All work
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <a class="close-r" href={`/work/${next.id}/`}>
            <span class="eyebrow">Next study</span>
            <span class="t">{next.data.title}</span>
            <span class="mono o">{next.data.org} &middot; {next.data.year}</span>
            <span class="go"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </section>
    </div>
  </article>
</Base>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // a slow light passes across each card, as on the Collga study
  function glance() {
    const el = document.getElementById('glance');
    if (!el || el.dataset.init) return; el.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.to(el.querySelectorAll('.bd'), { '--sweep': '220%', duration: 5, ease: 'none', repeat: -1, stagger: { each: 0.35, repeat: -1 },
      scrollTrigger: { trigger: el, start: 'top 90%', end: 'bottom 10%', toggleActions: 'play pause resume pause' } });
  }
  document.addEventListener('astro:page-load', glance);
</script>

<style>
  /* Luca's colours: navy (#1E1F4B) and blue (#01B5EC). No gradients on the product films or screens;
     the page itself carries the project colour, taken deep, like the other studies. */
  .study { position: relative; padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .atmos { position: absolute; left: 0; right: 0; top: 0; height: min(92vh, 900px); pointer-events: none; z-index: 0; overflow: hidden;
    background: linear-gradient(180deg, rgba(30, 31, 75, 0.5) 0%, rgba(30, 31, 75, 0.14) 45%, transparent 75%);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%); mask-image: linear-gradient(180deg, #000 55%, transparent 100%); }
  .atmos::before, .atmos::after { content: ''; position: absolute; border-radius: 50%; filter: blur(36px); will-change: transform; }
  .atmos::before { width: 72vw; height: 72vw; max-width: 1000px; max-height: 1000px; left: -16vw; top: -34vw; background: radial-gradient(circle, rgba(44, 46, 112, 1) 0%, rgba(30, 31, 75, 0.76) 38%, rgba(30, 31, 75, 0.22) 60%, transparent 72%); animation: driftA 22s ease-in-out infinite alternate; }
  .atmos::after { width: 48vw; height: 48vw; max-width: 660px; max-height: 660px; right: -10vw; top: -6vw; background: radial-gradient(circle, rgba(1, 181, 236, 0.22) 0%, rgba(1, 181, 236, 0.09) 45%, transparent 70%); animation: driftB 26s ease-in-out infinite alternate; }
  @keyframes driftA { from { transform: translate(0, 0); } to { transform: translate(6vw, 4vw); } }
  @keyframes driftB { from { transform: translate(0, 0); } to { transform: translate(-5vw, 5vw); } }
  @media (prefers-reduced-motion: reduce) { .atmos::before, .atmos::after { animation: none; } }
  .head, .body { position: relative; z-index: 1; }
  .head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .head :global(.facts) { border-color: rgba(1, 181, 236, 0.24); background: linear-gradient(180deg, rgba(30, 31, 75, 0.36), var(--surface) 60%); }
  .lead { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .crumbs a:hover { color: var(--fg); } .sep { opacity: 0.5; }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -0.04em; max-width: 18ch; }
  .sum { color: rgba(235,238,245,0.86); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 52ch; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(72px, 10vw, 140px); margin-top: clamp(48px, 7vw, 96px); }
  .sec { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 3vw, 36px); justify-items: center; min-width: 0; }
  .copy { display: grid; gap: 14px; justify-items: center; text-align: center; max-width: 760px; }
  .copy h2 { font-size: clamp(26px, 3vw, 40px); max-width: 22ch; }
  .copy p { color: var(--muted); font-size: clamp(15.5px, 1.25vw, 17px); line-height: 1.7; max-width: 56ch; }
  .wide { width: 100%; max-width: 1240px; margin: 0 auto; min-width: 0; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .bd { --sweep: -60%; position: relative; overflow: hidden; padding: clamp(22px, 2.6vw, 30px); display: grid; gap: 10px; align-content: start; border-radius: 16px;
    border: 1px solid rgba(1, 181, 236, 0.18); background: linear-gradient(160deg, #1E1F4B 0%, #17183C 45%, #0F102A 100%); box-shadow: inset 0 1px 0 rgba(127, 217, 245, 0.10); }
  .bd::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 0%, rgba(127, 217, 245, 0.13) 50%, transparent 100%); transform: translateX(var(--sweep)); }
  .bd .k { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #7FD9F5; }
  .bd b { font-size: clamp(17px, 1.6vw, 20px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: #FFFFFF; }
  .bd .s { color: rgba(255,255,255,0.68); font-size: 13.5px; line-height: 1.5; }

  .rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .rules li { padding: 22px 24px; display: grid; gap: 8px; }
  .rules h3 { font-size: 18px; letter-spacing: -0.02em; }
  .rules p { color: var(--muted); font-size: 14.5px; line-height: 1.6; }

  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line-a); border-radius: var(--r); background: var(--surface); overflow: hidden; }
  .stats li { display: grid; gap: 8px; padding: clamp(24px, 3vw, 36px); border-right: 1px solid var(--line-a); }
  .stats li:last-child { border-right: 0; }
  .stats b { font-size: clamp(40px, 5vw, 64px); font-weight: 600; letter-spacing: -0.04em; line-height: 1; color: #5ED0F3; }
  .stats span { color: var(--muted); font-size: 15px; }
  .note { font-size: 11px; letter-spacing: 0.06em; color: var(--dim); }

  .close { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); border: 1px solid rgba(1, 181, 236, 0.22); border-radius: var(--r); overflow: hidden; background: linear-gradient(160deg, #1B1C47 0%, var(--surface) 55%); }
  .close-l { padding: clamp(28px, 4vw, 48px); display: grid; gap: 14px; align-content: start; justify-items: start; }
  .close-l h2 { font-size: clamp(24px, 2.8vw, 34px); letter-spacing: -0.03em; }
  .close-l p { color: var(--muted); font-size: 15px; line-height: 1.65; max-width: 56ch; }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .close-r { position: relative; padding: clamp(28px, 4vw, 48px); border-left: 1px solid var(--line-a); display: grid; gap: 10px; align-content: center; transition: background 0.25s; }
  .close-r:hover { background: rgba(235,238,245,0.03); }
  .close-r .t { font-size: clamp(20px, 2.4vw, 30px); font-weight: 600; letter-spacing: -0.03em; max-width: 16ch; }
  .close-r .o { font-size: 11px; color: var(--dim); letter-spacing: 0.08em; text-transform: uppercase; }
  .close-r .go { position: absolute; right: clamp(20px, 3vw, 32px); bottom: clamp(20px, 3vw, 32px); width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-a); display: grid; place-items: center; color: var(--fg); transition: transform 0.3s var(--ease), border-color 0.2s; }
  .close-r:hover .go { transform: translateX(4px); border-color: #01B5EC; color: #01B5EC; }

  @media (max-width: 860px) {
    .head, .rules, .close { grid-template-columns: 1fr; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats { grid-template-columns: 1fr; }
    .stats li { border-right: 0; border-bottom: 1px solid var(--line-a); }
    .stats li:last-child { border-bottom: 0; }
    .close-r { border-left: 0; border-top: 1px solid var(--line-a); }
  }
  @media (max-width: 480px) { .cards { grid-template-columns: 1fr; } }
</style>
