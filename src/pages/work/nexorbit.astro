---
/* NexOrbit: the study is not written yet, so the page is deliberately short. One screen from the product and a plain
   note that the rest is coming. Same shell as the other case studies (header, facts, closing card) so it does not
   look like a different site, and the platform's orange behind the header. Nothing is claimed beyond early access. */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import NextStudy from '../../components/NextStudy.astro';
import rostering from '../../assets/nexorbit/rostering-hd.png';

const entry = (await getEntry('work', 'nexorbit'))!;
const d = entry.data;
const all = (await getCollection('work', (e) => e.data.tier === 1)).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((e) => e.id === 'nexorbit') + 1) % all.length];
---
<Base title={`${d.title} · Oluwayemi Akinbande`} ogTitle={d.title} description={d.summary}>
  <article class="study">
    <div class="atmos" aria-hidden="true"></div>
    <header class="wrap head">
      <div class="lead">
        <p class="mono crumbs" data-reveal><a href="/work/">Work</a><span class="sep">/</span><span>{d.org}</span></p>
        <h1 data-reveal data-reveal-delay="0.1">{d.title}</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">{d.summary}</p>
      </div>
      <div data-reveal data-reveal-delay="0.25"><Facts d={d} /></div>
    </header>

    <div class="wrap body">
      <section class="sec">
        {/* his 7200 wide export, served at the width each screen actually draws, so a 2x display still gets more pixels than it needs */}
        <figure class="shot wide" data-reveal>
          <Image src={rostering} alt="NexOrbit rostering: a week of shifts with their service type and support worker, and counts for total, allocated, unallocated and confirmed"
            widths={[1240, 1860, 2480, 3600]} sizes="(max-width: 1280px) 100vw, 1240px" format="webp" quality={88} loading="eager" />
        </figure>
      </section>

      <section class="sec">
        <div class="soon wide" data-reveal>
          <span class="eyebrow">Case study</span>
          <h2>Coming soon</h2>
          <p>NexOrbit is in early access and the full story is still being written: the service model behind it, the information architecture that holds participants, rostering, billing, compliance and training together, and what it changed for the teams using it.</p>
          {d.link && <a class="btn btn-ghost" href={d.link} target="_blank" rel="noopener noreferrer">Visit NexOrbit<span class="sr-only"> (opens in a new tab)</span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11 11 5M11 5H6.2M11 5v4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>}
        </div>
      </section>

      <section class="sec">
        <div class="close wide" data-reveal>
          <div class="close-l">
            <span class="eyebrow">Status</span>
            <h2>In early access</h2>
            <p>In early access with care providers in Australia. The full case study follows.</p>
            <a class="btn btn-ghost" href="/work/">All work
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <NextStudy entry={next} href={`/work/${next.id}/`} eyebrow="Next study" title={next.data.title}
            sub={`${next.data.org} · ${next.data.year}`} accent="#FF8A4C" />
        </div>
      </section>
    </div>
  </article>
</Base>

<style>
  .study { position: relative; padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  /* the platform's orange behind the header, gone before the screen */
  .atmos { position: absolute; left: 0; right: 0; top: 0; height: min(92vh, 900px); pointer-events: none; z-index: 0; overflow: hidden;
    background: linear-gradient(180deg, rgba(122,38,0,0.4) 0%, rgba(122,38,0,0.12) 46%, transparent 76%);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%); mask-image: linear-gradient(180deg, #000 55%, transparent 100%); }
  .atmos::before { content: ''; position: absolute; width: 72vw; height: 72vw; max-width: 1000px; max-height: 1000px; left: -16vw; top: -34vw; border-radius: 50%; filter: blur(38px);
    background: radial-gradient(circle, rgba(255,81,1,0.45) 0%, rgba(160,50,0,0.35) 40%, rgba(122,38,0,0.14) 62%, transparent 74%); animation: drift 22s ease-in-out infinite alternate; }
  @keyframes drift { from { transform: translate(0, 0); } to { transform: translate(6vw, 4vw); } }
  @media (prefers-reduced-motion: reduce) { .atmos::before { animation: none; } }

  .head, .body { position: relative; z-index: 1; }
  .head :global(.facts) { border-color: rgba(255,81,1,0.2); background: linear-gradient(180deg, rgba(122,38,0,0.28), var(--surface) 60%); }
  .head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .lead { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .crumbs a:hover { color: var(--fg); } .sep { opacity: 0.5; }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -0.04em; max-width: 18ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 54ch; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(56px, 8vw, 104px); margin-top: clamp(56px, 8vw, 112px); }
  .sec { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(18px, 2.4vw, 28px); justify-items: center; min-width: 0; }
  .wide { width: 100%; max-width: 1240px; margin: 0 auto; min-width: 0; }
  .shot { margin: 0; border: 1px solid var(--line-a); border-radius: 16px; overflow: hidden; background: #FFF6F2; aspect-ratio: 7200 / 4671; }
  .shot :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }

  /* the coming soon panel: a quiet card, the same family as the closing one */
  .soon { display: grid; gap: 14px; justify-items: center; text-align: center; padding: clamp(32px, 5vw, 56px); border-radius: var(--r);
    border: 1px solid rgba(255,81,1,0.18); background: linear-gradient(160deg, #23100A 0%, var(--surface) 55%); }
  .soon h2 { font-size: clamp(26px, 3vw, 38px); letter-spacing: -0.03em; }
  .soon p { color: var(--muted); font-size: clamp(15.5px, 1.25vw, 17px); line-height: 1.7; max-width: 60ch; }
  .soon .btn { margin-top: 6px; }

  .close { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); border: 1px solid rgba(255,81,1,0.18); border-radius: var(--r); overflow: hidden; background: linear-gradient(160deg, #23100A 0%, var(--surface) 55%); }
  .close-l { padding: clamp(28px, 4vw, 48px); display: grid; gap: 14px; align-content: start; justify-items: start; }
  .close-l h2 { font-size: clamp(24px, 2.8vw, 34px); letter-spacing: -0.03em; }
  .close-l p { color: var(--muted); font-size: 15px; line-height: 1.65; max-width: 56ch; }
  .close-l .btn { margin-top: 8px; }

  @media (max-width: 860px) { .head, .close { grid-template-columns: 1fr; } }
</style>
