---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph.astro';

export async function getStaticPaths() {
  const all = (await getCollection('work', (e) => e.data.tier <= 2)).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const label: Record<string, string> = { live: 'Live', 'early-access': 'Early access', shipped: 'Shipped', concept: 'Concept, not built' };
const host = d.link ? new URL(d.link).hostname.replace(/^www\./, '') : null;
const title = `${d.title} · Oluwayemi Akinbande`;
---
<Base title={title} ogTitle={d.title} description={d.summary}>
  <article class="study">

    <header class="wrap head">
      <div class="lead">
        <p class="mono crumbs" data-reveal><a href="/#work">Work</a><span class="sep">/</span><span>{d.org}</span></p>
        <h1 data-reveal data-reveal-delay="0.1">{d.title}</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">{d.summary}</p>
      </div>
      <dl class="panel facts" data-reveal data-reveal-delay="0.25">
        <div><dt>Client</dt><dd>{d.client ?? d.org}</dd></div>
        {d.industry.length > 0 && <div><dt>Industry</dt><dd>{d.industry.map((x) => <span>{x}</span>)}</dd></div>}
        {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        {d.services.length > 0 && <div><dt>Services</dt><dd>{d.services.map((x) => <span>{x}</span>)}</dd></div>}
        <div><dt>Timeline</dt><dd>{d.year}</dd></div>
        <div><dt>Status</dt><dd><span class="pill" data-status={d.status}>{label[d.status]}</span></dd></div>
        {d.link && host && <div><dt>Live</dt><dd><a class="live" href={d.link} target="_blank" rel="noopener noreferrer">{host}<span class="sr-only"> (opens in a new tab)</span> <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 11 11 5M11 5H6.2M11 5v4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></dd></div>}
      </dl>
    </header>

    <div class="wrap"><figure class="panel visual" data-reveal><Glyph kind={entry.id} /></figure></div>

    <div class="wrap"><div class="prose body"><Content /></div></div>

    <nav class="wrap next" aria-label="Next case study">
      <a href={`/work/${next.id}/`} class="panel">
        <span class="eyebrow">Next</span>
        <span class="t">{next.data.title}</span>
        <span class="mono o">{next.data.org} &middot; {next.data.year}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .study { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }

  /* header: title left, facts right */
  .head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .lead { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .crumbs a:hover { color: var(--fg); }
  .sep { opacity: 0.5; }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -0.04em; max-width: 18ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 52ch; }

  .facts { margin: 0; padding: 4px 0; }
  .facts > div { display: grid; grid-template-columns: 96px 1fr; gap: 16px; padding: 15px 22px; border-bottom: 1px solid var(--line-a); }
  .facts > div:last-child { border-bottom: 0; }
  dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); padding-top: 3px; }
  dd { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--fg); text-align: right; display: grid; gap: 3px; justify-items: end; }
  .live { color: var(--accent); display: inline-flex; align-items: center; gap: 4px; border-bottom: 1px solid var(--accent-line); }

  /* visual: full width */
  .visual { margin: clamp(36px, 5vw, 64px) 0; padding: clamp(24px, 4vw, 64px); background: linear-gradient(160deg, rgba(97,144,255,0.05), var(--surface) 60%); display: grid; place-items: center; }
  .visual :global(.glyph) { width: min(100%, 720px); height: auto; }

  /* body: one centred reading column, sections numbered in order */
  .body { margin: 0 auto; max-width: 720px; counter-reset: sec; }
  .body :global(h2) { position: relative; padding-top: 28px; border-top: 1px solid var(--line-a); }
  .body :global(h2)::before { counter-increment: sec; content: counter(sec, decimal-leading-zero); display: block; font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 10px; }

  .next { margin-top: clamp(56px, 8vw, 96px); }
  .next a { display: grid; gap: 8px; padding: 28px; max-width: 720px; margin: 0 auto; transition: border-color 0.2s; }
  .next a:hover { border-color: rgba(235,238,245,0.22); }
  .next .t { font-size: clamp(20px, 2.2vw, 26px); font-weight: 600; letter-spacing: -0.02em; }
  .next .o { font-size: 11px; color: var(--dim); letter-spacing: 0.08em; text-transform: uppercase; }

  @media (max-width: 860px) { .head { grid-template-columns: 1fr; } dd { text-align: left; justify-items: start; } }
</style>
