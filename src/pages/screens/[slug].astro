---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph.astro';
import Facts from '../../components/Facts.astro';

export async function getStaticPaths() {
  const all = (await getCollection('work', (e) => e.data.tier >= 2)).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}
const { entry, next } = Astro.props;
const d = entry.data;
const frames = d.gallery ?? [];
---
<Base title={`${d.org} · Oluwayemi Akinbande`} ogTitle={`${d.org}, in screens`} description={d.summary}>
  <article class="screens">
    <header class="wrap head">
      <div class="lead">
        <p class="mono crumbs" data-reveal><a href="/#more">Work</a><span class="sep">/</span><span>Screens</span></p>
        <h1 data-reveal data-reveal-delay="0.1">{d.org}</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">{d.summary}</p>
      </div>
      <div data-reveal data-reveal-delay="0.25"><Facts d={d} /></div>
    </header>

    <div class="wrap stack">
      {frames.length > 0 ? frames.map((f, i) => (
        <figure class="panel frame" data-reveal>
          <img src={f.src} alt={f.caption ?? `${d.org}, screen ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          {f.caption && <figcaption class="mono"><span class="n">{String(i + 1).padStart(2, '0')}</span>{f.caption}</figcaption>}
        </figure>
      )) : (
        <figure class="panel frame placeholder" data-reveal>
          <Glyph kind={entry.id} />
          <figcaption class="mono"><span class="n">01</span>Screens are being added.</figcaption>
        </figure>
      )}
    </div>

    <nav class="wrap next" aria-label="Next project">
      <a href={`/screens/${next.id}/`} class="panel">
        <span class="eyebrow">Next</span>
        <span class="t">{next.data.org}</span>
        <span class="mono o">{next.data.year} &middot; {next.data.tags[0]}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .screens { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .lead { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .crumbs a:hover { color: var(--fg); }
  .sep { opacity: 0.5; }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -0.04em; max-width: 18ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 52ch; }
  .stack { display: grid; gap: clamp(20px, 3vw, 36px); margin-top: clamp(36px, 5vw, 64px); }
  .frame { margin: 0; padding: clamp(14px, 2vw, 28px); background: linear-gradient(160deg, rgba(97,144,255,0.05), var(--surface) 60%); }
  .frame img { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line-a); display: block; }
  .placeholder { display: grid; place-items: center; padding: clamp(28px, 5vw, 72px); }
  .placeholder :global(.glyph) { width: min(100%, 640px); height: auto; }
  figcaption { display: flex; gap: 12px; align-items: baseline; margin-top: 14px; font-size: 11px; letter-spacing: 0.06em; color: var(--muted); }
  figcaption .n { color: var(--accent); letter-spacing: 0.1em; }
  .next { margin-top: clamp(48px, 7vw, 88px); }
  .next a { display: grid; gap: 8px; padding: 28px; transition: border-color 0.2s; }
  .next a:hover { border-color: rgba(235,238,245,0.22); }
  .next .t { font-size: clamp(20px, 2.2vw, 26px); font-weight: 600; letter-spacing: -0.02em; }
  .next .o { font-size: 11px; color: var(--dim); letter-spacing: 0.08em; text-transform: uppercase; }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; } }
</style>
