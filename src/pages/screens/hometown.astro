---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StickyBoard from '../../components/StickyBoard.astro';
import HometownMap from '../../components/HometownMap.astro';
import Facts from '../../components/Facts.astro';
import Stack from '../../components/Stack.astro';
import Marquee from '../../components/Marquee.astro';
import HometownIntro from '../../components/HometownIntro.astro';

const entry = (await getEntry('work', 'hometown'))!;
const d = entry.data;
const all = (await getCollection('work', (e) => e.data.tier >= 2)).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((e) => e.id === 'hometown') + 1) % all.length];

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/hometown/*.png', { eager: true });
const img = (name: string) => { const k = Object.keys(files).find((p) => p.endsWith(`/${name}.png`)); if (!k) throw new Error('missing ' + name); return files[k].default; };
const shots = (names: [string, string][]) => names.map(([n, alt]) => ({ src: img(n), alt }));

// what was designed: facts read from the screens, no story
const breakdown = [
  { k: 'Platforms', v: 'Mobile app and web app', s: 'Plus a landing page' },
  { k: 'Sign-up', v: 'Phone number and password', s: 'Identity checked with BVN or NIN' },
  { k: 'Money', v: 'Add money and send it', s: 'To any local bank, with saved beneficiaries' },
  { k: 'Bills', v: 'Airtime, data, electricity and TV', s: 'Paid from the app' },
  { k: 'Cards', v: 'Physical and virtual cards', s: 'Ordered and delivered in the app' },
  { k: 'Timeline', v: '2022 to 2023', s: 'Shipped' },
];

// the board: twenty-eight things a customer can do, each read from his screens
const colors = { join: '#FFD2B8', in: '#A9E0A0', out: '#FFC9CF', bills: '#F7E36A', cards: '#C7CBFF', grow: '#9FD3F5' };
const notes: [string, string, string][] = [
  ['Sign up with a phone number', 'Sign-up', 'join'], ['Confirm the number with a code', 'Sign-up', 'join'], ['6-digit password', 'Sign-in', 'join'], ['Sign in with a fingerprint', 'Sign-in', 'join'],
  ['Verify with BVN or NIN', 'Identity', 'join'], ['Prove where you live', 'Identity', 'join'], ['Passport, ID card or digital document', 'Identity', 'join'],
  ['Add money from a bank card', 'Add money', 'in'], ['Swipe to top up', 'Add money', 'in'], ['Copy account details', 'Account', 'in'], ['Create a payment link', 'Web app', 'in'],
  ['Free transfer to any local bank', 'Transfer', 'out'], ['Pick a saved beneficiary', 'Transfer', 'out'], ['Send by username', 'Pay', 'out'], ['4-digit transaction PIN', 'Security', 'out'], ['Share the receipt', 'Transfer', 'out'],
  ['Airtime and data from ₦100', 'Bills', 'bills'], ['Electricity', 'Bills', 'bills'], ['TV subscription', 'Bills', 'bills'], ['School fees', 'Bills', 'bills'],
  ['Physical card, 48-hour delivery', 'Cards', 'cards'], ['Virtual card', 'Cards', 'cards'], ['Card fees shown up front', 'Cards', 'cards'], ['Silver and Gold levels', 'Limits', 'cards'], ['Daily transaction limit', 'Limits', 'cards'],
  ['Savings plan, up to 15.5% a year', 'Savings', 'grow'], ['Loans', 'Loans', 'grow'], ['Account statement', 'Web app', 'grow'],
];
const legend: [string, string][] = [['join', 'Sign-up and identity'], ['in', 'Money in'], ['out', 'Money out'], ['bills', 'Bills'], ['cards', 'Cards and limits'], ['grow', 'Savings and loans']];

// the web app, each screen in a plain browser window
const webs: [string, string][] = [
  ['web-home', 'Web app home: the balance, savings, loans and recent transactions'],
  ['web-account', 'The account panel: add money, create a payment link, or download a statement'],
  ['web-payment', 'Payments: send to a bank account or by username'],
  ['web-payment-bank', 'Sending to a bank account: choose the bank and enter the account number'],
];
---
<Base title={`${d.org} · Oluwayemi Akinbande`} ogTitle={`${d.org}, in screens`} description={d.summary}>
  <article class="study">
    <div class="atmos" aria-hidden="true"></div>
    <header class="wrap head">
      <div class="lead">
        <p class="mono crumbs" data-reveal><a href="/work/">Work</a><span class="sep">/</span><span>Screens</span></p>
        <h1 data-reveal data-reveal-delay="0.1">{d.org}</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">{d.summary}</p>
      </div>
      <div data-reveal data-reveal-delay="0.25"><Facts d={d} /></div>
    </header>

    <div class="wrap body">
      <section class="sec">
        <div class="wide"><HometownIntro /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal><h2>What was designed</h2></div>
        <ul class="cards wide" id="ht-glance">
          {breakdown.map((b, i) => (
            <li class="bd" data-reveal data-reveal-delay={String((i % 3) * 0.08)}><span class="mono k">{b.k}</span><b>{b.v}</b><span class="s">{b.s}</span></li>
          ))}
        </ul>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>The problems I solved</h2>
          <p>Six stages of a customer's journey. For each one: the problem, what I designed, and the screen that does it.</p>
        </div>
        <div class="wide" data-reveal><HometownMap /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>The mobile app</h2>
          <p>Sign-up and identity checks, home, adding money, transfers, bills, cards and account levels.</p>
        </div>
        <div class="wide"><Stack items={shots([
          ['h1', 'Home: the account balance, the account number, and quick actions for money, bills, savings and loans'],
          ['h3', 'Adding money from a bank card: the amount, the confirmation and the transaction PIN'],
          ['h4', 'Sending money to a local bank, the success screen with a receipt, and an empty transaction history'],
        ])} /></div>
        <div class="wide"><Marquee items={shots([
          ['h2', 'Signing in with a phone number and password, checking the phone number with a code, and the start of identity verification'],
          ['h5', 'Pay: transfers and bill payments, then buying airtime and data'],
          ['h6', 'Cards: a physical or a virtual card, the card details and fees, and the delivery address'],
          ['h7', 'Profile, account limits by level, and the documents needed to move up a level'],
        ])} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>Everything a customer can do</h2>
          <p>From signing up to paying a bill, in one app.</p>
        </div>
        <div class="wide"><StickyBoard id="ht-board" label="Everything a Hometown customer can do, grouped by sign-up and identity, money in, money out, bills, cards and limits, and savings and loans"
          eyebrow="Everyday money" sub="Twenty-eight things Hometown lets people do, from signing up to paying for electricity"
          notes={notes} legend={legend} colors={colors} /></div>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>The web app</h2>
          <p>Balance, savings, loans and transactions on one home. Payments by bank account or by username.</p>
        </div>
        <ul class="webs wide">
          {webs.map(([n, alt], i) => (
            <li class="win" data-reveal data-reveal-delay={String((i % 2) * 0.08)}>
              <span class="wbar" aria-hidden="true"><i></i><i></i><i></i></span>
              <Image src={img(n)} alt={alt} width={2400} format="webp" quality={86} loading="lazy" />
            </li>
          ))}
        </ul>
      </section>

      <section class="sec">
        <div class="copy" data-reveal>
          <h2>The landing page</h2>
          <p>The public site: the first screen, the savings plan, and every product in one place.</p>
        </div>
        <div class="wide"><Stack items={shots([
          ['la1', 'Landing page, first screen: Payment designed for you, with buttons to open an account or get in touch'],
          ['la2', 'Landing page: the Hometown Savings plan'],
        ])} /></div>
        <div class="wide"><Stack ratio="4800 / 3834" items={shots([
          ['la3', 'Landing page: instant payments and loans in one place, and how Hometown protects you'],
        ])} /></div>
      </section>

      <section class="sec">
        <div class="close wide" data-reveal>
          <div class="close-l">
            <span class="eyebrow">Status</span>
            <h2>Shipped</h2>
            <p>Everyday banking made simple and safe, from the first sign-up to the last bill, on a phone and in a browser.</p>
            <div class="acts">
              <a class="btn btn-ghost" href="/work/">All work
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <a class="close-r" href={`/screens/${next.id}/`}>
            <span class="eyebrow">Next</span>
            <span class="t">{next.data.org}</span>
            <span class="mono o">{next.data.year} &middot; {next.data.tags[0]}</span>
            <span class="go"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </section>
    </div>
  </article>
</Base>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // a slow light passes across each card, as on the Luca and Collga studies
  function glance() {
    const el = document.getElementById('ht-glance');
    if (!el || el.dataset.init) return; el.dataset.init = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.to(el.querySelectorAll('.bd'), { '--sweep': '220%', duration: 5, ease: 'none', repeat: -1, stagger: { each: 0.35, repeat: -1 },
      scrollTrigger: { trigger: el, start: 'top 90%', end: 'bottom 10%', toggleActions: 'play pause resume pause' } });
  }
  document.addEventListener('astro:page-load', glance);
</script>

<style>
  /* Hometown's colours: navy (#000066) and orange (#FF6600). The page carries the navy, taken deep, with an orange light;
     the film and the mockups stay on his clean peach. */
  .study { position: relative; padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .atmos { position: absolute; left: 0; right: 0; top: 0; height: min(92vh, 900px); pointer-events: none; z-index: 0; overflow: hidden;
    background: linear-gradient(180deg, rgba(0, 0, 102, 0.46) 0%, rgba(0, 0, 102, 0.13) 45%, transparent 75%);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%); mask-image: linear-gradient(180deg, #000 55%, transparent 100%); }
  .atmos::before, .atmos::after { content: ''; position: absolute; border-radius: 50%; filter: blur(36px); will-change: transform; }
  .atmos::before { width: 72vw; height: 72vw; max-width: 1000px; max-height: 1000px; left: -16vw; top: -34vw; background: radial-gradient(circle, rgba(18, 18, 130, 1) 0%, rgba(0, 0, 102, 0.74) 38%, rgba(0, 0, 102, 0.22) 60%, transparent 72%); animation: driftA 22s ease-in-out infinite alternate; }
  .atmos::after { width: 48vw; height: 48vw; max-width: 660px; max-height: 660px; right: -10vw; top: -6vw; background: radial-gradient(circle, rgba(255, 102, 0, 0.2) 0%, rgba(255, 102, 0, 0.08) 45%, transparent 70%); animation: driftB 26s ease-in-out infinite alternate; }
  @keyframes driftA { from { transform: translate(0, 0); } to { transform: translate(6vw, 4vw); } }
  @keyframes driftB { from { transform: translate(0, 0); } to { transform: translate(-5vw, 5vw); } }
  @media (prefers-reduced-motion: reduce) { .atmos::before, .atmos::after { animation: none; } }
  .head, .body { position: relative; z-index: 1; }
  .head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .head :global(.facts) { border-color: rgba(255, 102, 0, 0.22); background: linear-gradient(180deg, rgba(0, 0, 102, 0.34), var(--surface) 60%); }
  .lead { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 10px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .crumbs a:hover { color: var(--fg); } .sep { opacity: 0.5; }
  h1 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -0.04em; max-width: 18ch; }
  .sum { color: var(--fg); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 52ch; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(72px, 10vw, 140px); margin-top: clamp(48px, 7vw, 96px); }
  .sec { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 3vw, 36px); justify-items: center; min-width: 0; }
  .copy { display: grid; gap: 14px; justify-items: center; text-align: center; max-width: 760px; }
  .copy h2 { font-size: clamp(26px, 3vw, 40px); max-width: 22ch; }
  .copy p { color: var(--muted); font-size: clamp(15.5px, 1.25vw, 17px); line-height: 1.7; max-width: 56ch; }
  .wide { width: 100%; max-width: 1240px; margin: 0 auto; min-width: 0; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .bd { --sweep: -60%; position: relative; overflow: hidden; padding: clamp(22px, 2.6vw, 30px); display: grid; gap: 10px; align-content: start; border-radius: 16px;
    border: 1px solid rgba(255, 102, 0, 0.18); background: linear-gradient(160deg, #0B0B52 0%, #080840 45%, #06062C 100%); box-shadow: inset 0 1px 0 rgba(255, 170, 110, 0.10); }
  .bd::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 0%, rgba(255, 150, 80, 0.11) 50%, transparent 100%); transform: translateX(var(--sweep)); }
  .bd .k { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #FF9A55; }
  .bd b { font-size: clamp(17px, 1.6vw, 20px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: #FFFFFF; }
  .bd .s { color: rgba(255, 255, 255, 0.68); font-size: 13.5px; line-height: 1.5; }

  /* the web app: four screens, each in a plain browser window with the film's 0.5px outline */
  .webs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 22px); }
  .win { border-radius: 14px; overflow: hidden; background: #fff; border: 0.5px solid rgba(255, 255, 255, 0.5); box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.6); }
  .wbar { display: flex; gap: 6px; padding: 10px 14px; background: #F6F3F1; border-bottom: 0.5px solid rgba(11, 11, 12, 0.12); }
  .wbar i { width: 8px; height: 8px; border-radius: 50%; background: #D9D4D0; }
  .win :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4320 / 3072; background: #FFFCFA; }

  .close { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); border: 1px solid rgba(255, 102, 0, 0.22); border-radius: var(--r); overflow: hidden; background: linear-gradient(160deg, #0A0A4C 0%, var(--surface) 55%); }
  .close-l { padding: clamp(28px, 4vw, 48px); display: grid; gap: 14px; align-content: start; justify-items: start; }
  .close-l h2 { font-size: clamp(24px, 2.8vw, 34px); letter-spacing: -0.03em; }
  .close-l p { color: var(--muted); font-size: 15px; line-height: 1.65; max-width: 56ch; }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .close-r { position: relative; padding: clamp(28px, 4vw, 48px); border-left: 1px solid var(--line-a); display: grid; gap: 10px; align-content: center; transition: background 0.25s; }
  .close-r:hover { background: rgba(235,238,245,0.03); }
  .close-r .t { font-size: clamp(20px, 2.4vw, 30px); font-weight: 600; letter-spacing: -0.03em; max-width: 16ch; }
  .close-r .o { font-size: 11px; color: var(--dim); letter-spacing: 0.08em; text-transform: uppercase; }
  .close-r .go { position: absolute; right: clamp(20px, 3vw, 32px); bottom: clamp(20px, 3vw, 32px); width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-a); display: grid; place-items: center; color: var(--fg); transition: transform 0.3s var(--ease), border-color 0.2s; }
  .close-r:hover .go { transform: translateX(4px); border-color: #FF6600; color: #FF6600; }

  @media (max-width: 860px) {
    .head, .close { grid-template-columns: 1fr; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .close-r { border-left: 0; border-top: 1px solid var(--line-a); }
  }
  @media (max-width: 760px) { .webs { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .cards { grid-template-columns: 1fr; } }
</style>
