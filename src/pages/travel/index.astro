---
import Base from '../../layouts/Base.astro';
---
<Base title="Travel · Oluwayemi Akinbande" description="Places I have worked from and visited, and what they taught me about designing for people who are not like me.">
  <section class="page wrap">
    <header class="head">
      <p class="eyebrow accent" data-reveal>Travel</p>
      <h1 data-reveal data-reveal-delay="0.1">Working from more than one place.</h1>
      <p class="lede" data-reveal data-reveal-delay="0.2">Lagos to Calgary, with clients in Melbourne. Designing for people whose context is not your own starts with going to where they are. Photographs and notes from the road are being added.</p>
    </header>
    <div class="panel empty" data-reveal>
      <span class="eyebrow">Being added</span>
      <p>Photographs and short notes from Nigeria, Canada and Australia, in the order they happened.</p>
    </div>
  </section>
</Base>
<style>
  .page { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .head { display: grid; gap: 16px; margin-bottom: clamp(32px, 5vw, 56px); }
  h1 { font-size: clamp(34px, 5vw, 64px); letter-spacing: -0.04em; max-width: 14ch; }
  .lede { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); max-width: 54ch; line-height: 1.6; }
  .empty { padding: clamp(24px, 3vw, 36px); display: grid; gap: 10px; max-width: 640px; }
  .empty p { color: var(--muted); font-size: 15px; line-height: 1.6; }
</style>
