---
import Base from '../../layouts/Base.astro';
/* Slots for the photographs. No places or years are shown until he sends the photos and says where and when each
   was taken; each slot then becomes { src, alt, place, year }. */
const slots = ['wide', 'tall', 'sq', 'sq', 'tall', 'wide', 'sq', 'sq'].map((size) => ({ size }));
---
<Base title="Travel · Oluwayemi Akinbande" description="Places I have worked from and visited.">
  <section class="page wrap">
    <header class="head">
      <p class="eyebrow accent" data-reveal>Travel</p>
      <h1 data-reveal data-reveal-delay="0.1">Places I've lived and worked.</h1>
      <p class="lede" data-reveal data-reveal-delay="0.2">Photos from the places I have lived, worked and visited. Coming soon.</p>
    </header>

    <ul class="grid">
      {slots.map((s, i) => (
        <li class={`slot ${s.size}`} data-reveal data-reveal-delay={String((i % 4) * 0.06)}>
          <figure class="panel ph">
            <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
            <figcaption class="mono cap"><span>Photo coming soon</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .head { display: grid; gap: 16px; margin-bottom: clamp(32px, 5vw, 56px); }
  h1 { font-size: clamp(34px, 5vw, 64px); letter-spacing: -0.04em; max-width: 14ch; }
  .lede { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); max-width: 54ch; line-height: 1.6; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 16vw, 220px); grid-auto-flow: dense; gap: 12px; }
  .slot.wide { grid-column: span 2; }
  .slot.tall { grid-row: span 2; }
  .ph { position: relative; margin: 0; height: 100%; padding: 16px; display: flex; flex-direction: column; justify-content: space-between; background: linear-gradient(160deg, rgba(97,144,255,0.05), var(--surface) 60%); overflow: hidden; }
  .ph::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, transparent 0 14px, rgba(235,238,245,0.025) 14px 15px); pointer-events: none; }
  .idx { font-size: 11px; color: var(--dim); letter-spacing: 0.1em; }
  .cap { display: flex; justify-content: space-between; gap: 12px; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 860px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: clamp(140px, 30vw, 200px); } }
  @media (max-width: 480px) { .slot.wide { grid-column: span 2; } }
</style>
