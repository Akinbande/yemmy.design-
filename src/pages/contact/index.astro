---
/* Get in touch: a full page, and where every Get in touch link on the site goes.
   The heading, availability and email first; then the form card, which ends in "How this works": a small service
   blueprint of getting in touch (your part: choose a reason, add your details, send; my part: I reply, we talk) that
   follows the visitor through the form, lighting each step as it is done. Beside it, cards for the ways to reach me
   (with my local time, live), what I am open to and what I bring. Light touches of interaction: a soft spotlight
   follows the pointer over each panel, the cards lift on hover, and the light behind the heading drifts. On phones
   the form comes first. */
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { social } from '../../config';
const EMAIL = 'hello@yemmy.design';
// the same words as the About page, so the two pages never disagree
const bring: [string, string][] = [
  ['Service design', 'Service blueprints, journey mapping, research and usability testing'],
  ['Information architecture', 'Enterprise platforms, case management, operations and admin systems'],
  ['Design systems', 'Design tokens, component libraries and interaction standards'],
  ['Accessibility', 'WCAG 2.2 AA as a build constraint, not a final pass'],
];
// the journey: the visitor's three steps, then mine
const steps = [
  { t: 'Choose a reason', d: 'What brings you here', lane: 'You' },
  { t: 'Add your details', d: 'Only what I need to reply' },
  { t: 'Send it', d: 'It comes straight to me' },
  { t: 'I reply', d: 'By email', lane: 'Me' },
  { t: 'We talk', d: "A call, if it's a fit" },
];
---
<Base title="Get in touch · Oluwayemi Akinbande" description="Hiring for a role, planning a project, redesigning a product, or making an introduction. Tell me what you have in mind.">
  <article class="contact">
    <header class="wrap head">
      <p class="mono crumbs" data-reveal>Get in touch</p>
      <h1 data-reveal data-reveal-delay="0.08">Let's work together.</h1>
      <p class="sum" data-reveal data-reveal-delay="0.16">Hiring for a role, planning a project, redesigning a product, or making an introduction. Tell me what you have in mind, and I'll take it from there.</p>
      <p class="direct" data-reveal data-reveal-delay="0.22">
        <span class="open"><i aria-hidden="true"></i>Open to work</span>
        <span>Prefer email? <a href={`mailto:${EMAIL}`}>{EMAIL}</a></span>
      </p>
    </header>

    <div class="wrap body">
      <section class="panel formbox spot" aria-label="Contact form" data-reveal data-reveal-delay="0.1">
        <ContactForm />

        <div class="journey" id="journey" data-step="0">
          <div class="jr-head">
            <h2 class="t">How this works</h2>
            <p class="jr-now" data-jr-now>Choose a reason to begin.</p>
          </div>
          <div class="lanes" aria-hidden="true"><span class="lane l-you mono">Your part</span><span class="lane l-me mono">My part</span></div>
          <ol class="jr">
            <li class="jr-track" aria-hidden="true"><i class="jr-fill"></i><i class="jr-spark"></i></li>
            {steps.map((s, i) => (
              <li class="st" style={`--i:${i}`}>
                {s.lane && <span class="lt mono" aria-hidden="true">{s.lane === 'You' ? 'Your part' : 'My part'}</span>}
                <span class="node" aria-hidden="true">
                  <span class="mono no">{i + 1}</span>
                  <svg class="ck" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.2 4.2L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="st-t"><b>{s.t}</b><span>{s.d}</span></span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <aside class="side" aria-label="Other ways to reach me">
        <div class="panel card spot" data-reveal data-reveal-delay="0.16">
          <h2 class="t">Reach me directly</h2>
          <dl class="ways">
            <div><dt>Email</dt><dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a><button type="button" class="copy" data-copy={EMAIL}>Copy</button></dd></div>
            <div><dt>LinkedIn</dt><dd><a href={social.linkedin} target="_blank" rel="noopener noreferrer">akinoluwayemi<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
            <div><dt>Based in</dt><dd>Calgary, Alberta, Canada</dd></div>
            <div><dt>Local time</dt><dd class="clock" data-clock data-state="off"><i class="cdot" aria-hidden="true"></i><span data-t>Mountain Time (MT)</span><span class="mono cs" data-s></span></dd></div>
          </dl>
        </div>
        <div class="panel card spot" data-reveal data-reveal-delay="0.2">
          <h2 class="t">Open to</h2>
          <p>Senior Service and UX Design roles, and freelance or contract engagements.</p>
        </div>
        <div class="panel card spot" data-reveal data-reveal-delay="0.24">
          <h2 class="t">What I bring</h2>
          <dl class="caps">{bring.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        </div>
      </aside>
    </div>
  </article>
</Base>

<script>
  let ctl: AbortController | null = null;
  let clockTimer = 0;
  const NOW = ['Choose a reason to begin.', 'Add your details.', 'Ready to send.', "Sent. I'll reply by email."];
  function init() {
    ctl?.abort(); ctl = new AbortController();
    clearInterval(clockTimer);
    if (!document.querySelector('.contact')) return;
    const { signal } = ctl;
    // a soft light follows the pointer over each panel
    if (matchMedia('(hover: hover)').matches) {
      document.querySelectorAll<HTMLElement>('.contact .spot').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        }, { signal });
      });
    }

    // How this works: follows the form. Step 1 is done once a reason is chosen, step 2 once every required answer
    // is filled in, step 3 once the message is sent; then my part is next
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const jr = document.getElementById('journey');
    if (form && jr) {
      const now = jr.querySelector<HTMLElement>('[data-jr-now]')!;
      const sts = [...jr.querySelectorAll<HTMLElement>('.st')];
      let sent = false, viaMail = false;
      const detailsOk = () => [...form.querySelectorAll<HTMLInputElement>('input[required], textarea[required], select[required]')]
        .filter((el) => el.name !== 'intent' && !el.disabled && !el.closest('[hidden]'))
        .every((el) => el.validity.valid);
      const update = () => {
        const intent = !!form.querySelector('input[name="intent"]:checked');
        const step = !intent ? 0 : !detailsOk() ? 1 : !sent || viaMail ? 2 : 3;
        jr.dataset.step = String(step);
        jr.style.setProperty('--p', String(step / (sts.length - 1)));
        sts.forEach((s, i) => { s.classList.toggle('done', i < step); s.classList.toggle('now', i === step); });
        now.textContent = sent && viaMail ? 'Press send in your email app to finish.' : NOW[step];
      };
      form.addEventListener('input', update, { signal });
      form.addEventListener('change', update, { signal });
      form.addEventListener('cf:sent', (e) => { sent = true; viaMail = !!(e as CustomEvent).detail?.viaMail; update(); }, { signal });
      form.addEventListener('cf:reset', () => { sent = false; viaMail = false; update(); }, { signal });
      update();
    }

    // my local time, live: the time in Mountain Time, and whether it is inside working hours (weekdays, 9 to 5)
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    if (clock) {
      const time = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Edmonton', hour: '2-digit', minute: '2-digit', hour12: false });
      const day = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Edmonton', weekday: 'short' });
      const tick = () => {
        const d = new Date(), t = time.format(d), h = +t.slice(0, 2);
        const working = !['Sat', 'Sun'].includes(day.format(d)) && h >= 9 && h < 17;
        clock.querySelector('[data-t]')!.textContent = `${t} MT`;
        clock.querySelector('[data-s]')!.textContent = working ? 'Working hours' : 'Outside working hours';
        clock.dataset.state = working ? 'on' : 'off';
      };
      tick();
      clockTimer = window.setInterval(tick, 30000);
    }
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .contact { position: relative; padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  /* a faint light of the site's accent behind the heading, drifting slowly */
  .contact::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 560px; pointer-events: none;
    background: radial-gradient(55% 80% at 18% 0%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 70%);
    animation: c-glow 16s ease-in-out infinite alternate; }
  @keyframes c-glow { from { transform: translate3d(-4%, 0, 0); opacity: 0.85; } to { transform: translate3d(8%, 3%, 0); opacity: 1; } }
  .head, .body { position: relative; }
  .head { display: grid; gap: 16px; }
  .crumbs { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
  h1 { font-size: clamp(38px, 5.4vw, 68px); letter-spacing: -0.045em; max-width: 16ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.35vw, 18.5px); line-height: 1.6; max-width: 56ch; }
  .direct { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 4px; font-size: 14.5px; color: var(--muted); }
  .direct a { color: var(--fg); border-bottom: 1px solid var(--line); transition: border-color 0.2s; }
  .direct a:hover { border-color: var(--fg); }
  .open { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line-a); background: rgba(235, 238, 245, 0.03);
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg); }
  .open i { position: relative; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
  .open i::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--ok); animation: c-pulse 2.2s ease-out infinite; }
  @keyframes c-pulse { from { transform: scale(0.4); opacity: 0.9; } to { transform: scale(1.6); opacity: 0; } }

  .body { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.8fr); gap: clamp(20px, 3vw, 36px); align-items: start; margin-top: clamp(36px, 5vw, 64px); }
  .formbox { padding: clamp(22px, 3.2vw, 40px); }
  .side { display: grid; gap: 14px; position: sticky; top: calc(var(--nav-h) + 24px); }

  /* the spotlight: a soft light under the content, where the pointer is; the lift uses translate, not transform,
     so it never fights the scroll reveal */
  .spot { position: relative; isolation: isolate; transition: border-color 0.3s, translate 0.4s var(--ease); }
  .spot::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; border-radius: inherit; opacity: 0; transition: opacity 0.35s;
    background: radial-gradient(460px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 10%, transparent), transparent 62%); }
  .spot:hover::after { opacity: 1; }
  .spot:hover { border-color: rgba(235, 238, 245, 0.18); }

  /* the side cards: each lifts a little on hover */
  .card { padding: 20px 22px; display: grid; gap: 12px; }
  .card:hover { translate: 0 -2px; }
  .t { font-size: 15.5px; letter-spacing: -0.01em; }
  .card p { color: var(--muted); font-size: 14px; line-height: 1.6; }
  .ways, .caps { margin: 0; display: grid; gap: 10px; }
  .ways > div { display: grid; grid-template-columns: 80px 1fr; gap: 12px; align-items: center; }
  .ways dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
  .ways dd { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 14px; min-width: 0; }
  .ways dd a { border-bottom: 1px solid var(--line); overflow-wrap: anywhere; transition: border-color 0.2s; }
  .ways dd a:hover { border-color: var(--fg); }
  .clock .cdot { width: 7px; height: 7px; border-radius: 50%; background: var(--dim); }
  .clock[data-state='on'] .cdot { background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent); }
  .cs { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--dim); }
  .caps > div { display: grid; gap: 3px; }
  .caps dt { font-size: 14px; font-weight: 500; color: var(--fg); }
  .caps dd { margin: 0; font-size: 13px; line-height: 1.5; color: var(--muted); }
  .copy { background: none; border: 1px solid var(--line-a); color: var(--muted); border-radius: 999px; font: 500 12px/1 var(--sans); padding: 7px 12px; cursor: pointer; min-height: 32px; transition: color 0.2s, border-color 0.2s; }
  .copy:hover { color: var(--fg); border-color: rgba(235, 238, 245, 0.22); }

  /* How this works: a small blueprint at the foot of the form card. Two lanes over one line of five steps; the line
     fills to the current step, a light runs ahead of it to the next one, and each step turns into a tick when done */
  .journey { --p: 0; margin-top: clamp(28px, 3.4vw, 40px); padding-top: clamp(24px, 3vw, 32px); border-top: 1px solid var(--line-a); display: grid; gap: 18px; }
  .jr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; }
  .jr-now { font-size: 13.5px; color: var(--muted); }
  .journey[data-step='3'] .jr-now { color: var(--ok); }
  .lanes { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .lane { position: relative; display: block; text-align: center; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); padding-bottom: 10px; }
  .lane::after { content: ''; position: absolute; left: 10%; right: 10%; bottom: 0; height: 5px; border: 1px solid var(--line-a); border-bottom: 0; border-radius: 3px 3px 0 0; }
  .l-you { grid-column: 1 / 4; } .l-me { grid-column: 4 / 6; }
  .journey[data-step='3'] .l-me, .journey:not([data-step='3']) .l-you { color: var(--fg); }
  .jr { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .jr-track { position: absolute; left: 10%; right: 10%; top: 15px; height: 2px; border-radius: 2px; background: var(--line-a); }
  .jr-fill { position: absolute; inset: 0; border-radius: inherit; transform-origin: 0 50%; transform: scaleX(var(--p)); transition: transform 0.7s var(--ease);
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 55%, transparent), var(--accent)); }
  /* the light running ahead: it spans the one segment between the current step and the next */
  .jr-spark { position: absolute; top: -1px; height: 4px; left: calc(var(--p) * 100%); width: 25%; transition: left 0.7s var(--ease); pointer-events: none;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 85%, #fff), transparent) no-repeat; background-size: 40% 100%;
    filter: drop-shadow(0 0 4px var(--accent)); animation: jr-run 2.4s ease-in-out infinite; }
  .journey[data-step='4'] .jr-spark, .journey[data-step='3'] .jr-spark { width: 25%; }
  @keyframes jr-run { from { background-position: -70% 0; } to { background-position: 170% 0; } }
  .st { position: relative; display: grid; justify-items: center; gap: 12px; text-align: center; padding: 0 4px; animation: jr-in 0.6s var(--ease) both; animation-delay: calc(var(--i) * 80ms + 300ms); }
  @keyframes jr-in { from { opacity: 0; transform: translateY(8px); } }
  .lt { display: none; }
  .node { position: relative; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--surface); border: 1px solid var(--line);
    color: var(--dim); transition: background 0.35s, border-color 0.35s, color 0.35s, box-shadow 0.35s; }
  .node > * { grid-area: 1 / 1; transition: opacity 0.25s, transform 0.35s var(--ease); }
  .no { font-size: 11px; }
  .ck { opacity: 0; transform: scale(0.4); }
  .st-t { display: grid; gap: 3px; }
  .st-t b { font-size: 13.5px; font-weight: 500; color: var(--muted); transition: color 0.3s; }
  .st-t span { font-size: 12.5px; line-height: 1.45; color: var(--dim); }
  /* the current step: lit, with a soft ring breathing around it */
  .st.now .node { border-color: var(--accent); color: var(--fg); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent); }
  .st.now .node::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--accent); animation: c-pulse 2.2s ease-out infinite; }
  .st.now b, .st.done b { color: var(--fg); }
  /* a finished step: filled, the number gives way to a tick */
  .st.done .node { background: var(--accent); border-color: var(--accent); color: #fff; animation: jr-pop 0.4s var(--ease); }
  .st.done .no { opacity: 0; transform: scale(0.4); }
  .st.done .ck { opacity: 1; transform: none; }
  @keyframes jr-pop { 0% { transform: scale(0.8); } 60% { transform: scale(1.12); } 100% { transform: scale(1); } }

  /* tablets: the cards sit in two columns under the form; phones: one column */
  @media (max-width: 960px) { .body { grid-template-columns: 1fr; } .side { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* phones: the journey runs down the card, the line on the left, each lane named where it starts */
  @media (max-width: 620px) {
    .side { grid-template-columns: 1fr; }
    .lanes { display: none; }
    .jr { grid-template-columns: 1fr; gap: 18px; }
    .jr-track { left: 15px; right: auto; top: 16px; bottom: 16px; width: 2px; height: auto; }
    .jr-fill { transform-origin: 50% 0; transform: scaleY(var(--p)); }
    .jr-spark { display: none; }
    .st { grid-template-columns: 32px 1fr; justify-items: start; align-items: center; gap: 4px 14px; text-align: left; padding: 0; }
    .lt { display: block; grid-column: 2; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
    .st:nth-child(5) { margin-top: 8px; }
  }
  /* very narrow screens: each label sits above its value, so the email never breaks mid-word */
  @media (max-width: 400px) { .ways > div { grid-template-columns: 1fr; gap: 4px; } .ways dd a { overflow-wrap: normal; } }
  @media (prefers-reduced-motion: reduce) {
    .contact::before, .open i::after, .st.now .node::after, .jr-spark, .st, .st.done .node { animation: none; }
    .card:hover { translate: none; }
  }
</style>
