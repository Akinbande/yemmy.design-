---
import Base from '../layouts/Base.astro';
import SystemScene from '../components/SystemScene.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Approach from '../components/Approach.astro';
import MoreWork from '../components/MoreWork.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
---
<Base>
  <SystemScene />
  <div id="scene-range" class="above">
    <Hero />
    <ProofStrip />
    <FeaturedWork />
  </div>
  <div class="above solid">
    <Approach />
    <MoreWork />
    <section class="section" aria-labelledby="home-tm-h"><div class="wrap"><Testimonials headingId="home-tm-h" /></div></section>
    <About />
  </div>
</Base>
<style>
  .above { position: relative; z-index: 1; }
  .solid { background: var(--ink); }
</style>
