---
/* Writing: one section. Nothing is published yet, so the page says what is coming (four topics, his words:
   Design, Engineering, Job hack, Scale up) beside a line drawing of an iPad. On it a notes app drafts each topic in
   turn: the topic lights up, a working title types out in real words, the lines fill in behind an Apple Pencil.
   When posts exist they list under the topics in the same column. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('writing', (e) => !e.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });

const topics = [
  { name: 'Design', draft: 'Map the service first', line: 'Service design, journey maps and design systems, taken from real projects.' },
  { name: 'Engineering', draft: 'From Figma to front end', line: 'How I build what I design, from components to front ends that ship.' },
  { name: 'Job hack', draft: 'A portfolio that gets calls', line: 'What works when you apply for design roles: portfolio, CV and interviews.' },
  { name: 'Scale up', draft: 'From first client to steady work', line: 'Growing a product and a practice, from the first client to a steady business.' },
];

// under each draft title, the paragraph lines: widths as a share of the text column, 0 is a paragraph break
const lines = [1, 0.94, 0.97, 0.62, 0, 1, 0.9, 0.46];
---
<Base title="Writing · Oluwayemi Akinbande" description="Writing by Oluwayemi Akinbande, coming soon: design, engineering, job hacks and scaling up.">
  <section class="desk wrap">
    <div class="copy">
      <p class="status mono" data-reveal><span class="dot" aria-hidden="true"></span>Writing · coming soon</p>
      <h1 data-reveal data-reveal-delay="0.08">Content from my desk, coming up.</h1>
      <p class="lede" data-reveal data-reveal-delay="0.16">I'm writing down what I have learned designing and building digital services. The first pieces cover four topics.</p>

      <ol class="topics">
        {topics.map((t, i) => (
          <li class="topic" data-reveal data-reveal-delay={String(0.22 + i * 0.06)}>
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{t.name}</span>
            <span class="line">{t.line}</span>
          </li>
        ))}
      </ol>

      {posts.length > 0 && (
        <ol class="posts">
          {posts.map((p) => (
            <li>
              <a class="post" href={`/writing/${p.id}/`}>
                <span class="mono date">{fmt.format(p.data.date)}</span>
                <span class="t">{p.data.title}</span>
                <span class="s">{p.data.summary}</span>
              </a>
            </li>
          ))}
        </ol>
      )}

      <p class="ask" data-reveal data-reveal-delay="0.5">Is there a topic you want me to cover first? <a href="/contact/">Tell me<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5l7-7M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
    </div>

    <figure class="art" data-reveal data-reveal-delay="0.12">
      <svg class="tablet" viewBox="0 0 640 500" role="img" aria-label="Line drawing of an iPad with a notes app drafting the four topics, and an Apple Pencil" data-drafts={JSON.stringify(topics.map((t) => t.draft))}>
        <defs>
          <radialGradient id="lamp" cx="50%" cy="46%" r="55%">
            <stop offset="0" stop-color="#6190FF" stop-opacity="0.18" />
            <stop offset="1" stop-color="#6190FF" stop-opacity="0" />
          </radialGradient>
          <clipPath id="screen"><rect x="64" y="84" width="512" height="332" rx="14" /></clipPath>
        </defs>

        <ellipse cx="320" cy="250" rx="330" ry="235" fill="url(#lamp)" />

        <!-- the iPad in landscape, camera on the long edge -->
        <rect class="btn" x="470" y="55" width="44" height="6" rx="3" />
        <rect class="body" x="40" y="60" width="560" height="380" rx="34" />
        <rect class="bezel" x="52" y="72" width="536" height="356" rx="24" />
        <circle class="cam" cx="320" cy="66" r="2.4" />

        <g clip-path="url(#screen)">
          <rect class="screen" x="64" y="84" width="512" height="332" />

          <!-- sidebar: the four topics -->
          <rect class="side" x="64" y="84" width="150" height="332" />
          <path class="rule" d="M214 84 V416" />
          <text class="label" x="84" y="116">DRAFTS</text>
          {topics.map((t, i) => (
            <g class="row" data-row={i}>
              <rect class="row-bg" x="74" y={132 + i * 40} width="130" height="30" rx="8" />
              <circle class="row-dot" cx="91" cy={147 + i * 40} r="3.5" />
              <text class="row-name" x="103" y={151.5 + i * 40}>{t.name}</text>
            </g>
          ))}

          <!-- editor -->
          <text class="label" x="238" y="116" data-no>DRAFT 01</text>
          <g class="pill"><rect x="466" y="101" width="90" height="22" rx="11" /><circle cx="480" cy="112" r="3" /><text x="490" y="115.5">IN DRAFT</text></g>
          <g data-page>
            <text class="title" x="238" y="160" data-title></text>
            <rect class="caret" x="238" y="144" width="2" height="21" rx="1" data-caret />
            <text class="label faint" x="238" y="186" data-topic>DESIGN</text>
            {lines.map((w, i) => w > 0 && (
              <rect class="bar" x="238" y={206 + i * 18} width={Math.round(318 * w)} height="7" rx="3.5" data-bar data-w={Math.round(318 * w)} />
            ))}
            <g class="figure" data-figure>
              <rect x="238" y="370" width="150" height="32" rx="6" />
              <path d="M250 392 L266 382 L278 388 L292 377 L312 391" />
              <rect class="fig-blue" x="398" y="370" width="72" height="32" rx="6" />
            </g>
          </g>
        </g>

        <!-- Apple Pencil: its tip sits at the origin; the script moves it to where the draft is being written -->
        <g class="pencil" data-pencil transform="translate(470 250)">
          <g transform="rotate(36)">
            <path class="p-body" d="M-6 -30 L-6 -196 Q-6 -202 0 -202 Q6 -202 6 -196 L6 -30 Z" />
            <path class="p-tip" d="M-6 -30 L-1.2 -3 Q0 0 1.2 -3 L6 -30 Z" />
            <path class="p-flat" d="M3 -176 V-56" />
          </g>
        </g>
      </svg>
    </figure>
  </section>
</Base>

<style>
  .desk {
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + clamp(32px, 6vw, 72px));
    padding-bottom: clamp(56px, 8vw, 104px);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 80px); align-items: center;
  }
  .copy { display: grid; gap: 20px; align-content: center; }

  .status { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--accent); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: pulse 2.4s var(--ease) infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(97,144,255,0.5); } 70%, 100% { box-shadow: 0 0 0 9px rgba(97,144,255,0); } }

  h1 { font-size: clamp(38px, 5.4vw, 72px); letter-spacing: -0.045em; line-height: 1; max-width: 13ch; }
  .lede { color: var(--muted); font-size: clamp(16px, 1.35vw, 18.5px); line-height: 1.6; max-width: 46ch; }

  .topics { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .topic {
    display: grid; grid-template-columns: auto 1fr; column-gap: 12px; row-gap: 6px; align-content: start;
    padding: 18px 18px 20px; border: 1px solid var(--line-a); border-radius: 14px;
    background: linear-gradient(180deg, rgba(235,238,245,0.035), rgba(235,238,245,0.01));
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease), translate 0.25s var(--ease);
  }
  .topic:hover { border-color: var(--accent-line); background: var(--accent-soft); translate: 0 -2px; }
  .n { font-size: 11px; color: var(--accent); letter-spacing: 0.06em; padding-top: 5px; }
  .name { font-size: 19px; font-weight: 600; letter-spacing: -0.02em; }
  .line { grid-column: 2; color: var(--muted); font-size: 14px; line-height: 1.5; }

  .ask { color: var(--muted); font-size: 15px; margin-top: 4px; }
  .ask a { display: inline-flex; align-items: center; gap: 5px; color: var(--accent); border-bottom: 1px solid var(--accent-line); transition: border-color 0.2s; }
  .ask a:hover { border-color: var(--accent); }

  .posts { list-style: none; margin: 8px 0 0; padding: 0; border-top: 1px solid var(--line-a); }
  .post { display: grid; gap: 6px; padding: 20px 4px; border-bottom: 1px solid var(--line-a); transition: background 0.2s; }
  .post:hover { background: rgba(235,238,245,0.03); }
  .date { font-size: 11px; color: var(--dim); letter-spacing: 0.08em; text-transform: uppercase; }
  .t { font-size: clamp(18px, 2vw, 22px); font-weight: 600; letter-spacing: -0.02em; }
  .s { color: var(--muted); font-size: 15px; }

  /* the drawing: a line-drawn iPad on the dark ground, one blue accent */
  .art { margin: 0; position: relative; }
  .tablet { width: 100%; height: auto; overflow: visible; font-family: var(--sans); }
  .body { fill: #0E1016; stroke: rgba(235,238,245,0.75); stroke-width: 1.5; }
  .bezel { fill: #07080B; stroke: rgba(235,238,245,0.1); stroke-width: 1; }
  .cam { fill: rgba(235,238,245,0.35); }
  .btn { fill: #0E1016; stroke: rgba(235,238,245,0.55); stroke-width: 1.2; }
  .screen { fill: #14161C; }
  .side { fill: #101217; }
  .rule { stroke: rgba(235,238,245,0.08); stroke-width: 1; }
  .label { font-family: var(--mono); font-size: 9.5px; letter-spacing: 1.4px; fill: rgba(235,238,245,0.5); }
  .label.faint { fill: #6190FF; opacity: 0.8; }
  .row-bg { fill: transparent; transition: fill 0.4s ease; }
  .row-dot { fill: rgba(235,238,245,0.22); transition: fill 0.4s ease; }
  .row-name { font-size: 13px; fill: rgba(235,238,245,0.55); transition: fill 0.4s ease; }
  .row.on .row-bg { fill: rgba(97,144,255,0.15); }
  .row.on .row-dot { fill: #6190FF; }
  .row.on .row-name { fill: #EBEEF5; font-weight: 600; }
  .pill rect { fill: rgba(97,144,255,0.12); }
  .pill circle { fill: #6190FF; }
  .pill text { font-family: var(--mono); font-size: 9.5px; letter-spacing: 1.2px; text-transform: none; fill: #8FB0FF; }
  .title { font-size: 17px; font-weight: 700; letter-spacing: -0.3px; fill: #EBEEF5; }
  .caret { fill: #6190FF; }
  .bar { fill: rgba(235,238,245,0.17); }
  .figure rect, .figure path { fill: none; stroke: rgba(235,238,245,0.3); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .figure .fig-blue { fill: rgba(97,144,255,0.16); stroke: rgba(97,144,255,0.6); }
  .pencil { filter: drop-shadow(0 12px 14px rgba(0,0,0,0.5)); }
  .p-body { fill: #ECEEF3; stroke: rgba(11,12,16,0.3); stroke-width: 1; }
  .p-tip { fill: #BFC4CE; stroke: rgba(11,12,16,0.3); stroke-width: 1; }
  .p-flat { stroke: rgba(11,12,16,0.1); stroke-width: 2.5; stroke-linecap: round; }

  @media (max-width: 960px) {
    .desk { grid-template-columns: 1fr; min-height: 0; align-items: start; }
    .art { order: -1; max-width: 560px; width: 100%; justify-self: center; }
    h1 { max-width: 14ch; }
  }
  @media (max-width: 560px) {
    .topics { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
</style>

<script>
  // The iPad drafts each topic in turn: the topic lights up, its title types out with a caret, the paragraph lines
  // grow under the Pencil tip, a small figure appears, it holds, the page clears and the next topic begins.
  // Runs only while the drawing is on screen; reduced motion shows the first draft finished.
  function init() {
    const svg = document.querySelector<SVGSVGElement>('.desk .tablet');
    if (!svg || (svg as any).__run) return;
    (svg as any).__run = true;
    const drafts: string[] = JSON.parse(svg.dataset.drafts || '[]');
    const names = Array.from(svg.querySelectorAll<SVGTextElement>('.row-name')).map((t) => t.textContent!.toUpperCase());
    const rows = Array.from(svg.querySelectorAll<SVGGElement>('[data-row]'));
    const page = svg.querySelector<SVGGElement>('[data-page]')!;
    const title = svg.querySelector<SVGTextElement>('[data-title]')!;
    const caret = svg.querySelector<SVGRectElement>('[data-caret]')!;
    const no = svg.querySelector<SVGTextElement>('[data-no]')!;
    const topic = svg.querySelector<SVGTextElement>('[data-topic]')!;
    const bars = Array.from(svg.querySelectorAll<SVGRectElement>('[data-bar]'));
    const figure = svg.querySelector<SVGGElement>('[data-figure]')!;
    const pencil = svg.querySelector<SVGGElement>('[data-pencil]')!;

    const X = 238, REST = 0.7, TYPE = 0.06, BAR = 0.45, FIG = 0.5, HOLD = 1.8, CLEAR = 0.45;
    const len = (i: number) => REST + drafts[i].length * TYPE + bars.length * BAR + FIG + HOLD + CLEAR;
    const starts: number[] = [];
    let total = 0;
    drafts.forEach((_, i) => { starts.push(total); total += len(i); });
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (v: number) => 1 - Math.pow(1 - clamp(v), 3);
    let px = 470, py = 250, lastI = -1;

    function render(clock: number, snap = false) {
      let i = starts.length - 1;
      while (i > 0 && clock < starts[i]) i--;
      const t = clock - starts[i], d = drafts[i];
      if (i !== lastI) {
        lastI = i;
        rows.forEach((r, k) => r.classList.toggle('on', k === i));
        no.textContent = `DRAFT 0${i + 1}`;
        topic.textContent = names[i];
      }

      const n = Math.max(0, Math.min(d.length, Math.floor((t - REST) / TYPE) + 1));
      title.textContent = t < REST ? '' : d.slice(0, n);
      const tw = t < REST ? 0 : title.getComputedTextLength();
      const typing = t >= REST && n < d.length;
      const tb = t - REST - d.length * TYPE;            // time since the title finished
      caret.setAttribute('x', String(X + tw + 2));
      caret.style.opacity = tb < 0 ? '1' : tb < 0.6 ? String(Math.floor(clock * 3) % 2) : '0';

      // pencil target: behind the caret while typing, then the growing line's end, then resting by the figure
      let tx = X + tw + 8, ty = 158;
      bars.forEach((b, k) => {
        const f = ease((tb - k * BAR) / BAR);
        b.setAttribute('width', String(Number(b.dataset.w) * (tb < 0 ? 0 : f)));
        if (tb >= k * BAR && tb < (k + 1) * BAR) { tx = X + Number(b.dataset.w) * f; ty = Number(b.getAttribute('y')) + 4; }
      });
      const tf = tb - bars.length * BAR;
      figure.style.opacity = String(ease(tf / FIG));
      if (tf >= 0) { tx = 500; ty = 330; }
      page.style.opacity = String(1 - ease((t - (len(i) - CLEAR)) / CLEAR));

      const k = snap ? 1 : 0.14;
      px += (tx - px) * k; py += (ty - py) * k;
      const lift = typing ? Math.sin(clock * 28) * 1.2 : tf >= 0 ? -6 : 0;
      pencil.setAttribute('transform', `translate(${px.toFixed(1)} ${(py + lift).toFixed(1)})`);
    }

    (svg as any).__seek = (sec: number) => { render(((sec % total) + total) % total, true); return total; };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { render(len(0) - CLEAR - 0.1, true); return; }
    render(0, true);

    let clock = 0, last = 0, raf = 0, on = false;
    function frame(now: number) {
      const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
      last = now;
      clock = (clock + dt) % total;
      render(clock);
      if (on) raf = requestAnimationFrame(frame);
    }
    const io = new IntersectionObserver(([e]) => {
      on = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (on) { last = 0; raf = requestAnimationFrame(frame); }
    }, { threshold: 0.15 });
    io.observe(svg);
    document.addEventListener('astro:before-swap', () => { on = false; cancelAnimationFrame(raf); io.disconnect(); }, { once: true });
  }
  document.addEventListener('astro:page-load', init);
</script>
