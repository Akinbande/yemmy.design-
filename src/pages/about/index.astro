---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';

const timeline = [
  { when: '2025 to 2026', org: 'NexOrbit and OrbitForm', role: 'Lead product designer', what: 'An NDIS operations platform and its form builder for government-funded care providers: participants, rostering, billing, compliance and compliant intake.' },
  { when: '2024 to now', org: 'Newdawn Support Services, Melbourne', role: 'Senior web designer', what: 'Design system, interaction standards and the public site for a disability support provider, working remotely into Australia.' },
  { when: '2024 to now', org: 'YTL Technologies', role: 'Founder and lead product designer', what: 'A small studio building SaaS and ERP-integrated platforms, moving freelance clients into structured engagements.' },
  { when: '2024 to 2025', org: 'Menaget', role: 'Senior product designer', what: 'End-to-end design for web and mobile fintech: payment flows, transaction dashboards, financial data screens. The design work supported a $150,000 MVP raise.' },
  { when: '2021 to 2023', org: 'Menaget', role: 'Product designer', what: 'Research, usability testing, component libraries and prototypes for progressive web and hybrid mobile apps.' },
  { when: '2020', org: 'Newage Solution, Lagos', role: 'UI and UX designer', what: 'A self-service portal, a learning management system and a real estate platform.' },
];
const principles = [
  { t: 'Service before screen', d: 'The journey, the staff process and the policy come first. The interface is the last thing designed, not the first.' },
  { t: 'Decisions over deliverables', d: 'A wireframe is evidence, not the work. The work is the call made under a constraint, and why.' },
  { t: 'Compliance is a design material', d: 'Audit trails, eligibility rules and reporting obligations shape the product. Designing around them produces things that fail inspection.' },
  { t: 'Stay through to production', d: 'The spec and the shipped product should be the same thing. I stay until they are.' },
];
const capabilities = [
  ['Service design', 'Service blueprints, journey mapping, service models, research and usability testing'],
  ['Information architecture', 'Enterprise platforms, case management, operations and admin systems'],
  ['Design systems', 'Design tokens, component libraries, interaction standards, design governance'],
  ['Accessibility', 'WCAG 2.2 AA as a build constraint, not a final pass'],
  ['Prototyping and build', 'Figma, Framer, and production front-end so the handoff is the product'],
];
---
<Base title="About · Oluwayemi Akinbande" description="Senior Service & UX Designer in Calgary, Alberta. Seven years across fintech, healthcare, energy and SaaS, specialising in government-funded, regulated and citizen-facing services.">
  <article class="about">
    <header class="wrap head">
      <div class="lead">
        <p class="eyebrow accent" data-reveal>About</p>
        <h1 data-reveal data-reveal-delay="0.1">Regulated services are where design earns its keep.</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">Senior Service &amp; UX Designer in Calgary, Alberta. Seven years across fintech, healthcare, energy and SaaS, and a specialism in services that are government-funded, regulated, or used by the public.</p>
      </div>
      <div class="pic" data-reveal data-reveal-delay="0.3">
        <span class="ring"><Image src={portrait} alt="Oluwayemi Akinbande" width={480} height={480} format="webp" quality={82} /></span>
      </div>
    </header>

    <section class="wrap story" aria-labelledby="story-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">Story</p><h2 id="story-h">Lagos to Calgary, by way of the back office.</h2></div></div>
      <div class="cols">
        <p data-reveal>I started in Lagos in 2020 designing the unglamorous parts of software: a self-service portal, a learning management system, a real estate platform. The pattern was already there. The interesting problems were never on the screen; they were in the process behind it, the rules it had to obey, and the staff who had to run it.</p>
        <p data-reveal data-reveal-delay="0.1">Four years at Menaget took that into fintech, where a payment flow is only as good as the trust it earns and a dashboard is only as good as the decision it supports. In 2024 I founded a small studio, moved to Calgary, and began working remotely into Australia's disability sector, where every form is a compliance document and every roster is a promise to a participant.</p>
        <p data-reveal data-reveal-delay="0.2">That is the work I do now: services that are funded by government, bound by regulation, or used by the public, designed from the service model down to production code.</p>
      </div>
    </section>

    <section class="wrap" aria-labelledby="exp-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">Experience</p><h2 id="exp-h">Where the seven years went.</h2></div></div>
      <ol class="timeline">
        {timeline.map((x, i) => (
          <li class="panel row" data-reveal data-reveal-delay={String(i * 0.06)}>
            <span class="mono when">{x.when}</span>
            <div class="body"><h3>{x.org}</h3><p class="role mono">{x.role}</p><p class="what">{x.what}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap" aria-labelledby="pr-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">How I work</p><h2 id="pr-h">Four things I hold to.</h2></div></div>
      <ul class="principles">
        {principles.map((p, i) => (
          <li class="panel" data-reveal data-reveal-delay={String(i * 0.08)}>
            <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.t}</h3><p>{p.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap" aria-labelledby="cap-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">Capabilities</p><h2 id="cap-h">What I bring to a team.</h2></div></div>
      <dl class="panel caps" data-reveal>
        {capabilities.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section class="wrap" aria-labelledby="av-h">
      <div class="avail-grid">
        <div class="panel card avail" data-reveal>
          <span class="open"><i class="dot" aria-hidden="true"></i>Open to work</span>
          <h2 id="av-h">Senior Service &amp; UX Design roles.</h2>
          <p class="also">Freelance or contract engagements.</p>
          <div class="cta">
            <a class="btn btn-primary" href="mailto:hello@yemmy.design">hello@yemmy.design</a>
            <a class="btn btn-ghost" href="https://www.linkedin.com/in/akinoluwayemi/" target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
        <dl class="panel card facts" data-reveal data-reveal-delay="0.12">
          <div><dt>Based</dt><dd>Calgary, Alberta, Canada</dd></div>
          <div><dt>Sectors</dt><dd>Government-funded care, digital government, healthcare, fintech, energy, SaaS</dd></div>
          <div><dt>Standards</dt><dd>WCAG 2.2 AA, design tokens, component libraries, design governance</dd></div>
        </dl>
      </div>
    </section>
  </article>
</Base>

<style>
  .about { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .about > section { padding-top: clamp(64px, 9vw, 120px); }
  .head { display: grid; grid-template-columns: minmax(0, 1.3fr) auto; gap: clamp(28px, 5vw, 72px); align-items: end; }
  .lead { display: grid; gap: 18px; }
  h1 { font-size: clamp(34px, 4.8vw, 62px); letter-spacing: -0.04em; max-width: 16ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 54ch; }
  .pic { display: grid; justify-items: end; }
  .ring { position: relative; display: block; width: clamp(150px, 18vw, 240px); aspect-ratio: 1; border-radius: 50%; padding: 6px; background: var(--ink); }
  .ring::before { content: ''; position: absolute; inset: 0; border-radius: 50%; padding: 1.5px; background: conic-gradient(from 210deg, transparent 0 60%, var(--accent) 88%, transparent 100%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
  .ring :global(img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; box-shadow: 0 24px 60px rgba(0,0,0,0.6); }

  .story .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .story p { color: var(--muted); font-size: 15.5px; line-height: 1.7; }

  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .row { display: grid; grid-template-columns: 150px 1fr; gap: 24px; padding: clamp(20px, 2.4vw, 28px); }
  .when { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); padding-top: 4px; }
  .body { display: grid; gap: 6px; }
  .body h3 { font-size: 18px; letter-spacing: -0.02em; }
  .role { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .what { color: var(--muted); font-size: 14.5px; line-height: 1.6; max-width: 64ch; }

  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .principles li { padding: clamp(22px, 2.6vw, 30px); display: grid; gap: 10px; }
  .principles .n { font-size: 11px; color: var(--accent); letter-spacing: 0.1em; }
  .principles h3 { font-size: 19px; letter-spacing: -0.02em; }
  .principles p { color: var(--muted); font-size: 14.5px; line-height: 1.6; }

  .caps { margin: 0; padding: 4px 0; }
  .caps > div { display: grid; grid-template-columns: 220px 1fr; gap: 16px; padding: 18px 24px; border-bottom: 1px solid var(--line-a); }
  .caps > div:last-child { border-bottom: 0; }
  .caps dt { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .caps dd { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; }

  .avail-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 14px; }
  .card { padding: clamp(24px, 3vw, 36px); }
  .avail { display: grid; gap: 12px; align-content: start; border-color: rgba(61,214,140,0.22); background: linear-gradient(160deg, rgba(61,214,140,0.06), var(--surface) 55%); }
  .open { display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ok); }
  .dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  .dot::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--ok); animation: ring 2.2s ease-out infinite; }
  @keyframes ring { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(1.6); opacity: 0; } }
  .avail h2 { font-size: clamp(22px, 2.4vw, 30px); letter-spacing: -0.025em; }
  .also { color: var(--muted); font-size: 15px; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
  .facts { margin: 0; padding: 6px 0; }
  .facts > div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 16px clamp(22px, 2.6vw, 30px); border-bottom: 1px solid var(--line-a); }
  .facts > div:last-child { border-bottom: 0; }
  .facts dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); padding-top: 3px; }
  .facts dd { margin: 0; font-size: 14.5px; line-height: 1.55; }

  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; align-items: start; } .pic { justify-items: start; }
    .story .cols, .principles, .avail-grid { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; gap: 8px; }
    .caps > div, .facts > div { grid-template-columns: 1fr; gap: 6px; }
  }
  @media (prefers-reduced-motion: reduce) { .dot::after { animation: none; opacity: 0.5; transform: scale(1.2); } }
</style>
