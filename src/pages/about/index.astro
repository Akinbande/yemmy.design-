---
/* About: who I am and how I work.
   Header over his project covers on a turning 3D ring; a band of four facts; three workstation photos; the story as
   six short chapters on a line that fills as you scroll; how I work; what I bring; availability. No job-by-job
   experience list and no photo-of-me section for now (his calls), and no mention of the city he lives in. */
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import AboutHeroCards from '../../components/AboutHeroCards.astro';
import portrait from '../../assets/portrait.jpg';
import studioWide from '../../assets/about/studio-wide.webp';
import studioTall from '../../assets/about/studio-tall.webp';
import studioPortrait from '../../assets/about/studio-portrait.webp';
import { social } from '../../config';

const line = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
// the facts band: each one already said on the site or in his story
const facts = [
  { k: 'Designing since', v: '2018', d: 'Web design first, UI from 2019, then services', icon: line('M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z') },
  { k: 'Specialism', v: 'Regulated and public services', d: 'Government-funded care, digital government and fintech', icon: line('M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z') },
  { k: 'Craft', v: 'Service and UX design', d: 'From the service model to the shipped screen', icon: line('M12 3 3 8l9 5 9-5-9-5zM3 13l9 5 9-5') },
  { k: 'Standard', v: 'WCAG 2.2 AA', d: 'Accessibility built in, not added at the end', icon: line('M12 5.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM5 8l7 1.5L19 8M12 9.5V14l-3 6M12 14l3 6') },
];
// the story, in six short chapters (his own account: graphic designer from 2018, UI designer from 2019)
const chapters = [
  { y: '2018', t: 'It started with the web', d: 'I began as a graphic designer in Nigeria, designing websites for clients across many industries. I built pages in HTML, CSS and WordPress, handled SEO and Google Business listings, designed campaigns for early crypto projects, and taught web design to students.' },
  { y: '2019', t: 'From pages to products', d: 'I moved into UI design, and the question changed from how a page looks to how a product works.' },
  { y: '2020', t: 'The work behind the screen', d: 'In Lagos I designed the parts of software most people never see: a self-service portal, a learning management system and a real estate platform. The hard problems sat behind the screen, in the process, the rules and the staff who ran it.' },
  { y: '2021', t: 'Where trust is the product', d: 'Fintech sharpened that. A payment flow is only as good as the trust it earns, and a dashboard is only as good as the decision it supports.' },
  { y: '2024', t: 'Services people rely on', d: "I began designing for Australia's disability sector, where every form is a compliance document and every roster is a promise to a participant." },
  { y: 'Now', t: 'From service model to production', d: 'Today I design services that are funded by government, bound by regulation or used by the public, from the service model down to production code.' },
];
// three of his workstation photos from media1, the wide one in the middle
const studio = [
  { src: studioPortrait, cls: 'side', pos: '72% 50%', dir: 1, widths: [480, 760, 1086], sizes: '(max-width: 760px) 50vw, 24vw', alt: 'Oluwayemi at his desk, working on a curved monitor' },
  { src: studioWide, cls: 'main', pos: '50% 55%', dir: -1, widths: [800, 1300, 1900, 2600], sizes: '(max-width: 760px) 100vw, 52vw', alt: 'His workstation: a curved monitor, a laptop in a vertical stand and a desk chair beside the curtains' },
  { src: studioTall, cls: 'side', pos: '50% 62%', dir: 1, widths: [480, 760, 1100], sizes: '(max-width: 760px) 50vw, 24vw', alt: 'A desk and monitor facing a wide arched window, with green hills outside' },
];
// SAMPLE testimonials, for the layout only: he asked for a demo until he sends real quotes. The names are placeholders
// and every card is labelled Sample. Replace all three with real quotes (and permission to name the person) before v2
// goes live; never present these as real.
const testimonials = [
  { q: 'He took a messy, regulated process and made it feel simple for the people who use it. He asked the questions nobody else asked.', n: 'Name Surname', r: 'Role, Company' },
  { q: 'He does not stop at the screen. He maps the whole service, then stays with the team until what ships matches what was designed.', n: 'Name Surname', r: 'Role, Company' },
  { q: 'Clear thinking and calm under pressure. He understands compliance as well as he understands users, and makes both work in one design.', n: 'Name Surname', r: 'Role, Company' },
];
const principles = [
  { t: 'Service before screen', d: 'The journey, the staff process and the policy come first. The interface is the last thing designed, not the first.', icon: line('M4 5h16v4H4zM4 11h9v8H4zM15 11h5v8h-5z') },
  { t: 'Decisions over deliverables', d: 'A wireframe is evidence, not the work. The work is the call made under a constraint, and the reason for it.', icon: line('M12 3l7 9-7 9-7-9 7-9zM12 8v8') },
  { t: 'Compliance is a design material', d: 'Audit trails, eligibility rules and reporting duties shape the product. Designing around them produces things that fail inspection.', icon: line('M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3zM9 12l2 2 4-4') },
  { t: 'Stay through to production', d: 'The spec and the shipped product should be the same thing. I stay with the work until they are.', icon: line('M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14') },
];
const capabilities = [
  { t: 'Service design', d: 'The whole service, front stage and back, mapped before any screen is drawn.', tags: ['Service blueprints', 'Journey mapping', 'Service models', 'Research', 'Usability testing'] },
  { t: 'Information architecture', d: 'Clear structure for complex, data-heavy products.', tags: ['Enterprise platforms', 'Case management', 'Operations systems', 'Admin systems'] },
  { t: 'Design systems', d: 'Shared foundations that keep a product consistent as it grows.', tags: ['Design tokens', 'Component libraries', 'Interaction standards', 'Design governance'] },
  { t: 'Accessibility', d: 'WCAG 2.2 AA as a build constraint, not a final pass.', tags: ['WCAG 2.2 AA', 'Built in from the start'] },
  { t: 'Prototyping and build', d: 'Prototypes and production front-end, so the handoff is the product.', tags: ['Figma', 'Framer', 'Production front-end'] },
];
---
<Base title="About · Oluwayemi Akinbande" description="Senior Service & UX Designer. Seven years across fintech, healthcare, energy and SaaS, specialising in government-funded, regulated and citizen-facing services.">
  <article class="about">
    <header class="hero">
      <AboutHeroCards />
      <div class="wrap head">
        <div class="lead">
          <p class="eyebrow accent" data-reveal>About</p>
          <h1 data-reveal data-reveal-delay="0.1">Regulated services are where design earns its keep.</h1>
          <p class="sum" data-reveal data-reveal-delay="0.2">Senior Service &amp; UX Designer. Seven years across fintech, healthcare, energy and SaaS, with a specialism in services that are government-funded, regulated or used by the public.</p>
          <div class="cta" data-reveal data-reveal-delay="0.26">
            <a class="btn btn-primary" href="/contact/">Get in touch
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="btn btn-ghost" href="/work/">See the work</a>
          </div>
        </div>
        <div class="pic" data-reveal data-reveal-delay="0.3">
          <span class="ring"><Image src={portrait} alt="Oluwayemi Akinbande" width={480} height={480} format="webp" quality={82} /></span>
        </div>
      </div>
    </header>

    <section class="wrap band-wrap" aria-label="At a glance">
      <ul class="band">
        {facts.map((f, i) => (
          <li class="fc" data-reveal data-reveal-delay={String(i * 0.06)}>
            <span class="top"><span class="fi" set:html={f.icon} /><span class="mono fk">{f.k}</span></span>
            <b class="fv">{f.v}</b>
            <span class="fd">{f.d}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap studio" aria-label="Where the work happens">
      <div class="trip" id="about-trip">
        {studio.map((p, i) => (
          <figure class={`t ${p.cls}`} data-reveal data-reveal-delay={String(i * 0.08)}>
            <div class="par" data-dir={p.dir}><Image src={p.src} alt={p.alt} widths={p.widths} sizes={p.sizes} format="webp" quality={90} loading="lazy" style={`object-position:${p.pos}`} /></div>
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap story" aria-labelledby="story-h">
      <div class="split">
        <div class="side-head" data-reveal>
          <p class="eyebrow accent">Story</p>
          <h2 id="story-h">From web pages to public services.</h2>
          <p class="kicker">Since 2018, one thread: the work behind the screen.</p>
        </div>
        <ol class="chapters" id="about-chapters">
          <li class="rail" aria-hidden="true"><i class="fill"></i></li>
          {chapters.map((c) => (
            <li class="ch" data-reveal>
              <i class="dot" aria-hidden="true"></i>
              <span class="mono yr">{c.y}</span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="wrap" aria-labelledby="tm-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">Testimonials</p><h2 id="tm-h">What people say.</h2></div></div>
      <div class="tms">
        {testimonials.map((t, i) => (
          <figure class="tm" data-reveal data-reveal-delay={String(i * 0.08)}>
            <span class="tm-mark" aria-hidden="true">&ldquo;</span>
            <blockquote><p>{t.q}</p></blockquote>
            <figcaption>
              <span class="av" aria-hidden="true">{t.n.split(' ').map((w) => w[0]).join('')}</span>
              <span class="who"><b>{t.n}</b><span>{t.r}</span></span>
              <span class="sample mono">Sample</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap" aria-labelledby="pr-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">How I work</p><h2 id="pr-h">Four things I hold to.</h2></div></div>
      <ul class="principles">
        {principles.map((p, i) => (
          <li class="pr" data-reveal data-reveal-delay={String((i % 2) * 0.08)}>
            <span class="pr-top"><span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="pr-ic" set:html={p.icon} /></span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
            <i class="bar" aria-hidden="true"></i>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap" aria-labelledby="cap-h">
      <div class="cap-grid">
        <div class="cap-intro" data-reveal>
          <p class="eyebrow accent">Capabilities</p>
          <h2 id="cap-h">What I bring to a team.</h2>
          <p>Five practices, used together, from the first research session to the shipped product.</p>
          <a class="btn btn-ghost" href="/work/">See them in the work
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <ol class="caps">
          {capabilities.map((c, i) => (
            <li class="cap" data-reveal data-reveal-delay={String(i * 0.05)}>
              <span class="mono ci">{String(i + 1).padStart(2, '0')}</span>
              <div class="cb">
                <h3>{c.t}</h3>
                <p>{c.d}</p>
                <ul class="tags">{c.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="wrap" aria-labelledby="av-h">
      <div class="avail-grid">
        <div class="panel card avail" data-reveal>
          <span class="open"><i class="pulse" aria-hidden="true"></i>Open to work</span>
          <h2 id="av-h">Senior Service &amp; UX Design roles.</h2>
          <p class="also">Freelance and contract engagements too.</p>
          <div class="cta">
            <a class="btn btn-primary" href="/contact/">Get in touch
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="btn btn-ghost" href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
        <dl class="panel card facts" data-reveal data-reveal-delay="0.12">
          <div><dt>Sectors</dt><dd>Government-funded care, digital government, healthcare, fintech, energy and SaaS</dd></div>
          <div><dt>Standards</dt><dd>WCAG 2.2 AA, design tokens, component libraries and design governance</dd></div>
          <div><dt>Tools</dt><dd>Figma, Framer and production front-end</dd></div>
        </dl>
      </div>
    </section>
  </article>
</Base>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  function init() {
    const chapters = document.getElementById('about-chapters'), trip = document.getElementById('about-trip');
    if (!chapters || chapters.dataset.init) return; chapters.dataset.init = '1';
    const fill = chapters.querySelector<HTMLElement>('.fill')!, items = [...chapters.querySelectorAll<HTMLElement>('.ch')];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { gsap.set(fill, { scaleY: 1 }); items.forEach((c) => c.classList.add('on')); return; }
    // the story: the line fills as you read down, and each chapter's dot lights as you reach it
    gsap.fromTo(fill, { scaleY: 0 }, { scaleY: 1, ease: 'none', scrollTrigger: { trigger: chapters, start: 'top 70%', end: 'bottom 60%', scrub: 0.6 } });
    items.forEach((c) => ScrollTrigger.create({ trigger: c, start: 'top 68%', onEnter: () => c.classList.add('on'), onLeaveBack: () => c.classList.remove('on') }));
    // the photos: the middle one drifts one way and the sides the other, inside their frames
    trip?.querySelectorAll<HTMLElement>('.par').forEach((p) => {
      const d = +(p.dataset.dir || 1);
      gsap.fromTo(p, { yPercent: -5 * d }, { yPercent: 5 * d, ease: 'none', scrollTrigger: { trigger: p.parentElement, start: 'top bottom', end: 'bottom top', scrub: true } });
    });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .about { padding-bottom: clamp(72px, 10vw, 140px); }
  .about > section { padding-top: clamp(64px, 9vw, 120px); }

  /* header: over the turning ring of project covers, the words on the left and the portrait on the right */
  .hero { position: relative; isolation: isolate; min-height: min(86vh, 800px); display: grid; align-items: end;
    padding-top: calc(var(--nav-h) + clamp(56px, 10vw, 128px)); padding-bottom: clamp(72px, 9vw, 120px); }
  .head { position: relative; z-index: 1; width: 100%; display: grid; grid-template-columns: minmax(0, 1.3fr) auto; gap: clamp(28px, 5vw, 72px); align-items: end; }
  .lead { display: grid; gap: 18px; }
  h1 { font-size: clamp(34px, 4.8vw, 62px); letter-spacing: -0.04em; max-width: 16ch; }
  .sum { color: rgba(235, 238, 245, 0.78); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 54ch; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .pic { display: grid; justify-items: end; }
  .ring { position: relative; display: block; width: clamp(150px, 18vw, 240px); aspect-ratio: 1; border-radius: 50%; padding: 6px; background: var(--ink); }
  .ring::before { content: ''; position: absolute; inset: 0; border-radius: 50%; padding: 1.5px; background: conic-gradient(from 210deg, transparent 0 60%, var(--accent) 88%, transparent 100%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
  .ring :global(img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; box-shadow: 0 24px 60px rgba(0,0,0,0.6); }

  /* the facts band: four cards, lifted over the bottom edge of the header */
  .about > .band-wrap { padding-top: 0; margin-top: -44px; position: relative; z-index: 2; }
  .band { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .fc { position: relative; overflow: hidden; display: grid; grid-template-rows: auto auto 1fr; gap: 12px; padding: clamp(20px, 2.2vw, 26px); border-radius: 16px;
    border: 1px solid var(--line-a); background: linear-gradient(160deg, rgba(97, 144, 255, 0.08), var(--surface) 58%); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 20px 50px -24px rgba(0, 0, 0, 0.7); transition: border-color 0.3s, transform 0.4s var(--ease); }
  .fc::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 75%, transparent), transparent); }
  .fc::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.06) 50%, transparent 80%); transform: translateX(-100%); transition: transform 0.9s var(--ease); }
  .fc:hover { border-color: rgba(235, 238, 245, 0.2); transform: translateY(-3px); }
  .fc:hover::after { transform: translateX(100%); }
  .top { display: flex; align-items: center; gap: 10px; }
  .fi { display: grid; place-items: center; width: 34px; height: 34px; flex: none; border-radius: 10px; color: #fff; background: color-mix(in srgb, var(--accent) 18%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent); }
  .fi :global(svg) { width: 17px; height: 17px; }
  .fk { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
  .fv { font-size: clamp(19px, 1.7vw, 24px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; color: var(--fg); }
  .fd { align-self: end; font-size: 13.5px; line-height: 1.5; color: var(--muted); }

  /* the photos: the wide one in the middle, a portrait either side, all one height */
  .trip { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr) minmax(0, 1fr); gap: 12px; height: clamp(320px, 40vw, 580px); }
  .t { margin: 0; position: relative; overflow: hidden; border-radius: 18px; border: 1px solid var(--line-a); background: var(--surface); }
  .par { position: absolute; left: 0; right: 0; top: -7%; bottom: -7%; will-change: transform; }
  .par :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* the story: the heading on the left; six chapters on a line on the right */
  .split { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .side-head { display: grid; gap: 14px; position: sticky; top: calc(var(--nav-h) + 32px); }
  .side-head h2 { font-size: clamp(28px, 3.6vw, 44px); max-width: 13ch; }
  .kicker { color: var(--muted); font-size: 15.5px; line-height: 1.6; max-width: 32ch; }
  .chapters { position: relative; list-style: none; margin: 0; padding: 0 0 0 36px; display: grid; gap: clamp(28px, 3.2vw, 40px); }
  .rail { position: absolute; left: 7px; top: 10px; bottom: 10px; width: 1px; background: var(--line-a); }
  .fill { position: absolute; inset: 0; transform-origin: 50% 0; transform: scaleY(0); background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent)); }
  .ch { position: relative; display: grid; gap: 6px; }
  .dot { position: absolute; left: -34px; top: 4px; width: 13px; height: 13px; border-radius: 50%; background: var(--ink); border: 1.5px solid var(--line); transition: background 0.35s, border-color 0.35s, box-shadow 0.35s; }
  .ch.on .dot { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent); }
  .yr { font-size: 11px; letter-spacing: 0.12em; color: var(--accent); }
  .ch h3 { font-size: clamp(18px, 1.6vw, 21px); letter-spacing: -0.02em; }
  .ch p { color: var(--muted); font-size: 15.5px; line-height: 1.7; max-width: 60ch; }

  /* testimonials: three equal glass cards in a row, quotes of a similar length, names lined up along the bottom;
     a large accent quote mark on each, and a light passes on hover */
  .tms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .tm { position: relative; overflow: hidden; margin: 0; display: grid; grid-template-rows: auto 1fr auto; gap: 14px; padding: clamp(24px, 2.8vw, 34px); border-radius: 18px;
    border: 1px solid var(--line-a); background: linear-gradient(160deg, rgba(97, 144, 255, 0.07), var(--surface) 60%); transition: border-color 0.3s, transform 0.4s var(--ease); }
  .tm::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.05) 50%, transparent 80%); transform: translateX(-100%); transition: transform 1s var(--ease); }
  .tm:hover { border-color: rgba(235, 238, 245, 0.2); transform: translateY(-3px); }
  .tm:hover::after { transform: translateX(100%); }
  .tm-mark { font-size: 72px; line-height: 0.6; height: 30px; font-weight: 600; color: color-mix(in srgb, var(--accent) 75%, transparent); }
  .tm blockquote { margin: 0; }
  .tm blockquote p { font-size: clamp(16px, 1.35vw, 18.5px); line-height: 1.6; color: var(--fg); letter-spacing: -0.01em; }
  .tm figcaption { display: flex; align-items: center; gap: 12px; padding-top: 14px; border-top: 1px solid var(--line-a); }
  .av { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 50%; font-size: 13px; font-weight: 600; color: #fff;
    background: color-mix(in srgb, var(--accent) 22%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent); }
  .who { display: grid; gap: 2px; min-width: 0; }
  .who b { font-size: 14.5px; font-weight: 600; }
  .who span { font-size: 13px; color: var(--muted); }
  .sample { margin-left: auto; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); border: 1px dashed var(--line); border-radius: 999px; padding: 4px 9px; }

  /* how I work: four equal cards, an outlined number and an icon on top, an accent line that grows on hover */
  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .pr { position: relative; overflow: hidden; display: grid; grid-template-rows: auto auto 1fr auto; gap: 14px; padding: clamp(24px, 2.8vw, 34px); border-radius: 18px;
    border: 1px solid var(--line-a); background: radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 55%), var(--surface);
