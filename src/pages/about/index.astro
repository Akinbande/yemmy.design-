---
/* About: who I am and how I work. Header with portrait, a facts band, the story, how I work, what I bring,
   and availability. No job-by-job experience list for now (his call), and no mention of the city he lives in. */
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';
import inOffice from '../../assets/about/in-office.jpg';
import atWork from '../../assets/about/at-work.jpg';
import atDesk from '../../assets/about/at-desk.jpg';
import portraitSoft from '../../assets/about/portrait-soft.jpg';
import { social } from '../../config';

// the picture section: four of his photos from Photo/PH, chosen with his permission, all portraits; served sharp at
// several widths. `pos` keeps each face in frame
const photos = [
  { src: inOffice, pos: '50% 18%', alt: 'Oluwayemi in a white agbada and a red cap, standing in an office' },
  { src: atDesk, pos: '50% 26%', alt: 'Oluwayemi at a desk, with headphones and a lanyard' },
  { src: atWork, pos: '50% 30%', alt: 'Oluwayemi at work in a studio, wearing headphones' },
  { src: portraitSoft, pos: '50% 26%', alt: 'A portrait of Oluwayemi in glasses and a white top' },
];

// the facts band: each one already said elsewhere on the site
const facts: [string, string][] = [
  ['Seven years', 'Designing products and services'],
  ['Service and UX design', 'From the service model to the shipped screen'],
  ['Regulated and public services', 'Government-funded care, digital government, fintech'],
  ['WCAG 2.2 AA', 'Accessibility built in, not added at the end'],
];
const principles = [
  { t: 'Service before screen', d: 'The journey, the staff process and the policy come first. The interface is the last thing designed, not the first.' },
  { t: 'Decisions over deliverables', d: 'A wireframe is evidence, not the work. The work is the call made under a constraint, and why.' },
  { t: 'Compliance is a design material', d: 'Audit trails, eligibility rules and reporting obligations shape the product. Designing around them produces things that fail inspection.' },
  { t: 'Stay through to production', d: 'The spec and the shipped product should be the same thing. I stay until they are.' },
];
const capabilities = [
  ['Service design', 'Service blueprints, journey mapping, service models, research and usability testing'],
  ['Information architecture', 'Enterprise platforms, case management, operations and admin systems'],
  ['Design systems', 'Design tokens, component libraries, interaction standards, design governance'],
  ['Accessibility', 'WCAG 2.2 AA as a build constraint, not a final pass'],
  ['Prototyping and build', 'Figma, Framer, and production front-end so the handoff is the product'],
];
---
<Base title="About · Oluwayemi Akinbande" description="Senior Service & UX Designer. Seven years across fintech, healthcare, energy and SaaS, specialising in government-funded, regulated and citizen-facing services.">
  <article class="about">
    <header class="wrap head">
      <div class="lead">
        <p class="eyebrow accent" data-reveal>About</p>
        <h1 data-reveal data-reveal-delay="0.1">Regulated services are where design earns its keep.</h1>
        <p class="sum" data-reveal data-reveal-delay="0.2">Senior Service &amp; UX Designer. Seven years across fintech, healthcare, energy and SaaS, with a specialism in services that are government-funded, regulated, or used by the public.</p>
        <div class="cta" data-reveal data-reveal-delay="0.26">
          <a class="btn btn-primary" href="/contact/">Get in touch
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-ghost" href="/work/">See the work</a>
        </div>
      </div>
      <div class="pic" data-reveal data-reveal-delay="0.3">
        <span class="ring"><Image src={portrait} alt="Oluwayemi Akinbande" width={480} height={480} format="webp" quality={82} /></span>
      </div>
    </header>

    <section class="wrap band-wrap" aria-label="At a glance">
      <dl class="band panel" data-reveal>
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section class="wrap story" aria-labelledby="story-h">
      <div class="split">
        <div class="side-head" data-reveal>
          <p class="eyebrow accent">Story</p>
          <h2 id="story-h">The work behind the screen.</h2>
        </div>
        <div class="prose-cols">
          <p data-reveal>I started in Lagos in 2020, designing the parts of software most people never see: a self-service portal, a learning management system, a real estate platform. The pattern showed early. The hard problems were never on the screen. They sat in the process behind it, the rules it had to follow, and the staff who had to run it.</p>
          <p data-reveal data-reveal-delay="0.08">Fintech sharpened that. A payment flow is only as good as the trust it earns, and a dashboard is only as good as the decision it supports. Since 2024 I have also designed for Australia's disability sector, where every form is a compliance document and every roster is a promise to a participant.</p>
          <p data-reveal data-reveal-delay="0.16">That is the work I do now: services that are funded by government, bound by regulation, or used by the public, designed from the service model down to production code.</p>
        </div>
      </div>
    </section>

    <section class="wrap" aria-labelledby="ph-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">In person</p><h2 id="ph-h">The person behind the work.</h2></div></div>
      <div class="gallery">
        {photos.map((p, i) => (
          <figure class="g" data-reveal data-reveal-delay={String(i * 0.07)}>
            <Image src={p.src} alt={p.alt} widths={[400, 640, 960]} sizes="(max-width: 860px) 46vw, 24vw" format="webp" quality={88} loading="lazy" style={`object-position:${p.pos}`} />
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap" aria-labelledby="pr-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">How I work</p><h2 id="pr-h">Four things I hold to.</h2></div></div>
      <ul class="principles">
        {principles.map((p, i) => (
          <li class="panel" data-reveal data-reveal-delay={String((i % 2) * 0.08)}>
            <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.t}</h3><p>{p.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap" aria-labelledby="cap-h">
      <div class="section-head" data-reveal><div><p class="eyebrow accent">Capabilities</p><h2 id="cap-h">What I bring to a team.</h2></div></div>
      <dl class="panel caps" data-reveal>
        {capabilities.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section class="wrap" aria-labelledby="av-h">
      <div class="avail-grid">
        <div class="panel card avail" data-reveal>
          <span class="open"><i class="dot" aria-hidden="true"></i>Open to work</span>
          <h2 id="av-h">Senior Service &amp; UX Design roles.</h2>
          <p class="also">Freelance and contract engagements too.</p>
          <div class="cta">
            <a class="btn btn-primary" href="/contact/">Get in touch
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="btn btn-ghost" href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
        <dl class="panel card facts" data-reveal data-reveal-delay="0.12">
          <div><dt>Sectors</dt><dd>Government-funded care, digital government, healthcare, fintech, energy, SaaS</dd></div>
          <div><dt>Standards</dt><dd>WCAG 2.2 AA, design tokens, component libraries, design governance</dd></div>
          <div><dt>Tools</dt><dd>Figma, Framer, and production front-end</dd></div>
        </dl>
      </div>
    </section>
  </article>
</Base>

<style>
  .about { padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .about > section { padding-top: clamp(64px, 9vw, 120px); }
  .about > .band-wrap { padding-top: clamp(36px, 5vw, 64px); }

  /* header: the words on the left, the portrait on the right */
  .head { display: grid; grid-template-columns: minmax(0, 1.3fr) auto; gap: clamp(28px, 5vw, 72px); align-items: end; }
  .lead { display: grid; gap: 18px; }
  h1 { font-size: clamp(34px, 4.8vw, 62px); letter-spacing: -0.04em; max-width: 16ch; }
  .sum { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 54ch; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .pic { display: grid; justify-items: end; }
  .ring { position: relative; display: block; width: clamp(150px, 18vw, 240px); aspect-ratio: 1; border-radius: 50%; padding: 6px; background: var(--ink); }
  .ring::before { content: ''; position: absolute; inset: 0; border-radius: 50%; padding: 1.5px; background: conic-gradient(from 210deg, transparent 0 60%, var(--accent) 88%, transparent 100%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
  .ring :global(img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; box-shadow: 0 24px 60px rgba(0,0,0,0.6); }

  /* the facts band: four facts in a row */
  .band { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .band > div { display: grid; gap: 6px; align-content: start; padding: clamp(18px, 2.2vw, 26px); border-right: 1px solid var(--line-a); }
  .band > div:last-child { border-right: 0; }
  .band dt { font-size: clamp(16px, 1.4vw, 19px); font-weight: 600; letter-spacing: -0.02em; color: var(--fg); }
  .band dd { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--muted); }

  /* the story: the heading on the left, the text on the right */
  .split { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .side-head { display: grid; gap: 12px; position: sticky; top: calc(var(--nav-h) + 32px); }
  .side-head h2 { font-size: clamp(28px, 3.6vw, 44px); max-width: 12ch; }
  .prose-cols { display: grid; gap: 20px; }
  .prose-cols p { color: var(--muted); font-size: clamp(16px, 1.3vw, 18px); line-height: 1.75; max-width: 62ch; }
  .prose-cols p:first-child { color: var(--fg); }

  /* the pictures: four portraits in a row, the second and fourth set a little lower for rhythm;
     no hover zoom (it softens photos) */
  .gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: start; }
  .g { margin: 0; overflow: hidden; aspect-ratio: 3 / 4; border-radius: 16px; border: 1px solid var(--line-a); background: var(--surface); }
  /* the offset is a margin, not a transform: the scroll-in animation owns each photo's transform and would undo it */
  .g:nth-child(even) { margin-top: 36px; }
  .g :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .principles li { padding: clamp(22px, 2.6vw, 30px); display: grid; gap: 10px; align-content: start; }
  .principles .n { font-size: 11px; color: var(--accent); letter-spacing: 0.1em; }
  .principles h3 { font-size: 19px; letter-spacing: -0.02em; }
  .principles p { color: var(--muted); font-size: 14.5px; line-height: 1.6; }

  .caps { margin: 0; padding: 4px 0; }
  .caps > div { display: grid; grid-template-columns: 220px 1fr; gap: 16px; padding: 18px 24px; border-bottom: 1px solid var(--line-a); }
  .caps > div:last-child { border-bottom: 0; }
  .caps dt { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .caps dd { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; }

  .avail-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 14px; }
  .card { padding: clamp(24px, 3vw, 36px); }
  .avail { display: grid; gap: 12px; align-content: start; border-color: rgba(61,214,140,0.22); background: linear-gradient(160deg, rgba(61,214,140,0.06), var(--surface) 55%); }
  .open { display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ok); }
  .dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  .dot::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--ok); animation: ring 2.2s ease-out infinite; }
  @keyframes ring { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(1.6); opacity: 0; } }
  .avail h2 { font-size: clamp(22px, 2.4vw, 30px); letter-spacing: -0.025em; }
  .also { color: var(--muted); font-size: 15px; }
  .facts { margin: 0; padding: 6px 0; }
  .facts > div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 16px clamp(22px, 2.6vw, 30px); border-bottom: 1px solid var(--line-a); }
  .facts > div:last-child { border-bottom: 0; }
  .facts dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); padding-top: 3px; }
  .facts dd { margin: 0; font-size: 14.5px; line-height: 1.55; }

  @media (max-width: 960px) { .band { grid-template-columns: repeat(2, minmax(0, 1fr)); } .band > div:nth-child(2) { border-right: 0; } .band > div:nth-child(-n+2) { border-bottom: 1px solid var(--line-a); } }
  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; align-items: start; } .pic { justify-items: start; order: -1; }
    .split, .principles, .avail-grid { grid-template-columns: 1fr; }
    .side-head { position: static; }
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .g:nth-child(even) { margin-top: 24px; }
    .caps > div, .facts > div { grid-template-columns: 1fr; gap: 6px; }
  }
  @media (max-width: 520px) { .band { grid-template-columns: 1fr; } .band > div { border-right: 0; border-bottom: 1px solid var(--line-a); } .band > div:last-child { border-bottom: 0; } }
  @media (prefers-reduced-motion: reduce) { .dot::after { animation: none; opacity: 0.5; transform: scale(1.2); } }
</style>
